:root {
  --bg:         #11111B;
  --surface:    #181825;
  --border:     #313244;
  --text:       #CDD6F4;
  --muted:      #7F849C;
  --faint:      #585B70;
  --accent:     #89B4FA;
  --danger:     #F38BA8;
  --danger-bg:  #2A1A22;
  --ok:         #A6E3A1;
}

/* Sem `background` na raiz: o fundo vem do theme.json (ver AGENTS.md). */
.tela { width: fill; height: fill; padding: 24; spacing: 18; }

.cabecalho { spacing: 4; }
.titulo    { size: 22; bold: true; color: var(--text); }
.subtitulo { size: 12; color: var(--muted); }

.campos { width: fill; spacing: 14; }
.grupo  { width: fill; spacing: 5; }
.dupla  { width: fill; spacing: 12; }

.rotulo { size: 11; bold: true; color: var(--muted); }
/* A cadeia inteira até o campo precisa ser `width: fill` — um `fill` dentro de
 um pai `shrink` colapsa o campo sem erro nenhum (ver AGENTS.md / PRIMITIVAS). */
.campo  { width: fill; padding: 9 11; border_radius: 6; }
/* O destaque do campo reprovado: NÃO é uma classe que o script liga — é o
 pseudo-estado `:invalid`, que o motor acende sozinho enquanto o
 `{erro_<campo>}` do campo estiver preenchido (ver AGENTS.md). */
.campo:invalid { border_width: 1; border_color: var(--danger); background: var(--danger-bg); }
.erro   { size: 11; color: var(--danger); }

.status { size: 12; color: var(--ok); }

.acoes { width: fill; spacing: 10; align_x: end; }
.btn-salvar { background: var(--accent); text_color: #11111B; padding: 9 18; border_radius: 6; }
.btn-limpar {
  background: var(--surface);
  text_color: var(--text);
  border_width: 1;
  border_color: var(--border);
  padding: 9 18;
  border_radius: 6;
}
