screen(
  title = "{{titulo}} — cadastro", size = "560 640", min_size = "420 520",
) {
  resources {
    link(rel = theme, href = "views/styles/theme.json")
    link(rel = stylesheet, href = "views/styles/app.gss")
    script(src = "scripts/app.luau")
  }

  column(class = tela) {
    column(class = cabecalho) {
      text(class = titulo, content = "Novo colaborador")

      text(
        class = subtitulo,
        content = "as regras estão no <form>; o motor valida ao enviar",
      )
    }

    form(
      name = cadastro, class = campos, on_submit = salvar,
      on_validation_error = apontar, validate_on = submit,
    ) {
      column(class = grupo) {
        text(class = rotulo, content = "Nome")

        input(
          class = campo, form_control = f_nome, rules = "required|minlen:3",
          msg = "informe ao menos 3 letras", placeholder = "nome completo",
        )

        text(
          class = erro, if = @erro_f_nome, not_empty = "",
          content = "@erro_f_nome",
        )
      }

      row(class = dupla) {
        column(class = grupo) {
          text(class = rotulo, content = "CPF")

          maskedinput(
            class = campo, form_control = f_cpf, mask = cpf,
            rules = "required|digits:11", msg = "o CPF precisa de 11 dígitos",
          )

          text(
            class = erro, if = @erro_f_cpf, not_empty = "",
            content = "@erro_f_cpf",
          )
        }

        column(class = grupo) {
          text(class = rotulo, content = "Telefone")

          maskedinput(
            class = campo, form_control = f_tel, mask = telefone,
            rules = "digits:10,11", msg = "telefone com DDD",
          )

          text(
            class = erro, if = @erro_f_tel, not_empty = "",
            content = "@erro_f_tel",
          )
        }
      }

      row(class = dupla) {
        column(class = grupo) {
          text(class = rotulo, content = "Idade")

          spinbox(
            :value = f_idade, form_control = f_idade, min = 14, max = 90,
            width = 110,
            rules = gte:18, msg = "precisa ser maior de idade",
          )

          text(
            class = erro, if = @erro_f_idade, not_empty = "",
            content = "@erro_f_idade",
          )
        }

        column(class = grupo) {
          text(class = rotulo, content = "Nascimento")

          dateedit(
            class = campo, value = f_nasc, format = br, calendar_popup = true,
            today = @hoje,
          )
        }
      }

      column(class = grupo) {
        text(class = rotulo, content = "UF")

        select(
          class = campo, :options = f_ufs, form_control = f_uf, rules = required,
          msg = "escolha a UF",
        )

        text(
          class = erro, if = @erro_f_uf, not_empty = "",
          content = "@erro_f_uf",
        )
      }

      checkbox(
        label = "Aceito os termos de uso", form_control = f_aceite,
        rules = accepted,
        msg = "é preciso aceitar os termos",
      )

      text(
        class = erro, if = @erro_f_aceite, not_empty = "",
        content = "@erro_f_aceite",
      )
      text(class = status, content = "@f_status")

      row(class = acoes) {
        button(
          type = reset, class = btn-limpar, on_click = limpar,
          text = "Limpar",
        )
        button(type = submit, class = btn-salvar, text = "Salvar")
      }
    }
  }
}
