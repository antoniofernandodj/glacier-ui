<screen title="{{titulo}}" size="420 340" min-size="320 280">
    <resources>
        <!-- href de uma stylesheet é relativo ao diretório de onde o app roda
             (a raiz do projeto), não a este arquivo. -->
        <link rel="stylesheet" href="views/styles/app.gss" />

        <!-- O comportamento pode morar aqui mesmo, num <script> Luau interpretado
             em runtime: salvar este arquivo já vale, sem recompilar. Cada função
             global vira um destino possível para um on_click.

             O corpo do <script> é recortado por texto ANTES do parse de XML, então
             `<`, `>` e `&` podem aparecer no Luau à vontade. Quando o script
             crescer, mova-o para um arquivo com <script src="scripts/x.luau">:
             o `src` resolve relativo a ESTE arquivo. -->
        <script>
        --!strict

        -- Chamada pelo motor quando a tela entra. O contexto guarda strings:
        -- é o que os {marcadores} do markup abaixo leem.
        function init()
            ctx.contador = "0"
        end

        local function passo(delta: number)
            ctx.contador = tostring((tonumber(ctx.contador) or 0) + delta)
        end

        function somar()
            passo(1)
        end

        function subtrair()
            passo(-1)
        end

        function zerar()
            ctx.contador = "0"
            toast({ message = "Contador zerado", kind = "info" })
        end
        </script>
    </resources>

    <column class="tela">
        <text class="rotulo">{{titulo}}</text>
        <text class="numero">{contador}</text>

        <row class="acoes">
            <button class="btn" text="-" on_click="subtrair" />
            <button class="btn" text="+" on_click="somar" />
        </row>

        <button class="btn_ghost" text="zerar" on_click="zerar" />

        <text class="dica">edite este arquivo ou o .gss e salve: o hot-reload aplica</text>
    </column>
</screen>
