component {
  props {
    prop(name = rotulo)
    prop(name = rota)
    prop(name = acao)
    prop(name = ativo, default = "")
  }

  resources {
    style(scoped = true) """
      .nav_on {
        color: var(--raised);
        text_color: var(--text);
        padding: 9 12;
        border_radius: 6;
        text_align: left;
      }
      .nav_off {
        color: var(--surface);
        text_color: var(--muted);
        padding: 9 12; border_radius: 6;
        text_align: left;
      }
      .nav_off:hover {
        text_color: var(--text);
      }
    """
  }

  column {
    button(
      class = nav_on, if = @ativo, equals = @rota, text = @rotulo,
      on_click = @acao,
    )

    button(class = nav_off, else, text = @rotulo, on_click = @acao)
  }
}
