component {
  resources {
    style(scoped = true) """
      .painel     { background: var(--raised); border_radius: 8; border_width: 1; border_color: var(--border); padding: 12; spacing: 6; }
      .caixa_stack { width: fill; height: 120; background: var(--raised); border_radius: 8; }
      .marca_pos  { size: 11; bold: true; color: var(--accent); }
      .sino       { size: 20; }
      .arena      { width: fill; height: 180; background: var(--raised); border_radius: 8; }
      .arrasta    { size: 14; color: var(--muted); }

      .coluna_2 { width: fill; height: fill; align_x: center; align_y: center; }
      .coluna_3 { align_x: center; align_y: center; spacing: 10; }
      .texto { cursor: grab; }
    """
  }

  column(class = secao) {
    text(class = titulo_cat, content = "Overlays, dicas e utilitários")

    text(
      class = intro,
      content = """
        `tooltip=` e `whats_this=` são atributos UNIVERSAIS — valem em qualquer
        nó. `<shortcut>` mora no layout (não no `<resources>`) e não desenha nada.
      """,
    )

    column(class = demos) {
      column(class = demo) {
        text(
          class = rotulo,
          content = "tooltip= · whats_this= (modo pegajoso: whatsthis:toggle)",
        )

        row(class = linha) {
          button(
            class = btn, text = "pare o mouse aqui",
            tooltip = "este é o balão de tooltip", on_click = dizer:tooltip,
          )

          button(
            class = btn, text = "modo ajuda", on_click = whatsthis:toggle,
            whats_this = "Ligue o modo e paire sobre os controles: a ajuda fica no lugar do tooltip.",
          )
        }
      }

      column(class = demo) {
        text(
          class = rotulo,
          content = """
            <popover> (ancorado ao gatilho) · <popup> (centrado na janela)
          """,
        )

        row(class = linha) {
          popover(:value = ov_menu, placement = bottom, align = start) {
            button(slot = anchor, class = btn, text = "Conta ▾")

            column(class = painel) {
              text(class = nota, content = "Perfil")
              text(class = nota, content = "Configurações")
              text(class = nota, content = "Sair")
            }
          }

          popup(value = ov_pop) {
            button(slot = anchor, class = btn, text = "Mostrar atalhos")

            column(class = painel) {
              text(class = nota, content = "Ctrl+S — salvar")
              text(class = nota, content = "Ctrl+P — buscar")
            }
          }
        }
      }

      column(class = demo) {
        text(
          class = rotulo,
          content = """
            <stack> — filhos no mesmo espaço; anchor= em 9 cantos, ou x=/y=
          """,
        )

        stack(class = caixa_stack) {
          container(class = caixa_stack)
          text(anchor = top-left, class = marca_pos, content = "TL")
          text(anchor = center, class = marca_pos, content = "C")
          text(anchor = bottom-right, class = marca_pos, content = "BR")
        }
      }

      column(class = demo) {
        text(
          class = rotulo,
          content = """
            <notificationdot show="@{…}"> — o pingo no canto do filho
          """,
        )

        row(class = linha) {
          notificationdot(show = @ov_notif) {
            container(class = painel) {
              text(class = sino, content = "🔔")
            }
          }

          button(
            class = btn, text = "alternar o ponto",
            on_click = ov_alternar_notif,
          )
        }
      }

      column(class = demo) {
        text(
          class = rotulo,
          content = """
            <splashscreen show="@{…}"> — o `slot="splash"` cobre o conteúdo (slot
            anônimo) enquanto `show` for verdadeiro
          """,
        )

        button(
          class = btn, text = "mostrar/esconder a splash",
          on_click = ov_alternar_splash,
        )

        splashscreen(
          show = @ov_splash, width = fill, height = 170, background = #181825,
        ) {
          column(class = "coluna coluna_2") {
            text(class = nota, content = "conteúdo real do app, por baixo")
          }

          template(slot = splash) {
            column(class = coluna_3) {
              text(class = marca_pos, content = "MINHA FERRAMENTA")
              spinner
            }
          }
        }
      }

      column(class = demo) {
        text(
          class = rotulo,
          content = "<rubberband> — laço de seleção sobre alvos nomeados",
        )

        rubberband(
          items = ov_caixas, :selection = ov_marcados, class = arena,
          height = 160,
        )

        text(class = nota, content = "ov_marcados = @ov_marcados")
      }

      column(class = demo) {
        text(
          class = rotulo,
          content = "<foreach on_reorder reorder_key> — arraste pela alça ⋮⋮",
        )

        column(class = coluna) {
          each @ov_tarefas as t (
            on_reorder = dizer:reordenou, reorder_key = id,
          ) {
            row(class = linha) {
              text(
                class = "arrasta texto", drag_handle = true,
                content = "⋮⋮",
              )
              text(class = nota, content = "@t.nome")
            }
          }
        }
      }

      text(
        class = nota,
        content = """
          Há um <shortcut key="ctrl+j" on_press="dizer:ctrl+j"> ativo nesta tela —
          sem modificador ele não roubaria a tecla de um campo focado.
        """,
      )

      shortcut(key = ctrl+j, on_press = "dizer:atalho ctrl+j")
    }
  }
}
