<component>
  <column class="secao">
    <text class="titulo_cat">Entradas de texto</text>
    <text class="intro">
      `value` é o NOME da chave, nunca `{interpolação}`. O `on_change` é opcional:
      sem uma função Luau de mesmo nome, o motor grava `ctx[nome] = valor` sozinho.
    </text>

    <column class="demos">

      <column class="demo">
        <text class="rotulo">&lt;textinput&gt;  ·  &lt;textinput secure&gt;</text>
        <row class="linha">
          <textinput class="campo_curto" value="ti_nome" on_change="ti_nome" placeholder="Nome" />
          <textinput class="campo_curto" value="ti_senha" on_change="ti_senha" placeholder="Senha" secure="true" />
        </row>
        <text class="nota">ti_nome = {ti_nome}</text>
      </column>

      <column class="demo">
        <text class="rotulo">&lt;textarea&gt;  (multi-linha; readonly + append para log vivo)</text>
        <textarea value="ta_notas" on_change="ta_notas" placeholder="Anotações…" height="90" />
      </column>

      <column class="demo">
        <text class="rotulo">&lt;maskedinput&gt;  —  guarda cru, exibe mascarado</text>
        <row class="linha">
          <maskedinput class="campo_curto" value="mi_cpf" mask="cpf" />
          <maskedinput class="campo_curto" value="mi_tel" mask="telefone" />
        </row>
        <text class="nota">mi_cpf (cru) = {mi_cpf}</text>
      </column>

      <column class="demo">
        <text class="rotulo">&lt;comboedit&gt;  —  dropdown editável (on_change ao digitar, on_select ao escolher)</text>
        <comboedit class="campo_curto" options="ce_hosts" value="ce_host" placeholder="https://…" on_change="ce_host" />
      </column>

      <column class="demo">
        <text class="rotulo">&lt;autocomplete&gt;  —  sugestões sem acento/caixa; ▲▼ Enter Esc</text>
        <autocomplete class="campo_curto" value="ac_cidade" items="ac_cidades" placeholder="digite: sao, rio, bel…" />
      </column>

      <column class="demo">
        <text class="rotulo">&lt;shortcutinput&gt;  —  captura uma combinação de teclas</text>
        <shortcutinput value="si_atalho" placeholder="clique e pressione ctrl+s" />
        <text class="nota">si_atalho = {si_atalho}</text>
      </column>

      <column class="demo">
        <text class="rotulo">&lt;form&gt;  —  agrupa campos; `rules="…"` em cada um e o motor valida NO ENVIO (Enter dispara, Tab avança)</text>
        <form name="cat_form" on_submit="fm_enviar" on_validation_error="fm_erro" validate_on="submit" spacing="8">
          <textinput class="campo" form_control="fm_nome" value="fm_nome" placeholder="Nome (≥ 3 letras)"
                     rules="required|minlen:3" msg="informe ao menos 3 letras" />
          <text class="erro" if="{erro_fm_nome}">{erro_fm_nome}</text>

          <maskedinput class="campo" form_control="fm_cpf" value="fm_cpf" mask="cpf"
                       rules="required|digits:11" msg="o CPF precisa de 11 dígitos" />
          <text class="erro" if="{erro_fm_cpf}">{erro_fm_cpf}</text>

          <spinbox form_control="fm_idade" value="fm_idade" min="0" max="120" width="110"
                   rules="gte:18" msg="precisa ser maior de idade" />
          <text class="erro" if="{erro_fm_idade}">{erro_fm_idade}</text>

          <row class="linha">
            <button type="reset" class="btn" text="Limpar" on_click="fm_limpar" />
            <button type="submit" class="btn_prim" text="Enviar" />
          </row>
        </form>
      </column>

    </column>
  </column>
</component>
