component {
  resources {
    link(rel = stylesheet, href = "views/styles/app.gss")
  }

  column(class = secao) {
    text(class = titulo_cat, content = "Entradas de texto")

    text(
      class = intro,
      content = """
        `value` é o NOME da chave, nunca `@interpolação`. O `on_change` é
        opcional: sem uma função Luau de mesmo nome, o motor grava `ctx[nome] =
        valor` sozinho.
      """,
    )

    column(class = demos) {
      column(class = demo) {
        text(class = rotulo, content = "<textinput> · <textinput secure>")

        row(class = linha) {
          textinput(
            class = campo_curto, :value = ti_nome, on_change = ti_nome,
            placeholder = Nome,
          )

          textinput(
            class = campo_curto, :value = ti_senha, on_change = ti_senha,
            placeholder = Senha, secure = true,
          )
        }

        text(class = nota, content = "ti_nome = @ti_nome")
      }

      column(class = demo) {
        text(
          class = rotulo,
          content = "<textarea> (multi-linha; readonly + append para log vivo)",
        )

        textarea(
          :value = ta_notas, on_change = ta_notas, placeholder = "Anotações…",
          height = 90,
        )
      }

      column(class = demo) {
        text(
          class = rotulo,
          content = "<maskedinput> — guarda cru, exibe mascarado",
        )

        row(class = linha) {
          maskedinput(class = campo_curto, :value = mi_cpf, mask = cpf)
          maskedinput(class = campo_curto, :value = mi_tel, mask = telefone)
        }

        text(class = nota, content = "mi_cpf (cru) = @mi_cpf")
      }

      column(class = demo) {
        text(
          class = rotulo,
          content = """
            <comboedit> — dropdown editável (on_change ao digitar, on_select ao
            escolher)
          """,
        )

        comboedit(
          class = campo_curto, :options = ce_hosts, :value = ce_host,
          placeholder = "https://…", on_change = ce_host,
        )
      }

      column(class = demo) {
        text(
          class = rotulo,
          content = "<autocomplete> — sugestões sem acento/caixa; ▲▼ Enter Esc",
        )

        autocomplete(
          class = campo_curto, :value = ac_cidade, :items = ac_cidades,
          placeholder = "digite: sao, rio, bel…",
        )
      }

      column(class = demo) {
        text(
          class = rotulo,
          content = "<shortcutinput> — captura uma combinação de teclas",
        )

        shortcutinput(
          :value = si_atalho, placeholder = "clique e pressione ctrl+s",
        )

        text(class = nota, content = "si_atalho = @si_atalho")
      }

      column(class = demo) {
        text(
          class = rotulo,
          content = """
            <form> — agrupa campos; `rules="…"` em cada um e o motor valida NO
            ENVIO (Enter dispara, Tab avança)
          """,
        )

        form(
          name = cat_form, on_submit = fm_enviar, on_validation_error = fm_erro,
          validate_on = submit, class = formulario,
        ) {
          textinput(
            class = campo, form_control = fm_nome, :value = fm_nome,
            placeholder = "Nome (≥ 3 letras)", rules = "required|minlen:3",
            msg = "informe ao menos 3 letras",
          )

          text(class = erro, if = @erro_fm_nome, content = "@erro_fm_nome")

          maskedinput(
            class = campo, form_control = fm_cpf, :value = fm_cpf, mask = cpf,
            rules = "required|digits:11", msg = "o CPF precisa de 11 dígitos",
          )

          text(class = erro, if = @erro_fm_cpf, content = "@erro_fm_cpf")

          spinbox(
            form_control = fm_idade, :value = fm_idade, min = 0, max = 120,
            width = 110,
            rules = gte:18, msg = "precisa ser maior de idade",
          )

          text(class = erro, if = @erro_fm_idade, content = "@erro_fm_idade")

          row(class = linha) {
            button(
              type = reset, class = btn, text = Limpar, on_click = fm_limpar,
            )
            button(type = submit, class = btn_prim, text = Enviar)
          }
        }
      }
    }
  }
}
