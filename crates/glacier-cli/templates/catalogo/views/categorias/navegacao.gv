component {
  resources {
    link(rel = stylesheet, href = "views/styles/app.gss")
  }

  column(class = secao) {
    text(class = titulo_cat, content = "Navegação")

    text(
      class = intro,
      content = """
        `tabbar`/`tabs`/`stackview`/`wizard` usam `active="@chave"` (leitura) ao
        lado de `value="chave"` (escrita). A página é escolhida por NOME de slot.
      """,
    )

    column(class = demos) {
      column(class = demo) {
        text(class = rotulo, content = "<tabbar> — só a barra")
        tabbar(:value = nv_aba, active = @nv_aba, :items = nv_abas)
        text(class = nota, content = "nv_aba = @nv_aba")
      }

      column(class = demo) {
        text(
          class = rotulo,
          content = "<tabs> — barra + páginas por <template slot>",
        )

        tabs(
          :value = nv_aba2, active = @nv_aba2, :items = nv_abas,
          page_spacing = 14,
        ) {
          template(slot = geral) {
            text(class = nota, content = "página \"geral\"")
          }

          template(slot = rede) {
            text(class = nota, content = "página \"rede\"")
          }

          template(slot = avancado) {
            text(class = nota, content = "página \"avancado\"")
          }
        }
      }

      column(class = demo) {
        text(
          class = rotulo,
          content = """
            <stackview active="@{…}"> — troca de painel por nome, sem escada de
            se/senao
          """,
        )

        row(class = linha) {
          button(class = btn, text = Resumo, on_click = def:nv_painel:resumo)
          button(class = btn, text = Detalhe, on_click = def:nv_painel:detalhe)
        }

        stackview(active = @nv_painel) {
          template(slot = resumo) {
            text(class = nota, content = "painel de resumo")
          }

          template(slot = detalhe) {
            text(class = nota, content = "painel de detalhe")
          }
        }
      }

      column(class = demo) {
        text(
          class = rotulo,
          content = "<wizard> — passos + validação que trava o \"Avançar\"",
        )

        wizard(
          :value = nv_passo, active = @nv_passo, steps = "plano,dominio,revisao",
          titles = "Plano,Domínio,Revisão", valid = @nv_passo_valido,
          on_finish = "dizer:wizard concluído",
          on_cancel = "dizer:wizard cancelado",
        ) {
          template(slot = plano) {
            text(class = nota, content = "escolha um plano")
          }

          template(slot = dominio) {
            text(class = nota, content = "informe o domínio")
          }

          template(slot = revisao) {
            text(class = nota, content = "confira e conclua")
          }
        }
      }

      column(class = demo) {
        text(
          class = rotulo,
          content = """
            <wizardnav> — SÓ a barra de botões (voltar/avançar/finalizar), para
            quem monta os passos à mão
          """,
        )

        wizardnav(
          :value = nv_wn, steps = "dados,rede,revisao",
          titles = "Dados,Rede,Revisão",
          valid = @nv_wn_valido, on_finish = "dizer:wizardnav concluído",
        )

        text(
          class = nota,
          content = "nv_wn = @nv_wn · `valid=\"@{…}\"` falso trava o \"Avançar\"",
        )
      }

      column(class = demo) {
        text(
          class = rotulo,
          content = "<swipeview> — páginas deslizáveis (arraste na horizontal)",
        )

        swipeview(:value = nv_pagina, threshold = 120, class = area) {
          column(class = coluna) {
            text(class = nota, content = "página 0 — arraste")
          }

          column(class = coluna) {
            text(class = nota, content = "página 1")
          }

          column(class = coluna) {
            text(class = nota, content = "página 2")
          }
        }

        text(class = nota, content = "nv_pagina = @nv_pagina")
      }

      column(class = demo) {
        text(
          class = rotulo,
          content = "<drawer> — painel lateral que EMPURRA (não cobre)",
        )

        button(
          class = btn, text = "Abrir/fechar gaveta",
          on_click = drawer::toggle:nv_gaveta,
        )

        text(class = nota, content = "nv_gaveta = @nv_gaveta")

        row(class = area) {
          drawer(
            :value = nv_gaveta, open = @nv_gaveta, size = 180,
            panel_class = gaveta,
          ) {
            text(class = nota, content = "item da gaveta")
            text(class = nota, content = "outro item")
          }

          column(class = "coluna coluna_2") {
            text(
              class = nota,
              content = "conteúdo principal — encolhe quando a gaveta abre",
            )
          }
        }
      }
    }
  }
}
