component {
  resources {
    link(rel = stylesheet, href = "views/styles/app.gss")
  }

  column(class = secao) {
    text(class = titulo_cat, content = "Numéricas e de valor")

    text(
      class = intro,
      content = """
        `min`/`max`/`step` são inline (medida de widget). O `step` cru decide as
        casas decimais gravadas: `step="0.25"` grava `"7.25"`.
      """,
    )

    column(class = demos) {
      column(class = demo) {
        text(
          class = rotulo,
          content = """
            <spinbox> · <spinbox decimals> · <spinbox layout="inline">
          """,
        )

        row(class = linha) {
          spinbox(:value = sb_qtd, min = 0, max = 20, width = 72)

          spinbox(
            :value = sb_preco, min = 0, max = 999, step = 1, decimals = 2,
            width = 96,
          )

          spinbox(
            :value = sb_zoom, min = 25, max = 400, step = 25, layout = inline,
            width = 72,
          )
        }

        text(class = nota, content = "sb_qtd = @sb_qtd · sb_preco = @sb_preco")
      }

      column(class = demo) {
        text(class = rotulo, content = "<slider> · <slider vertical>")

        row(class = linha) {
          slider(
            :value = sl_volume, min = 0, max = 100, on_change = sl_volume,
            class = controle,
          )

          slider(
            :value = sl_brilho, min = 0, max = 1, step = 0.05,
            on_change = sl_brilho,
            vertical = true, class = controle_2,
          )
        }

        text(
          class = nota,
          content = "sl_volume = @sl_volume · sl_brilho = @sl_brilho",
        )
      }

      column(class = demo) {
        text(
          class = rotulo,
          content = "<rangeslider> — dois cursores, duas chaves",
        )

        rangeslider(
          :start = rs_min, :end = rs_max, min = 0, max = 1000, step = 10,
          size = 300,
        )

        text(class = nota, content = "rs_min = @rs_min · rs_max = @rs_max")
      }

      column(class = demo) {
        text(class = rotulo, content = "<dial> · <tumbler> · <rating>")

        row(class = linha) {
          dial(
            :value = di_ganho, min = 0, max = 11, step = 1, notches = 11,
            show_value = true,
          )

          tumbler(:value = tu_mes, items = meses, visible = 5, size = 140)

          column(class = coluna) {
            rating(:value = ra_nota)
            rating(:value = ra_nota, readonly = true, size = 14)
          }
        }

        text(
          class = nota,
          content = """
            di_ganho = @di_ganho · tu_mes = @tu_mes · ra_nota = @ra_nota
          """,
        )
      }

      column(class = demo) {
        text(
          class = rotulo,
          content = "<progressbar> · <spinner> · <gauge> · <lcdnumber>",
        )

        row(class = linha) {
          progressbar(
            :value = pb_uso, min = 0, max = 100, show_value = true,
            class = barra,
          )

          spinner

          gauge(
            :value = ga_cpu, max = 100, unit = %, label = CPU, bands = ga_bands,
            needle = true,
          )

          lcdnumber(:value = lcd_relogio, size = 44)
        }
      }
    }
  }
}
