component {
  column {
    class: secao

    text "Seleção, listas e árvores" { class: titulo_cat }

    text """
      O par `value` + `selected="@{…}"`: `value` é a chave que o clique escreve,
      `selected` o valor que o markup lê para destacar. Faltando o segundo, a
      lista fica toda esmaecida.
    """ {
      class: intro
    }

    column {
      class: demos

      column {
        class: demo

        text "<select> — dropdown fechado" { class: rotulo }
        select { class: campo_curto options: se_regioes value: se_regiao }
        text "se_regiao = @se_regiao" { class: nota }
      }

      column {
        class: demo

        text """
          <listview> · <listview mode="multi">
        """ {
          class: rotulo
        }

        row {
          class: linha

          listview {
            items: lv_servicos value: lv_servico selected: @lv_servico
            height: 150 width: fill
          }

          listview {
            items: lv_servicos value: lv_marcados selected: @lv_marcados
            mode: multi height: 150 width: fill
          }
        }

        text "lv_servico = @lv_servico · lv_marcados = @lv_marcados" {
          class: nota
        }
      }

      column {
        class: demo

        text "<tableview> — cabeçalho, ordenação, colunas arrastáveis" {
          class: rotulo
        }

        tableview {
          items: tv_linhas columns: tv_colunas value: tv_sel sort: tv_ordem
          widths: tv_larguras height: 180 width: fill
        }

        text "tv_sel = @tv_sel" { class: nota }
      }

      column {
        class: demo

        text "<treeview> · <columnview> (mesma árvore, identidade por caminho)" {
          class: rotulo
        }

        row {
          class: linha

          treeview {
            items: tr_arvore value: tr_no open: tr_abertos indent: 18
            height: 200 width: fill
          }

          columnview {
            items: tr_arvore value: cv_caminho column_width: 150 height: 200
            width: fill
          }
        }

        text "tr_no = @tr_no · cv_caminho = @cv_caminho" { class: nota }
      }

      column {
        class: demo

        text """
          <pagination> · <pageindicator> (mesma chave; um conta de 1, o outro de
          0)
        """ {
          class: rotulo
        }

        pagination { value: pg_pagina total: 20 }
        pageindicator { value: pi_pagina total: 4 }
        text "pg_pagina = @pg_pagina" { class: nota }
      }

      column {
        class: demo

        text "<fontselect> — cada família desenhada nela mesma (lê __fonts)" {
          class: rotulo
        }

        fontselect { value: ft_fonte selected: @ft_fonte height: 150 }
      }
    }
  }
}
