component {
  column(class = secao) {
    text(class = titulo_cat, content = "Seleção, listas e árvores")

    text(
      """
        O par `value` + `selected="@{…}"`: `value` é a chave que o clique escreve,
        `selected` o valor que o markup lê para destacar. Faltando o segundo, a
        lista fica toda esmaecida.
      """,
      class = intro,
    )

    column(class = demos) {
      column(class = demo) {
        text(class = rotulo, content = "select — dropdown fechado")
        select(class = campo_curto, :options = se_regioes, :value = se_regiao)
        text(class = nota, content = "se_regiao = @se_regiao")
      }

      column(class = demo) {
        text(
          """
            listview · listview(mode = multi)
          """,
          class = rotulo,
        )

        row(class = linha) {
          listview(
            :items = lv_servicos, :value = lv_servico, selected = @lv_servico,
            height = 150, width = fill,
          )

          listview(
            :items = lv_servicos, :value = lv_marcados, selected = @lv_marcados,
            mode = multi, height = 150, width = fill,
          )
        }

        text(
          class = nota,
          content = "lv_servico = @lv_servico · lv_marcados = @lv_marcados",
        )
      }

      column(class = demo) {
        text(
          class = rotulo,
          content = "tableview — cabeçalho, ordenação, colunas arrastáveis",
        )

        tableview(
          :items = tv_linhas, :columns = tv_colunas, :value = tv_sel,
          :sort = tv_ordem,
          :widths = tv_larguras, height = 180, width = fill,
        )

        text(class = nota, content = "tv_sel = @tv_sel")
      }

      column(class = demo) {
        text(
          """
            treeview · columnview (mesma árvore, identidade por caminho)
          """,
          class = rotulo,
        )

        row(class = linha) {
          treeview(
            :items = tr_arvore, :value = tr_no, :open = tr_abertos, indent = 18,
            height = 200, width = fill,
          )

          columnview(
            :items = tr_arvore, :value = cv_caminho, column_width = 150,
            height = 200,
            width = fill,
          )
        }

        text(
          class = nota,
          content = "tr_no = @tr_no · cv_caminho = @cv_caminho",
        )
      }

      column(class = demo) {
        text(
          """
            pagination · pageindicator (mesma chave; um conta de 1, o outro de
            0)
          """,
          class = rotulo,
        )

        pagination(:value = pg_pagina, total = 20)
        pageindicator(value = pi_pagina, total = 4)
        text(class = nota, content = "pg_pagina = @pg_pagina")
      }

      column(class = demo) {
        text(
          """
            <fontselect> — cada família desenhada nela mesma (lê __fonts)
          """,
          class = rotulo,
        )

        fontselect(:value = ft_fonte, selected = @ft_fonte, height = 150)
      }
    }
  }
}
