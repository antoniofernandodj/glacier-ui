[package]
name = "{{nome_projeto}}"
version = "0.1.0"
edition = "2024"

# Dois alvos, um código: a `cdylib` é a biblioteca que o `NativeActivity` do
# Android carrega (`cargo apk build --lib`), e o binário de `src/main.rs` roda o
# MESMO `run()` no desktop — é onde se desenvolve, com hot-reload.
[lib]
name = "{{nome_crate}}"
crate-type = ["cdylib", "rlib"]
path = "src/lib.rs"

[[bin]]
name = "{{nome_projeto}}"
path = "src/main.rs"

[dependencies]
# O motor. Ele reexporta o `iced` (`glacier_ui::iced`). A feature `android` traz
# o que o `NativeActivity` exige (winit, logger do logcat, fonte embutida) e a
# macro `glacier_ui::android_main!`; no desktop ela não muda nada.
glacier-ui = { version = "{{versao_motor}}", features = ["android"] }

# ── O APK ────────────────────────────────────────────────────────────────────
# Lido pelo `cargo-apk`. `build_targets` é o que `make build` compila por padrão
# (só arm64: o celular de hoje). Para emulador x86_64 use `make build ABI=x86_64`.
[package.metadata.android]
package = "com.example.{{nome_crate}}"
build_targets = ["aarch64-linux-android"]

[package.metadata.android.sdk]
min_sdk_version = 26
target_sdk_version = 33

# `fetch`, `sse()` e `websocket()` do Luau precisam disto; sem a permissão o
# Android nega o socket em silêncio e a requisição só "falha".
[[package.metadata.android.uses_permission]]
name = "android.permission.INTERNET"

[package.metadata.android.application]
label = "{{titulo}}"

[package.metadata.android.application.activity]
# Sem isto, girar o aparelho recria a activity e o app reinicia do zero.
config_changes = "orientation|keyboardHidden|screenSize"

# Chave só para testar `make release`: a senha está aqui, no repositório, de
# propósito — NÃO é uma chave de publicação. `release.keystore` está no
# .gitignore e é criada por `make keystore`.
[package.metadata.android.signing.release]
path = "release.keystore"
keystore_password = "{{nome_crate}}"
key_alias = "{{nome_crate}}"
key_password = "{{nome_crate}}"

# O `iced_winit` 0.14 não cria o `EventLoop` no Android (o winit exige o
# `AndroidApp`) nem compila o teclado lá, e o `glacier-ui` (feature `android`)
# usa o `iced_winit::android` que só o fork tem. Este fork mantém o NOME `iced_winit`
# (o `[patch]` só troca um crate por outro de mesmo nome) e muda só o que está
# atrás de `cfg(target_os = "android")`: fora do Android ele é idêntico ao
# original. Ver o README do repositório.
[patch.crates-io]
iced_winit = { git = "https://github.com/antoniofernandodj/iced_winit", tag = "0.14.1-android" }
