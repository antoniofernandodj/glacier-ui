 use std::slice;
 use std::sync::Arc;
 
+/// Cola Android: o `winit` só cria o `EventLoop` com o `AndroidApp` que o
+/// `android_main` recebe. Chame [`set_android_app`] antes de rodar o app.
+#[cfg(target_os = "android")]
+pub mod android {
+    use std::sync::OnceLock;
+
+    pub use winit::platform::android::activity::AndroidApp;
+
+    static ANDROID_APP: OnceLock<AndroidApp> = OnceLock::new();
+
+    /// Registra o `AndroidApp` do `android_main`.
+    pub fn set_android_app(app: AndroidApp) {
+        let _ = ANDROID_APP.set(app);
+    }
+
+    pub(crate) fn get_android_app() -> AndroidApp {
+        ANDROID_APP
+            .get()
+            .expect("AndroidApp não registrado: chame iced_winit::android::set_android_app() no início do android_main")
+            .clone()
+    }
+}
+
