screen(title = "{{titulo}}") {
  resources {
    link(rel = theme, href = "views/styles/theme.json")
    link(rel = stylesheet, href = "views/styles/app.gss")

    script """
      function init()
        ctx.contador = "0"
      end

      local function passo(delta: number)
        ctx.contador = tostring((tonumber(ctx.contador) or 0) + delta)
      end

      function somar()
        passo(1)
      end

      function subtrair()
        passo(-1)
      end

      function zerar()
        ctx.contador = "0"
        toast({
          message = "Contador zerado",
          kind = "info"
        })
      end
    """
  }

  column(class = tela) {
    text(class = rotulo, content = "{{titulo}}")
    text(class = numero, content = "@contador")

    row(class = acoes) {
      button(class = btn, on_click = subtrair, text = "-")
      button(class = btn, on_click = somar, text = "+")
    }

    button(class = btn_ghost, on_click = zerar, text = "zerar")

    text(
      class = dica,
      content = """
        no desktop, edite este arquivo ou o .gss e salve: o hot-reload aplica
      """,
    )
  }
}
