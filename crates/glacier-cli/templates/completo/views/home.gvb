component {
  resources {
    link { rel: import href: "components/stat_card.gvb" as: StatCard }
  }

  column {
    class: conteudo

    column {
      class: cabecalho

      text "Início" { class: titulo }

      text "tudo nesta tela vem de views/home.gvb e views/scripts/handlers/" {
        class: subtitulo
      }
    }

    row {
      class: linha_cards

      StatCard { rotulo: ITENS valor: @total }
      StatCard { rotulo: ATIVOS valor: @ativos destaque: 1 }
      StatCard { rotulo: IP valor: @ip }
    }

    row {
      class: barra

      button "Buscar meu IP" { class: btn_primario on_click: buscar_ip }

      button "Alternar o primeiro" {
        class: btn_ghost on_click: alternar_primeiro
      }

      text "@status" { class: apagado }
    }

    column {
      class: lista

      row {
        class: item for-each: itens var: i

        text "@i.nome" { class: item_nome }
        text "ativo" { class: tag_ok if: @i.ativo equals: 1 }
        text "parado" { class: tag_off else: "" }
      }
    }

    text "nenhum item" { class: apagado if: @total equals: 0 }
  }
}
