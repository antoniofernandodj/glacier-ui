component {
  resources {
    link(rel = import, href = "components/stat_card.gvb", as = StatCard)
  }

  column(class = conteudo) {
    column(class = cabecalho) {
      text(class = titulo, content = "Início")

      text(
        class = subtitulo,
        content = """
          tudo nesta tela vem de views/home.gvb e views/scripts/handlers/
        """,
      )
    }

    row(class = linha_cards) {
      StatCard(rotulo = ITENS, valor = @total)
      StatCard(rotulo = ATIVOS, valor = @ativos, destaque = 1)
      StatCard(rotulo = IP, valor = @ip)
    }

    row(class = barra) {
      button(class = btn_primario, on_click = buscar_ip, text = "Buscar meu IP")

      button(
        class = btn_ghost, on_click = alternar_primeiro,
        text = "Alternar o primeiro",
      )

      text(class = apagado, content = "@status")
    }

    column(class = lista) {
      row(class = item, :for-each = itens, var = i) {
        text(class = item_nome, content = "@i.nome")
        text(class = tag_ok, if = @i.ativo, equals = 1, content = "ativo")
        text(class = tag_off, else, content = "parado")
      }
    }

    text(class = apagado, if = @total, equals = 0, content = "nenhum item")
  }
}
