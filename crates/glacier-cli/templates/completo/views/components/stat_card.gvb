component {
  props {
    prop(name = rotulo)
    prop(name = valor)
    prop(name = destaque, default = "")
  }

  resources {
    style(scoped = true) """
      .stat {
        width: fill;
        background: var(--raised);
        border-radius: 6; border-width: 1;
        border-color: var(--border);
        padding: 14 18; spacing: 6;
      }
      .stat_num {
        size: 24;
        bold: true;
        color: var(--accent);
      }
      .stat_num_ok {
        size: 24;
        bold: true;
        color: var(--ok);
      }
    """
  }

  column(class = stat) {
    text(class = rotulo_cap, content = "@rotulo")
    text(class = stat_num_ok, if = @destaque, equals = 1, content = "@valor")
    text(class = stat_num, else = "", content = "@valor")
  }
}
