<screen title="{{titulo}}" size="980 640" min-size="560 420">
  <resources>
    <link rel="theme"      href="views/styles/theme.json" />
    <link rel="stylesheet" href="views/styles/app.gss" />

    <link rel="import" href="home.gv"  as="Home" />
    <link rel="import" href="sobre.gv" as="Sobre" />
    <link rel="import" href="components/nav_item.gv" as="NavItem" />

    <script src="scripts/app.luau"></script>

    <style scoped="true">
      .titlebar       { width: fill; height: 34; background: var(--surface); align-y: center; }
      .titlebar_drag  { width: fill; height: fill; align-y: center; padding: 0 0 0 14; spacing: 9; }
      .titlebar_ponto { size: 10; color: var(--accent); }
      .titlebar_nome  { size: 12; bold: true; color: var(--muted); }
      .win_btn        { width: 46; padding: 5 0; color: var(--surface); text-color: var(--muted); text-align: center; }
      .win_btn:hover  { color: var(--border); text-color: var(--text); }
      .win_fechar       { width: 46; padding: 5 0; color: var(--surface); text-color: var(--muted); text-align: center; }
      .win_fechar:hover { color: var(--danger); text-color: var(--text); }

      .rz_topo   { width: fill; height: 5; }
      .rz_baixo  { width: fill; height: 5; }
      .rz_meio   { width: fill; height: fill; }
      .rz_corpo  { width: fill; height: fill; }
      .rz_canto  { width: 5; height: fill; }
      .rz_h      { width: fill; height: fill; cursor: resize-v; }
      .rz_v      { width: 5; height: fill; cursor: resize-h; }
      .rz_nw     { cursor: resize-nw; }
      .rz_ne     { cursor: resize-ne; }
      .rz_sw     { cursor: resize-sw; }
      .rz_se     { cursor: resize-se; }
    </style>
  </resources>

  <column class="janela">

    <row class="rz_topo">
      <column class="rz_canto rz_nw" on_press="window:resize:nw" />
      <column class="rz_h" on_press="window:resize:n" />
      <column class="rz_canto rz_ne" on_press="window:resize:ne" />
    </row>

    <row class="rz_meio">
      <column class="rz_v" on_press="window:resize:w" />

      <column class="rz_corpo">

        <row class="titlebar">
          <row class="titlebar_drag" on_press="window:drag" on_double_click="window:maximize">
            <text class="titlebar_ponto">*</text>
            <text class="titlebar_nome">{{titulo}}</text>
          </row>
          <button class="win_btn"    text="—" on_click="window:minimize" />
          <button class="win_btn"    text="▢" on_click="window:maximize" />
          <button class="win_fechar" text="✕" on_click="window:close" />
        </row>

        <row class="corpo">
          <column class="sidebar">
            <text class="marca">{{titulo}}</text>
            <NavItem rotulo="Início" rota="home"  acao="ir_home"  ativo="{view}" />
            <NavItem rotulo="Sobre"  rota="sobre" acao="ir_sobre" ativo="{view}" />
          </column>

          <Home  if="{view}" equals="home" />
          <Sobre if="{view}" equals="sobre" />
        </row>
      </column>

      <column class="rz_v" on_press="window:resize:e" />
    </row>

    <row class="rz_baixo">
      <column class="rz_canto rz_sw" on_press="window:resize:sw" />
      <column class="rz_h" on_press="window:resize:s" />
      <column class="rz_canto rz_se" on_press="window:resize:se" />
    </row>

  </column>
</screen>
