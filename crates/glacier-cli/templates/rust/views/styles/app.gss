:root {
  --bg:      #11111B;
  --surface: #1E1E2E;
  --border:  #313244;
  --text:    #CDD6F4;
  --muted:   #7F849C;
  --accent:  #89B4FA;
}

/* Sem `background` aqui: o fundo da janela é do `theme.json`. Um `background`
   de mesma cor num nó `fill/fill` é uma camada redobrada em cada pixel da
   tela — invisível e cara (ver AGENTS.md). */
.tela   { width: fill; height: fill; padding: 30; spacing: 14; align_x: center; align_y: center; }
.rotulo { size: 11; bold: true; color: var(--muted); }
.numero { size: 56; bold: true; color: var(--text); }
.acoes  { spacing: 12; align_y: center; }
.campo  { width: 220; spacing: 6; }

.btn        { color: var(--surface); text_color: var(--text); padding: 8 28; border_radius: 8; }
.btn:hover  { color: var(--border); }
.btn:active { color: var(--accent); }

.btn_ghost       { color: var(--bg); text_color: var(--muted); padding: 6 14; border_radius: 6; }
.btn_ghost:hover { text_color: var(--text); }

.entrada       { width: fill; padding: 9; background: var(--surface); border_radius: 6; border_width: 1; border_color: var(--border); }
.entrada:focus { border_color: var(--accent); }
