<screen title="{{titulo}}" size="420 380" min_size="340 320">
 <resources>
  <link rel="theme"      href="views/styles/theme.json" />
  <link rel="stylesheet" href="views/styles/app.gss" />
 </resources>

 <column class="tela">
  <text class="rotulo">{{titulo}}</text>
  <text class="numero">{contador}</text>

  <row class="acoes">
   <button class="btn" text="-" on_click="subtrair" />
   <button class="btn" text="+" on_click="somar" />
  </row>

  <column class="campo">
   <text class="rotulo">PASSO</text>
   <textinput class="entrada" value="passo_texto" on_change="mudar_passo" placeholder="1" />
  </column>

  <button class="btn_ghost" text="zerar" on_click="zerar" />
 </column>
</screen>
