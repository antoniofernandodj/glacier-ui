screen {
  title: "{{titulo}}" size: "420 380" min_size: "340 320"

  resources {
    link { rel: theme href: "views/styles/theme.json" }
    link { rel: stylesheet href: "views/styles/app.gss" }
  }

  column {
    class: tela

    text "{{titulo}}" { class: rotulo }
    text "@contador" { class: numero }

    row {
      class: acoes

      button "-" { class: btn on_click: subtrair }
      button "+" { class: btn on_click: somar }
    }

    column {
      class: campo

      text "PASSO" { class: rotulo }

      textinput {
        class: entrada value: passo_texto on_change: mudar_passo placeholder: 1
      }
    }

    button "zerar" { class: btn_ghost on_click: zerar }
  }
}
