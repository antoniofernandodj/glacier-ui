screen(
  title = Detalhe, size = "380 300", min_size = "300 240",
  icon = "views/assets/icone.png",
) {
  resources {
    link(rel = theme, href = "views/styles/theme.json")
    link(rel = stylesheet, href = "views/styles/app.gss")
    script(src = "scripts/detalhe.luau")
  }

  column(class = tela) {
    column(class = cabecalho) {
      text(class = titulo, content = "Detalhe")
      text(class = subtitulo, content = "aberta por: @origem")
    }

    column(class = painel) {
      text(class = rotulo_cap, content = "CONTADOR DESTA JANELA")
      text(class = numero, content = "@contador")
      text(
        class = apagado,
        content = "cada janela tem o seu — abra duas e compare",
      )
    }

    column(class = acoes) {
      button(class = btn_primario, on_click = contar, text = "Contar")

      button(
        class = btn_ghost, on_click = avisar_e_fechar,
        text = "Avisar o painel e fechar",
      )
    }
  }
}
