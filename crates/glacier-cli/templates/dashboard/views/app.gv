screen(title = "{{titulo}} — painel", size = "960 660", min_size = "560 460") {
  resources {
    link(rel = theme, href = "views/styles/theme.json")
    link(rel = stylesheet, href = "views/styles/app.gss")
    script(src = "scripts/app.luau")
  }

  column(class = tela) {
    row(class = topo) {
      text(class = titulo, content = "Operação")
      space
      text(class = apagado, content = "atualiza a cada 1s · @relogio")
    }

    row(class = kpis) {
      card(title = "Requisições / min", class = kpi) {
        text(class = numero, content = "@kpi_total")
      }

      card(title = "Taxa de erro", class = kpi) {
        text(class = numero, content = "@kpi_taxa%")
      }

      card(title = "Latência p95", class = kpi) {
        text(class = numero, content = "@kpi_lat ms")
      }
    }

    row(class = graficos) {
      column(class = painel) {
        text(
          class = rotulo,
          content = "Requisições por serviço (série múltipla)",
        )
        linechart(:series = serie_req, min = 0, grid = true, class = grafico)
      }

      column(class = painel) {
        text(class = rotulo, content = "Chamadas por rota")
        barchart(:items = barras, colorful = true, class = grafico)
      }
    }

    row(class = graficos) {
      column(class = painel) {
        text(class = rotulo, content = "Distribuição de respostas")
        donut(:items = fatias, size = 180, percentages = true)
      }

      column(class = painel) {
        text(class = rotulo, content = "Saturação")

        row(class = linha) {
          gauge(
            :value = g_cpu, max = 100, unit = %, label = CPU, bands = g_bands,
            needle = true,
          )

          gauge(
            :value = g_disco, max = 100, unit = %, label = disco,
            bands = g_bands,
            needle = true,
          )
        }
      }
    }

    row(class = rodape) {
      text(class = rotulo, content = "CPU")
      sparkline(items = spark_cpu, class = mini)
      text(class = rotulo, content = "memória")
      sparkline(items = spark_mem, class = mini, color = #F9E2AF)
    }
  }
}
