:root {
  --bg:      #11111B;
  --surface: #181825;
  --raised:  #1E1E2E;
  --border:  #313244;
  --text:    #CDD6F4;
  --muted:   #7F849C;
  --faint:   #585B70;
  --accent:  #89B4FA;
}

/* Sem `background` na raiz: o fundo vem do theme.json (ver AGENTS.md). */
.tela { width: fill; height: fill; padding: 22 26; spacing: 16; }

.topo    { width: fill; align_y: center; spacing: 10; }
.titulo  { size: 22; bold: true; color: var(--text); }
.apagado { size: 12; color: var(--faint); }

.kpis { width: fill; spacing: 14; }
.kpi  { width: fill; }
.numero { size: 30; bold: true; color: var(--accent); }

.graficos { width: fill; spacing: 14; }
.painel   { width: fill; background: var(--surface); border_radius: 8; border_width: 1; border_color: var(--border); padding: 14; spacing: 8; }
.rotulo   { size: 11; bold: true; color: var(--muted); }
.linha    { spacing: 14; align_y: center; }
.grafico  { width: fill; height: 190; }

.rodape { width: fill; spacing: 12; align_y: center; }
.mini   { width: 220; height: 34; }

@media (max-width: 720) {
  .kpis     { hidden: true; }
  .tela     { padding: 16 14; }
}
