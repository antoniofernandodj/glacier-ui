screen {
  title: "{{titulo}} — serviços" size: "720 560" min_size: "520 400"

  resources {
    link { rel: theme href: "views/styles/theme.json" }
    link { rel: stylesheet href: "views/styles/app.gss" }
    script { src: "scripts/app.luau" }
  }

  column {
    class: tela

    row {
      class: topo

      text "Serviços" { class: titulo }
      space
      text "@total no total · selecionado: @sel" { class: apagado }
    }

    row {
      class: barra

      textinput {
        class: busca value: q on_change: filtrar placeholder: "filtrar…"
      }

      space
      button { class: btn_prim text: Novo on_click: novo }
      button "Editar" { class: btn on_click: editar }
      button "Excluir" { class: btn_danger on_click: excluir }
    }

    tableview {
      items: linhas columns: colunas value: sel sort: ordem widths: larguras
      height: fill width: fill
    }
  }
}
