{
  "comments": {
    "blockComment": ["<!--", "-->"]
  },
  "brackets": [
    ["<", ">"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"" },
    { "open": "<!--", "close": "-->", "notIn": ["comment"] }
  ],
  "surroundingPairs": [
    ["<", ">"],
    ["{", "}"],
    ["\"", "\""]
  ],
  "onEnterRules": [
    {
      "beforeText": "<([A-Za-z_][\\w.:-]*)(?:(?:[^'\"/>]|\"[^\"]*\"|'[^']*')*?(?!/)>)[^<]*$",
      "afterText": "^<\\/([A-Za-z_][\\w.:-]*)\\s*>",
      "action": { "indent": "indentOutdent" }
    },
    {
      "beforeText": "<([A-Za-z_][\\w.:-]*)(?:(?:[^'\"/>]|\"[^\"]*\"|'[^']*')*?(?!/)>)[^<]*$",
      "action": { "indent": "indent" }
    }
  ]
}
