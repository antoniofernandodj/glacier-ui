{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Luau (Glacier)",
  "scopeName": "source.glacier-luau",
  "comment": "Luau/Lua embutido nos `<script>` e `script \"\"\"`. O VS Code não traz gramática de Lua; sem esta, o corpo do script ficaria sem cor para quem não instalou outra extensão.",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#function-def" },
    { "include": "#type-annotation" },
    { "include": "#keyword" },
    { "include": "#constant" },
    { "include": "#glacier-global" },
    { "include": "#builtin" },
    { "include": "#call" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.block.lua",
          "begin": "--\\[(=*)\\[",
          "end": "\\]\\1\\]",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.lua" } },
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.lua" } }
        },
        {
          "name": "comment.line.double-dash.lua",
          "match": "(--)(?!\\[=*\\[).*$",
          "captures": { "1": { "name": "punctuation.definition.comment.lua" } }
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.other.multiline.lua",
          "begin": "\\[(=*)\\[",
          "end": "\\]\\1\\]"
        },
        {
          "name": "string.quoted.double.lua",
          "begin": "\"",
          "end": "\"|(?<!\\\\)$",
          "patterns": [{ "include": "#escape" }]
        },
        {
          "name": "string.quoted.single.lua",
          "begin": "'",
          "end": "'|(?<!\\\\)$",
          "patterns": [{ "include": "#escape" }]
        },
        {
          "name": "string.interpolated.lua",
          "begin": "`",
          "end": "`",
          "patterns": [
            { "include": "#escape" },
            {
              "name": "meta.embedded.line.lua",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [{ "include": "$self" }]
            }
          ]
        }
      ]
    },
    "escape": {
      "name": "constant.character.escape.lua",
      "match": "\\\\(?:[abfnrtvz\\\\\"'`{]|\\d{1,3}|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\}|\\n)"
    },
    "number": {
      "patterns": [
        { "name": "constant.numeric.hex.lua", "match": "\\b0[xX][0-9A-Fa-f_]+\\b" },
        { "name": "constant.numeric.binary.lua", "match": "\\b0[bB][01_]+\\b" },
        { "name": "constant.numeric.decimal.lua", "match": "(?<![\\w.])(?:\\d[\\d_]*\\.?[\\d_]*|\\.\\d[\\d_]*)(?:[eE][+-]?\\d+)?(?![\\w.])" }
      ]
    },
    "function-def": {
      "patterns": [
        {
          "match": "\\b(local\\s+)?(function)\\s+((?:[A-Za-z_]\\w*[.:])*)([A-Za-z_]\\w*)",
          "captures": {
            "1": { "name": "storage.modifier.local.lua" },
            "2": { "name": "keyword.control.function.lua" },
            "3": { "name": "entity.name.type.namespace.lua" },
            "4": { "name": "entity.name.function.lua" }
          }
        },
        {
          "match": "\\b(function)\\b",
          "name": "keyword.control.function.lua"
        }
      ]
    },
    "type-annotation": {
      "comment": "`: number`, `: { string }`, `-> string` do Luau. Heurística: dois-pontos seguido de um tipo conhecido ou de um nome com inicial maiúscula.",
      "patterns": [
        {
          "match": "(?<=[\\w)\\s]):\\s*(\\??(?:number|string|boolean|any|nil|unknown|never|buffer|thread|vector|table)\\b\\??)",
          "captures": { "1": { "name": "support.type.primitive.luau" } }
        },
        {
          "match": "(->)\\s*(\\??[A-Za-z_]\\w*\\??)",
          "captures": {
            "1": { "name": "keyword.operator.type.luau" },
            "2": { "name": "support.type.luau" }
          }
        },
        {
          "match": "\\b(type|export)\\s+([A-Za-z_]\\w*)\\s*(?==)",
          "captures": {
            "1": { "name": "storage.type.luau" },
            "2": { "name": "entity.name.type.luau" }
          }
        }
      ]
    },
    "keyword": {
      "patterns": [
        { "name": "keyword.control.lua", "match": "\\b(?:if|then|elseif|else|end|for|while|do|repeat|until|return|break|continue|in|goto)\\b" },
        { "name": "keyword.operator.logical.lua", "match": "\\b(?:and|or|not)\\b" },
        { "name": "storage.modifier.local.lua", "match": "\\blocal\\b" }
      ]
    },
    "constant": {
      "patterns": [
        { "name": "constant.language.lua", "match": "\\b(?:nil|true|false)\\b" },
        { "name": "variable.language.self.lua", "match": "\\bself\\b" }
      ]
    },
    "glacier-global": {
      "comment": "Os globais que o motor injeta no script.",
      "match": "\\b(ctx|console|json|fetch|sse|websocket|open_window|prompt|progress|pick_color|alert|confirm|storage|timer|clipboard)\\b(?=\\s*[.:(\\[])",
      "name": "support.variable.glacier.lua"
    },
    "builtin": {
      "patterns": [
        { "name": "support.function.builtin.lua", "match": "\\b(?:assert|error|ipairs|pairs|next|select|pcall|xpcall|print|require|rawget|rawset|rawequal|rawlen|setmetatable|getmetatable|tonumber|tostring|type|typeof|unpack)\\b(?=\\s*\\()" },
        { "name": "support.class.library.lua", "match": "\\b(?:string|math|table|os|io|coroutine|utf8|bit32|buffer|debug)\\b(?=\\s*\\.)" }
      ]
    },
    "call": {
      "patterns": [
        {
          "match": "(?<=[.:])\\s*([A-Za-z_]\\w*)\\s*(?=[(\"'{\\[])",
          "captures": { "1": { "name": "entity.name.function.method.lua" } }
        },
        {
          "match": "\\b([A-Za-z_]\\w*)\\s*(?=\\()",
          "captures": { "1": { "name": "entity.name.function.call.lua" } }
        }
      ]
    },
    "operator": {
      "patterns": [
        { "name": "keyword.operator.concat.lua", "match": "\\.\\.\\.?" },
        { "name": "keyword.operator.lua", "match": "\\+=|-=|\\*=|/=|//=|%=|\\^=|\\.\\.=|==|~=|<=|>=|//|[+\\-*/%^#<>=&|~]" }
      ]
    }
  }
}
