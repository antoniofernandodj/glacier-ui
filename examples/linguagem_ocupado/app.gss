.tela      { padding: 24; spacing: 14; width: fill; height: fill; background: #1E1F22; }
.titulo    { size: 22; bold: true; }
.subtitulo { size: 15; bold: true; }
.nota      { size: 13; color: #949BA4; }
.codigo    { size: 12; font: mono; color: #949BA4; }
.valor     { size: 15; }
.linha     { spacing: 10; align_y: center; }

.bloco {
  width: fill;
  padding: 14;
  spacing: 10;
  background: #2B2D31;
  border_radius: 8;
}

.btn {
  color: #5865F2;
  text_color: #FFFFFF;
  padding: 6 14;
  border_radius: 5;
}
.btn:disabled {
  background: #3A3C42;
  text_color: #B5B8BF;
}
