<screen title="Glacier - ComboEdit (servidores salvos)">
    <!-- `<ComboEdit>`: dropdown editável (combo_box do iced). Digite um servidor
         novo à vontade, ou escolha um dos já salvos na lista — escolher um
         preenche o token sozinho (veja `servidor_selecionado` em main.rs). -->
    <Container padding="24" width="fill" height="fill" background="#2E3440">
        <Column spacing="16" width="420">
            <Text content="Servidores salvos" size="24" bold="true" color="#ECEFF4" />

            <Column spacing="6" width="fill">
                <Text content="Servidor" size="13" color="#D8DEE9" />
                <ComboEdit
                    options="servidores"
                    value="url"
                    placeholder="https://servidor.exemplo.com"
                    onChange="url_changed"
                    onSelect="servidor_selecionado"
                    width="fill"
                />
            </Column>

            <Column spacing="6" width="fill">
                <Text content="Token" size="13" color="#D8DEE9" />
                <TextInput value="token" onChange="token_changed" placeholder="token de acesso" secure="true" width="fill" />
            </Column>

            <Button text="Salvar este par" on_click="salvar" color="#5E81AC" width="fill" />

            <Rule />

            <Text content="Pares salvos:" size="13" color="#D8DEE9" />
            <Text content="{pares_txt}" size="12" color="#A3BE8C" />
        </Column>
    </Container>
</screen>
