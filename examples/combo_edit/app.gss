/* Estilo que estava inline no markup. Os nomes são provisórios: renomeie
   cada classe pelo papel que ela tem na tela. */

.caixa { padding: 24; width: fill; height: fill; }
.coluna { spacing: 16; width: 420; }
.titulo { size: 24; bold: true; color: #ECEFF4; }
.coluna_2 { spacing: 6; width: fill; }
.texto { size: 13; color: #D8DEE9; }
.campo { width: fill; }
.botao { color: #5E81AC; width: fill; }
.nota { size: 12; color: #A3BE8C; }
