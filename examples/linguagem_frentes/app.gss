/* O `.gss` do exemplo `linguagem_frentes`, na semântica do CSS (Frente 8):
   `background` é o fundo, `color` é o conteúdo — também num `button`. Nenhum
   `text_color` aqui; a paleta sai dos tokens e o estado mora dentro do bloco. */

:root {
  --fundo: #17181C;
  --caixa: #23252B;
  --caixa-alta: #2C2F36;
  --borda: #3F4147;
  --texto: #DEE1E6;
  --fraco: #98A0AB;
  --azul: #5B6BFF;
  --azul-claro: #7A87FF;
  --verde: #3BA55D;
  --vermelho: #C4302F;
  --ambar: #C99A2E;
}

@theme {
  background: var(--fundo);
  text: var(--texto);
  primary: var(--azul);
  success: var(--verde);
  danger: var(--vermelho);
}

.tela {
  width: fill;
  padding: 26;
  spacing: 14;
  background: var(--fundo);
}

.cabecalho {
  spacing: 12;
  align_y: center;
}

.titulo {
  size: 22;
  bold: true;
  color: var(--texto);
}

.nota,
.rodape {
  size: 12;
  color: var(--fraco);
}

.bloco {
  width: fill;
  padding: 18;
  spacing: 10;
  background: var(--caixa);
  border_radius: 12;
  border_width: 1;
  border_color: var(--borda);
}

.subtitulo {
  size: 14;
  bold: true;
  color: var(--texto);
}

.linha,
.grade {
  spacing: 10;
  align_y: center;
}

.item {
  width: fill;
  padding: 8 12;
  spacing: 10;
  align_y: center;
  background: var(--caixa-alta);
  border_radius: 8;
}

.nome,
.valor {
  size: 13;
  color: var(--texto);
}

.codigo {
  size: 12;
  font_family: mono;
  color: var(--fraco);
}

.ok {
  color: var(--verde);
}

.alerta {
  color: var(--ambar);
}

.campo,
.campo_grande,
.largo {
  padding: 8 10;
  background: var(--caixa-alta);
  border_width: 1;
  border_color: var(--borda);
  border_radius: 8;
  color: var(--texto);

  &:is(:hover, :focus) {
    border_color: var(--azul);
  }
}

.largo {
  width: 260;
}

.campo_grande {
  width: 220;
}

.campo {
  width: 140;
}

.btn,
.btn_suave {
  padding: 8 16;
  border_radius: 8;
  background: var(--azul);
  color: #FFFFFF;
  transition: all 150ms ease-out;

  &:hover {
    background: var(--azul-claro);
  }

  &:disabled {
    background: var(--caixa-alta);
    color: var(--fraco);
  }
}

.btn_suave {
  background: var(--caixa-alta);
  color: var(--texto);

  &:hover {
    background: var(--borda);
  }
}

.giro {
  size: 16;
  color: var(--azul);
}

.ponto {
  width: 10;
  height: 10;
  border_radius: 6;
  background: var(--fraco);
}

.ponto.ok {
  background: var(--verde);
}

.ponto.ruim {
  background: var(--vermelho);
}

.cartao {
  width: fill;
  padding: 18;
  spacing: 8;
  background: var(--caixa);
  border_radius: 12;
  border_width: 1;
  border_color: var(--borda);

  &--aberto {
    border_color: var(--azul);
  }
}

.cartao__cabecalho,
.cartao__pe {
  spacing: 10;
  align_y: center;
}

.cartao__titulo {
  size: 15;
  bold: true;
  color: var(--texto);
}

.cartao__acao {
  size: 12;
  color: var(--azul);
}

.cartao__resumo,
.cartao__vazio,
.cartao__contagem,
.cartao__global {
  size: 12;
  color: var(--fraco);
}

.cartao__corpo {
  width: fill;
  padding: 10;
  background: var(--caixa-alta);
  border_radius: 8;
}

.cartao__btn {
  padding: 6 12;
  border_radius: 8;
  background: var(--verde);
  color: #FFFFFF;

  &:hover {
    background: #4CBF73;
  }
}
