/* O `.gss` do exemplo `linguagem_frentes` — na semântica do CSS (Frente 8):
   `background` é o fundo, `color` é o conteúdo, também num `button`. Não existe
   nenhum `text_color` aqui; quem ainda escreve `color` como fundo recebe o aviso
   do `glacier check` e passa pelo `glacier fmt --migrate-color`. */

.tela {
  padding: 18;
  background: #0d1117;
  color: #e6edf3;
}

.cabecalho {
}

.titulo {
  size: 22;
  color: #7dd3fc;
}

.nota {
  size: 12;
  color: #8b949e;
}

.bloco {
  padding: 14;
  background: #161b22;
  border_width: 1;
  border_radius: 10;
}

.subtitulo {
  size: 15;
  color: #a5d6ff;
}

.linha,
.grade {
}

.item {
  padding: 4 8px;
  background: #0b0f14;
  border_radius: 8;
}

.valor {
  size: 13;
  color: #c9d1d9;
}

.codigo {
  size: 12;
  color: #9cdcfe;
}

.ok {
  color: #3fb950;
}

.alerta {
  color: #f85149;
}

.largo {
  width: 260;
}

.campo_grande {
  width: 240;
}

.btn,
.btn_suave {
  padding: 7 14px;
  border_radius: 8;
  background: #1a5fb4;
  color: #f0f6fc;
}

.btn_suave {
  background: #21262d;
  color: #c9d1d9;
}

.btn:hover {
  background: #388bfd;
}

.giro {
  size: 18;
  color: #58a6ff;
}

.ponto {
  width: 10;
  height: 10;
  border_radius: 6;
  background: #6e7681;
}

.ponto.ok {
  background: #3fb950;
}

.ponto.ruim {
  background: #f85149;
}

.cartao {
  padding: 14;
  width: 300;
  background: #161b22;
  border_width: 1;
  border_radius: 12;
}

.cartao--aberto {
}

.cartao__cabecalho {
}

.cartao__titulo {
  size: 15;
  color: #e6edf3;
}

.cartao__acao {
  size: 12;
  color: #58a6ff;
}

.cartao__resumo,
.cartao__vazio,
.cartao__contagem,
.cartao__global {
  size: 12;
  color: #8b949e;
}

.cartao__pe {
}

.cartao__btn {
  padding: 6 12px;
  border_radius: 8;
  background: #1a6b2c;
  color: #f0f6fc;
}

.rodape {
  size: 12;
  color: #6e7681;
}
