<screen title="Glacier - ciclo de vida (monitor)">
  <resources>
    <link rel="theme" href="examples/stream_lua/theme.json" />
    <script src="monitor.luau"></script>
  </resources>

  <container padding="24" align_x="Center" align_y="Center" width="fill" height="fill">
    <column spacing="14" align="Center" width="520">
      <text size="18" bold="true" color="#ECEFF4">Monitor</text>
      <text size="13" color="#EBCB8B">ciclo: {ciclo}</text>

      <text size="13" bold="true" color="#88C0D0">— SSE (/sse, um tick a cada 500 ms) —</text>
      <text size="13" color="#EBCB8B">{sse_status}</text>
      <text size="15" color="#A3BE8C">{sse_msg}</text>

      <text size="13" bold="true" color="#88C0D0">— WebSocket (/ws, eco + tick) —</text>
      <text size="13" color="#EBCB8B">{ws_status}</text>
      <text size="15" color="#A3BE8C">{ws_msg}</text>
      <button on_click="enviar_ws" color="#A3BE8C" padding="10 18">
        Enviar ping
      </button>
      <button on_click="voltar" color="#BF616A" padding="10 18">
        Voltar (fecha os streams)
      </button>
    </column>
  </container>
</screen>
