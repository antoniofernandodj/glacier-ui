screen(title = "CSS moderno", size = "520 640") {
  resources {
    link(rel = stylesheet, href = "examples/css_moderno/app.gss")
  }

  column(class = tela) {
    text("opacity, transition, calc() e var()", class = titulo)

    text("::first-child azul, :last-child laranja, odd mais claro, 3n verde (linhas 3 e 6).", class = nota)
    column(class = lista) {
      container(class = linha) { text("1 — first-child") }
      container(class = linha) { text("2") }
      container(class = linha) { text("3 — odd e 3n") }
      container(class = linha) { text("4") }
      container(class = linha) { text("5 — odd") }
      container(class = linha) { text("6 — last-child e 3n") }
    }

    text("Sem transition: a troca de cor é instantânea.", class = nota)
    button(class = "botao seco", text = "Sem transition", on_click = ok)

    text("Com transition: background 400ms ease-out.", class = nota)
    button(class = "botao suave", text = "Com transition (400 ms)", on_click = ok)

    text("opacity: 0.35 num botão (alfa nas cores do próprio botão).", class = nota)
    button(class = "botao fantasma", text = "Botão com opacity", on_click = ok)

    text("calc(): largura 260 = calc(300 - 2 * 20); raio = calc(var(--raio) * 2).", class = nota)
    container(class = caixa) { text("caixa sem opacity") }
    container(class = "caixa caixa_translucida") { text("caixa com opacity: 50%") }
  }
}
