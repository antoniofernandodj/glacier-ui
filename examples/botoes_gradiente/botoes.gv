// Botões grandes e largos com gradiente.
//
//   WGPU_BACKEND=gl cargo run --example botoes_gradiente
//
// `gradient:` no .gss pinta o fundo do próprio `button` (hover, pressed e
// disabled derivam das paradas). O mesmo `gradient` vale em um `container`.
screen(title = "Glacier - Botões com gradiente") {
  resources {
    link(rel = theme, href = "examples/botoes_gradiente/theme.json")
    link(rel = stylesheet, href = "examples/botoes_gradiente/botoes.gss")
  }

  container(class = tela) {
    column(class = coluna) {
      text(class = titulo, content = "Botões com gradiente")
      text(class = fraco, content = "Último clique: @ultimo")

      button("Começar", class = "botao azul", on_click = azul)
      button("Atualizar para Pro", class = "botao roxo", on_click = roxo)
      button("Salvar alterações", class = "botao verde", on_click = verde)
      button("Limpar tudo", class = "botao rosa", on_click = rosa)

      row(spacing = 12) {
        button("Manter", class = "botao pequeno azul", on_click = azul)
        button("Excluir", class = "botao pequeno rosa", on_click = rosa)
      }
    }
  }
}
