<screen title="Glacier - Janela principal" size="520 400">
  <resources>
    <!-- O fundo da janela é do TEMA, não de um `background` na raiz: pintar
         um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
         em cada pixel da tela, e ela custa (ver AGENTS.md). -->
    <link rel="theme" href="examples/janelas_glacier/theme_painel.json" />
  </resources>

  <container
    padding="30"
    align_x="Center"
    align_y="Center"
    width="fill"
    height="fill"
  >
    <column spacing="22" align="Center">
      <text size="28" bold="true" color="#ECEFF4">Painel (Rust)</text>
      <text size="18" color="#A3BE8C">Contador desta janela: {valor}</text>
      <text size="14" color="#EBCB8B">Broadcasts recebidos: {recebidos}</text>

      <button text="Incrementar" on_click="incrementar" color="#5E81AC" width="260" padding="10" />

      <text size="13" color="#81A1C1">Abrir nova janela:</text>
      <row spacing="12" align="Center">
        <button text="Component Rust" on_click="nova_rust" color="#B48EAD" padding="10 16" />
        <button text="XML (Lua)" on_click="nova_xml" color="#D08770" padding="10 16" />
      </row>
    </column>
  </container>
</screen>
