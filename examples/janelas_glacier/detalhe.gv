<screen title="Detalhe (Lua)" size="420 320">
  <resources>
    <!-- O fundo da janela é do TEMA, não de um `background` na raiz: pintar
         um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
         em cada pixel da tela, e ela custa (ver AGENTS.md). -->
    <link rel="theme" href="examples/janelas_glacier/theme_detalhe.json" />
    <script>
      -- Semeia o estado inicial desta janela (contador próprio, isolado das demais).
      -- `origem` vem semeado por open_window({ data = { origem = ... } }); default se
      -- a janela foi aberta sem data.
      function init()
        ctx.n = ctx.n or "0"
        ctx.origem = ctx.origem or "(desconhecida)"
      end

      function contar()
        ctx.n = tostring((tonumber(ctx.n) or 0) + 1)
      end

      -- Caminho Lua puro: abre MAIS uma janela carregando este mesmo XML, passando
      -- de onde veio via `data`.
      function abrir_outra()
        open_window({
          file="examples/janelas_glacier/detalhe.gv",
          title="Detalhe (Lua)",
          width = 420,
          height = 320,
          data = { origem="detalhe" },
        })
      end

      -- Envia o contador atual ao painel (broadcast p/ as OUTRAS janelas) e fecha a si
      -- mesma — o padrão "janela auxiliar devolve um resultado e some".
      function avisar_e_fechar()
        broadcast("detalhe_contou", { n = ctx.n })
        close_window()
      end
    </script>
  </resources>

  <container
    padding="30"
    align_x="Center"
    align_y="Center"
    width="fill"
    height="fill"
  >
    <column spacing="20" align_x="Center">
      <text size="24" bold="true" color="#F5E0DC">Detalhe (XML + Lua)</text>
      <text size="13" color="#9399B2">Aberto por: {origem}</text>
      <text size="16" color="#89B4FA">Cliques nesta janela: {n}</text>

      <button text="Contar" on_click="contar" color="#89B4FA" width="240" padding="10" />
      <button
        text="Abrir outra (Lua)"
        on_click="abrir_outra"
        color="#A6E3A1"
        width="240"
        padding="10"
      />
      <button
        text="Enviar ao painel e fechar"
        on_click="avisar_e_fechar"
        color="#F38BA8"
        width="240"
        padding="10"
      />
    </column>
  </container>
</screen>
