<screen title="Glacier - Pseudo-estados (:hover/:focus/:active/:disabled)">
  <resources>
    <!-- Tema da janela (paleta do iced) — também elimina o fundo branco padrão. -->
    <link rel="theme" href="examples/pseudo_estados/theme.json" />
  </resources>

  <container class="card">
    <column class="stack">
      <text class="title">Pseudo-estados: :hover / :focus / :active / :disabled</text>
      <text class="subtitle">
        Passe o mouse, clique e compare com a versão desabilitada de cada widget.
      </text>

      <!-- Button: :hover (passe o mouse) / :active (segure o clique) / :disabled -->
      <column class="stack" spacing="8">
        <text class="label">Button — hover / active / disabled</text>
        <row class="row">
          <button class="btn" text="Enviar" on_click="enviar" />
          <button class="btn" text="Desabilitado" disabled="true" />
        </row>
      </column>

      <!-- TextInput: :hover / :focus (clique para focar) / :disabled -->
      <column class="stack" spacing="8">
        <text class="label">TextInput — hover / focus / disabled</text>
        <row class="row">
          <textinput
            class="input"
            width="200"
            placeholder="Clique aqui"
            value="texto"
            on_change="texto"
          />
          <textinput class="input" width="200" placeholder="Desabilitado" disabled="true" />
        </row>
      </column>

      <!-- Select: só :hover (o iced não expõe Status::Disabled p/ pick_list) -->
      <column class="stack" spacing="8">
        <text class="label">Select — hover</text>
        <select
          class="select"
          width="200"
          options="cores"
          value="cor_selecionada"
          on_change="cor_selecionada"
          placeholder="Escolha uma cor"
        />
      </column>

      <!-- Checkbox/Toggle: só o atributo `disabled` (visual padrão do tema) -->
      <column class="stack" spacing="8">
        <text class="label">Checkbox / Toggle — disabled</text>
        <row class="row">
          <checkbox label="Ativo" checked="marcado" on_toggle="marcado" />
          <checkbox
            label="Desabilitado"
            checked="marcado_travado"
            on_toggle="marcado_travado"
            disabled="true"
          />
          <toggle label="Ligado" checked="ligado" on_toggle="ligado" />
          <toggle
            label="Desabilitado"
            checked="ligado_travado"
            on_toggle="ligado_travado"
            disabled="true"
          />
        </row>
      </column>
    </column>
  </container>
</screen>
