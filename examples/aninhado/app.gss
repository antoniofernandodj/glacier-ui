/* Estilo que estava inline no markup. Os nomes são provisórios: renomeie
   cada classe pelo papel que ela tem na tela. */

.caixa {
  padding: 20;
  width: fill;
  background: #1E1E2E;
  border_radius: 16;
  border_width: 1;
  border_color: #313244;
  align_x: Center;
}
.coluna { spacing: 15; }
.titulo { size: 22; bold: true; color: #CDD6F4; }
.botao { color: #BF616A; padding: 10 20; }
.botao_2 { color: #A3BE8C; padding: 10 20; }
.caixa_2 {
  padding: 30;
  width: fill;
  height: fill;
  align_x: Center;
  align_y: Center;
}
.coluna_2 { spacing: 20; width: 360; }
.titulo_2 { size: 26; bold: true; }
.botao_3 { color: #89B4FA; width: fill; padding: 12; }

.coluna_3 { align_x: Center; }
.linha { align_y: Center; }
