<screen title="Glacier - Componentes Aninhados">
  <resources>
    <!-- O fundo da janela é do TEMA. Este painel já pintou a raiz `fill/fill`
         com uma cor que o `update` trocava, e era a camada mais cara da tela:
         um retângulo sombreado por pixel em toda a janela, redobrando o que o
         tema já pinta (ver AGENTS.md). Trocar a cor da JANELA em runtime é a
         ação builtin `style:<nome>` — sem componente nenhum envolvido; o
         exemplo `galeria_estilos` a mostra num combo. -->
    <link rel="theme" href="examples/aninhado/theme.json" />
  </resources>

  <container
    padding="30"
    width="fill"
    height="fill"
    align_x="Center"
    align_y="Center"
  >
    <column spacing="20" width="360" align="Center">
      <text size="26" bold="true" color="{cor_texto}">
        Painel (destaque {destaque})
      </text>

      <!-- Filho COM comportamento próprio. Os botões dentro de
           cartao_contador.gv são roteados para o update de CartaoContador,
           não para o do Painel. Sem <import>: o children() do Painel já
           registra o template e o comportamento do filho. -->
      <CartaoContador />

      <!-- Ação do PAI: cai em `Painel::update`, não no do filho. É a divisão
           que este exemplo existe para mostrar — os `+`/`-` do cartão abaixo
           vão para `CartaoContador::update`, esta não. -->
      <button text="Trocar destaque" on_click="trocar_destaque" color="#89B4FA" width="fill" padding="12" />
    </column>
  </container>
</screen>
