<screen title="Glacier - Condicional">
  <resources>
    <link rel="stylesheet" href="examples/gva/condicional/app.gss" />
    <!-- O fundo da janela é do TEMA, não de um `background` na raiz: pintar
      um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
      em cada pixel da tela, e ela custa (ver AGENTS.md). -->
    <link rel="theme" href="examples/gva/condicional/theme.json" />
  </resources>

  <container
    class="caixa"
  >
    <column align="Center" class="coluna">
      <text class="titulo">Demonstração de if / else</text>

      <!-- Checagem truthy: renderiza só quando {logado} for verdadeiro -->
      <if cond="{logado}">
        <column align="Center" class="coluna_2">
          <text class="texto">
            Bem-vindo de volta, {usuario}!
          </text>
          <button
            text="Sair"
            on_click="logout"
            class="botao"
          />
        </column>
      </if>
      <else>
        <column align="Center" class="coluna_2">
        <text class="texto_2">
          Você não está conectado.
        </text>
        <button
          text="Entrar"
          on_click="login"
          class="botao_2"
        />
        </column>
      </else>

      <!-- Comparação explícita -->
      <if cond="{logado}" equals="false">
        <text class="nota">
          (dica: clique em Entrar para ver o conteúdo)
        </text>
      </if>
    </column>
  </container>
</screen>
