<screen title="Glacier - ciclo de vida (monitor)">
  <resources>
    <link rel="stylesheet" href="examples/gva/ciclo_vida_luau/app.gss" />
    <link rel="theme" href="examples/gva/stream_lua/theme.json" />
    <script src="monitor.luau"></script>
  </resources>

  <container class="caixa">
    <column align="Center" class="coluna">
      <text class="titulo">Monitor</text>
      <text class="texto_2">ciclo: {ciclo}</text>

      <text class="destaque">— SSE (/sse, um tick a cada 500 ms) —</text>
      <text class="texto_2">{sse_status}</text>
      <text class="texto_3">{sse_msg}</text>

      <text class="destaque">— WebSocket (/ws, eco + tick) —</text>
      <text class="texto_2">{ws_status}</text>
      <text class="texto_3">{ws_msg}</text>
      <button on_click="enviar_ws" class="botao_2">
        Enviar ping
      </button>
      <button on_click="voltar" class="botao_3">
        Voltar (fecha os streams)
      </button>
    </column>
  </container>
</screen>
