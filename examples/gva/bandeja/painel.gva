<screen title="Glacier — Bandeja" size="460 300">
  <resources>
    <link rel="stylesheet" href="examples/gva/bandeja/app.gss" />
    <!-- O fundo da janela é do TEMA, não de um `background` na raiz: pintar
      um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
      em cada pixel da tela, e ela custa (ver AGENTS.md). -->
    <link rel="theme" href="examples/gva/bandeja/theme.json" />
  </resources>

  <container
    class="caixa"
  >
    <column align="Center" class="coluna">
      <text
        class="titulo"
      >
        Exemplo de bandeja
      </text>
      <text class="texto">
        Feche esta janela: o app continua na bandeja.
      </text>
      <text
        class="texto_2">Reabra pelo item 'Open' do menu do ícone.
      </text>

      <button
        text="Disparar notificação do SO"
        on_click="notificar"
        class="botao"
      />

      <text class="nota">
        (o toggle 'Disable/Enable notifications' na bandeja liga/desliga isto)
      </text>
    </column>
  </container>
</screen>
