<screen title="Rede: progresso" size="780 300">
  <resources>
    <link rel="stylesheet" href="examples/gva/rede_progresso/app.gss" />
    <script src="scripts/app.luau"></script>
  </resources>

  <container class="caixa">
    <column class="tela">
      <text class="titulo">Progresso de envio e recebimento</text>
      <text class="rotulo">Precisa do servidor de teste: python3 tools/servidor_rede.py (porta 8096).</text>
      <row class="botoes">
        <button text="Enviar 50 MB" on_click="enviar" />
        <button text="Enviar arquivo de 50 MB" on_click="enviar_arquivo" />
        <button text="Baixar 50 MB" on_click="baixar" />
        <button text="Cancelar" on_click="cancelar" />
      </row>
      <progressbar :value="pct" />
      <text class="valor">{estado}</text>
    </column>
  </container>
</screen>
