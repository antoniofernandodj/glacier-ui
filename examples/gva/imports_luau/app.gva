<screen title="Glacier - imports em Luau">
  <resources>
    <link rel="stylesheet" href="examples/gva/imports_luau/app.gss" />
    <!-- O fundo da janela é do TEMA, não de um `background` na raiz: pintar
      um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
      em cada pixel da tela, e ela custa (ver AGENTS.md). -->
    <link rel="theme" href="examples/gva/imports_luau/theme.json" />
    <script src="script.luau"></script>
  </resources>

  <container
    class="caixa"
  >
    <column class="coluna coluna_2">
      <text class="titulo">
        imports em Lua (require de bibliotecas)
      </text>
      <text class="texto">
        a lógica de rede mora em net/http_client.luau
      </text>
      <button
        text="Buscar meu IP"
        on_click="buscar"
        class="botao"
      />
      <button
        text="ola mundo!"
        on_click="ola_mundo"
        class="botao"
      />
      <text class="texto_2">
        Status: {status}
      </text>
      <text class="texto_3">
        {resultado}
      </text>
    </column>
  </container>
</screen>
