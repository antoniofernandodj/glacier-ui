<screen title="Webview" size="360 160" min_size="320 140">
  <resources>
    <link rel="stylesheet" href="examples/gva/webview/app.gss" />
    <link rel="theme" href="examples/gva/webview/theme.json" />
  </resources>

  <container
    class="caixa"
  >
    <column class="coluna">
      <text class="destaque">
        Webview nativa
      </text>
      <button
        text="Abrir webview numa janela"
        on_click="abrir"
        class="botao"
      />
    </column>
  </container>
</screen>
