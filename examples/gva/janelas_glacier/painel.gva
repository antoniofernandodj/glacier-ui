<screen title="Glacier - Janela principal" size="520 400">
  <resources>
    <link rel="stylesheet" href="examples/gva/janelas_glacier/app.gss" />
    <!-- O fundo da janela é do TEMA, não de um `background` na raiz: pintar
      um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
      em cada pixel da tela, e ela custa (ver AGENTS.md). -->
    <link rel="theme" href="examples/gva/janelas_glacier/theme_painel.json" />
  </resources>

  <container
    class="caixa"
  >
    <column align="Center" class="coluna_2">
      <text class="titulo_2">
        Painel (Rust)
      </text>
      <text class="texto_3">
        Contador desta janela: {valor}
      </text>
      <text class="texto_4">
        Broadcasts recebidos: {recebidos}
      </text>

      <button
        text="Incrementar"
        on_click="incrementar"
        class="botao_4"
      />

      <text class="texto_5">
        Abrir nova janela:
      </text>
      <row align="Center" class="linha">
        <button
          text="Component Rust"
          on_click="nova_rust"
          class="botao_5"
        />
        <button
          text="XML (Lua)"
          on_click="nova_xml"
          class="botao_6"
        />
      </row>
    </column>
  </container>
</screen>
