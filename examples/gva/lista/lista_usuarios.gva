<screen title="Glacier - Lista de Membros">
  <resources>
    <link rel="stylesheet" href="examples/gva/lista/app.gss" />
    <!-- O fundo da janela é do TEMA, não de um `background` na raiz: pintar
         um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
         em cada pixel da tela, e ela custa (ver AGENTS.md). -->
    <link rel="theme" href="examples/gva/lista/theme.json" />
    <import name="CartaoUsuario" from="examples/gva/lista/cartao_usuario.gva" />
  </resources>

  <container class="caixa_3">
    <column align="Center" class="coluna_2">
      <text class="titulo_3">Equipe ({total})</text>

      <!-- O componente CartaoUsuario é instanciado uma vez por item do loop,
         recebendo os campos de cada item como props. -->
      <column class="coluna_3">
        <foreach items="usuarios" var="u">
          <CartaoUsuario
            nome="{u.nome}"
            cargo="{u.cargo}"
            inicial="{u.inicial}"
            cor="{u.cor}"
          />
        </foreach>
      </column>

      <button
        text="Adicionar membro"
        on_click="adicionar"
        class="botao"
      />
    </column>
  </container>
</screen>
