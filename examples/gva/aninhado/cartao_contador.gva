<!-- Um componente (filho de `painel.gva`), não uma tela: a raiz é `<component>`.
 Ele agrupa declarações como o `<screen title="Glacier - Componentes Aninhados">` de uma janela, mas não aceita
 `title`/`size` — não há janela nenhuma a que eles se aplicariam. Aqui não há o
 que declarar, então a casca entra sozinha, sem `<resources>
   <link rel="stylesheet" href="examples/gva/aninhado/app.gss" />
   <link rel="stylesheet" href="examples/gva/aninhado/app.gss" />`. -->
<component>
  <container
    class="caixa"
  >
    <column class="coluna coluna_3">
      <text class="titulo">
        Contador: {valor}
      </text>
      <row class="coluna linha">
        <button
          text="-"
          on_click="decrementar"
          class="botao"
        />
        <button
          text="+"
          on_click="incrementar"
          class="botao_2"
        />
      </row>
    </column>
  </container>
</component>
