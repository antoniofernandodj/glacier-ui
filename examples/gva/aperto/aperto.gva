<screen title="Glacier - Aperto">
  <resources>
    <link rel="stylesheet" href="examples/gva/aperto/app.gss" />
    <link rel="theme" href="examples/gva/aperto/theme.json" />
  </resources>
  <column spacing="14" padding="10">
    <row spacing="10">
      <column width="fill"><text size="30" bold="true">Deployments</text><text>Real-time status of services in the cluster.</text></column>
      <button text="Limpar parados/falhas" on_click="x" />
    </row>
    <row spacing="10">
      <text>Real-time status of services in the cluster.</text>
      <button text="Stop All" on_click="x" />
    </row>
    <row spacing="10">
      <input width="110" placeholder="Search deployments, nodes…" :value="v" on_change="x" />
      <button text="Disconnect" on_click="x" />
    </row>
    <textarea width="70" height="60" placeholder="Descrição do serviço aqui" :value="v" on_change="x" />
  </column>
</screen>
