<screen title="Glacier - Contador (script Lua externo)">
  <resources>
    <link rel="stylesheet" href="examples/gva/contador_externo/app.gss" />
    <!-- O fundo da janela é do TEMA, não de um `background` na raiz: pintar
      um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
      em cada pixel da tela, e ela custa (ver AGENTS.md). -->
    <link rel="theme" href="examples/gva/contador_externo/theme.json" />
    <!-- Comportamento em Lua, num arquivo separado (resolvido relativo a este template). -->
    <script src="contador_externo.luau"></script>
  </resources>

  <container
    class="caixa"
  >
    <column class="coluna coluna_2">
      <text class="titulo">
        Valor do Contador: {contador}
      </text>
      <row class="linha linha_3">
        <text class="texto">Passo:</text>
        <input
          :value="passo"
          placeholder="1"
          on_change="definir_passo"
          class="campo"
        />
      </row>
      <row class="linha_2 linha_3">
        <button
          text="Diminuir"
          on_click="decrementar"
          class="botao"
        />
        <button
          text="Zerar"
          on_click="zerar"
          class="botao_2"
        />
        <button
          text="Aumentar"
          on_click="incrementar"
          class="botao_3"
        />
      </row>
    </column>
  </container>
</screen>
