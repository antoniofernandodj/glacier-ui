<screen title="Glacier - Formulário (Reactive Forms)">
  <resources>
    <link rel="stylesheet" href="examples/gva/formulario_login/app.gss" />
    <!-- O fundo da janela é do TEMA, não de um `background` na raiz: pintar
         um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
         em cada pixel da tela, e ela custa (ver AGENTS.md). -->
    <link rel="theme" href="examples/gva/formulario_login/theme.json" />
  </resources>

  <!-- Formulário de login: `Form` agrupa os `TextInput`s ligados aos
     `FormControl`s do componente (por `formControl`, veja formulario_login.rs).
     Enter em qualquer campo sempre dispara `onSubmit`; se houver um próximo
     campo, o foco também avança para ele — dá para preencher e submeter o
     formulário inteiro sem tocar no mouse. -->
  <container class="caixa">
    <column class="coluna">
      <text class="titulo">Entrar</text>
      <form on_submit="entrar" name="login" class="formulario">
        <column class="coluna_2">
          <text class="texto">Usuário</text>
          <input
            form_control="username"
            placeholder="ao menos 3 caracteres"
            class="formulario"
          />
          <text class="nota">
            {erro_username}
          </text>
        </column>
        <column class="coluna_2">
          <text class="texto">Senha</text>
          <input
            form_control="password"
            placeholder="ao menos 6 caracteres"
            secure="true"
            class="formulario"
          />
          <text class="nota">
            {erro_password}
          </text>
        </column>
        <button
          text="Entrar"
          on_click="entrar"
          class="botao"
        />
      </form>
      <text class="texto_2">{status}</text>
    </column>
  </container>
</screen>
