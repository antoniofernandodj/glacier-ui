<component>
  <resources>
    <link rel="stylesheet" href="examples/gva/perfil/app.gss" />
  </resources>
 <container
  class="caixa_3"
 >
  <column align="Center" class="coluna_2">
   <image source="examples/gva/perfil/avatar.png" width="100" height="100" clip="Circle" />

   <column align="Center" class="coluna_3">
    <text class="titulo_2">{user_name}</text>
    <text class="texto">{user_role}</text>
   </column>

   <button
    text="{texto_botao}"
    on_click="seguir_usuario"
    color="{btn_color}"
    class="botao_3"
   />
  </column>
 </container>
</component>
