<screen title="Glacier - Painel de Perfil">
  <resources>
    <link rel="stylesheet" href="examples/gva/perfil/app.gss" />
    <!-- O fundo da janela é do TEMA, não de um `background` na raiz: pintar
         um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
         em cada pixel da tela, e ela custa (ver AGENTS.md). -->
    <link rel="theme" href="examples/gva/perfil/theme.json" />
    <import name="PerfilCard" from="examples/gva/perfil/perfil_card.gva" />
  </resources>

  <container
    class="caixa"
  >
    <column align="Center" class="coluna">
      <text class="titulo">
        Painel de Controle de Usuário
      </text>

      <row align="Center" class="linha">
        <!-- Left control panel -->
        <container
          class="caixa_2"
        >
          <column class="coluna_2">
            <text class="destaque">
              Editar Nome:
            </text>
            <input
              placeholder="Digite o nome..."
              :value="user_name"
              on_change="mudar_nome"
              class="campo"
            />

            <text class="destaque">
              Editar Cargo:
            </text>
            <input
              placeholder="Digite o cargo..."
              :value="user_role"
              on_change="mudar_cargo"
              class="campo"
            />

            <text class="destaque">
              Atalhos de Cargo:
            </text>
            <row class="linha_2">
              <button
                text="Desenvolvedora"
                on_click="set_dev"
                class="botao"
              />
              <button
                text="Designer"
                on_click="set_designer"
                class="botao_2"
              />
            </row>
          </column>
        </container>

        <!-- Right preview card -->
        <PerfilCard />
      </row>
    </column>
  </container>
</screen>
