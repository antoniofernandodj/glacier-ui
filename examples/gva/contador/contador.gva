<screen title="Glacier - Contador">
  <resources>
    <link rel="stylesheet" href="examples/gva/contador/app.gss" />
    <!-- O fundo da janela é do TEMA, não de um `background` na raiz: pintar
      um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
      em cada pixel da tela, e ela custa (ver AGENTS.md). -->
    <link rel="theme" href="examples/gva/contador/theme.json" />
  </resources>

  <container
    class="caixa"
  >
    <column align="Center" class="coluna">
      <text
        class="titulo"
      >Valor do Contador: {contador}</text>
      <row align="Center" class="linha">
        <button
          text="Diminuir"
          on_click="decrementar"
          class="botao"
        />
        <button
          text="Aumentar"
          on_click="incrementar"
          class="botao_2"
        />
      </row>
    </column>
  </container>
</screen>
