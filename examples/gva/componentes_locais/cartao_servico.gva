<component>
  <!-- Um componente de ARQUIVO. Repare que este arquivo e o bloco
    `<component name="LinhaLog">` do app.gva têm exatamente a mesma forma:
    <component>, <props>, layout. A única diferença é o `name` — aqui o nome
    vem do <import> que o traz; lá ele precisa ser dito.

    É o que torna a promoção reversível: recortar este arquivo para dentro do
    <resources>
      <link rel="stylesheet" href="examples/gva/componentes_locais/app.gss" /> (ou o contrário) não pede uma linha de reescrita. Este arquivo
    existe no exemplo para você poder comparar os dois lado a lado. -->
  <props>
    <prop name="id" />
    <prop name="nome" />
    <prop name="estado" />
    <prop name="cor" />
    <prop name="uptime" default="—" />
  </props>

  <card title="{nome}" subtitle="uptime {uptime}" class="cartao">
    <badge badge_text="{estado}" badge_bg="{cor}" />
    <template slot="footer">
      <row class="linha_4">
        <button text="Detalhes" on_click="detalhar:{id}" class="botao" />
        <button text="Reiniciar" on_click="reiniciar:{id}" class="botao" />
      </row>
    </template>
  </card>
</component>
