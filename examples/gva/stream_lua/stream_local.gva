<screen title="Glacier - SSE + WebSocket em Lua (local)">
  <resources>
    <link rel="stylesheet" href="examples/gva/stream_lua/app.gss" />
    <!-- O fundo da janela é do TEMA, não de um `background` na raiz: pintar
         um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
         em cada pixel da tela, e ela custa (ver AGENTS.md). -->
    <link rel="theme" href="examples/gva/stream_lua/theme.json" />
    <script src="stream_local.luau"></script>
  </resources>

  <container
    class="caixa"
  >
    <column class="coluna coluna_3">
      <text class="titulo">
        SSE + WebSocket em Lua → API Python (localhost:8000)
      </text>

      <text class="destaque">
        — Server-Sent Events (/sse) —
      </text>
      <row class="linha linha_2">
        <button
          text="Abrir SSE"
          on_click="abrir_sse"
          class="botao"
        />
        <button
          text="Fechar SSE"
          on_click="fechar_sse"
          class="botao_2"
        />
      </row>
      <text class="texto">
        SSE: {sse_status}
      </text>
      <text class="texto_2">
        {sse_msg}
      </text>

      <text class="destaque">
        — WebSocket echo (/ws) —
      </text>
      <row class="linha linha_2">
        <button
          text="Conectar"
          on_click="abrir_ws"
          class="botao"
        />
        <button
          text="Enviar ping"
          on_click="enviar_ws"
          class="botao_3"
        />
        <button
          text="Fechar"
          on_click="fechar_ws"
          class="botao_2"
        />
      </row>
      <text class="texto">
        WS: {ws_status}
      </text>
      <text class="texto_2">
        {ws_msg}
      </text>
    </column>
  </container>
</screen>
