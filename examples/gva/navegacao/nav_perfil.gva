<screen title="Glacier - Navegação · Perfil">
 <resources>
   <link rel="stylesheet" href="examples/gva/navegacao/app.gss" />
  <!-- O fundo da janela é do TEMA, não de um `background` na raiz: pintar
    um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
    em cada pixel da tela, e ela custa (ver AGENTS.md). -->
  <link rel="theme" href="examples/gva/navegacao/theme.json" />
 </resources>

 <container
  class="caixa"
 >
  <column class="coluna coluna_5">
   <text class="titulo">Perfil</text>

   <container
    class="caixa_2"
   >
    <column class="coluna_4 coluna_5">
     <!-- Lê o mesmo estado compartilhado editado na tela de Configurações -->
     <text class="titulo_2">{user_name}</text>
     <text class="texto_2">{user_role}</text>
    </column>
   </container>

   <!-- navigate_back volta para a tela anterior do histórico -->
   <button text="Voltar" navigate_back="true" class="botao_5" />
  </column>
 </container>
</screen>
