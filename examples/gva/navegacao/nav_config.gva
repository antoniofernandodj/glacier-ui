<screen title="Glacier - Navegação · Configurações">
  <resources>
    <link rel="stylesheet" href="examples/gva/navegacao/app.gss" />
    <!-- O fundo da janela é do TEMA, não de um `background` na raiz: pintar
      um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
      em cada pixel da tela, e ela custa (ver AGENTS.md). -->
    <link rel="theme" href="examples/gva/navegacao/theme.json" />
  </resources>

  <container
    class="caixa"
  >
    <column align="Center" class="coluna">
      <text class="titulo">
        Configurações
      </text>

      <column class="coluna_2">
        <text class="destaque">
          Nome de exibição
        </text>
        <input
          placeholder="Seu nome..."
          :value="user_name"
          on_change="mudar_nome"
          class="campo"
        />
      </column>

      <!--
        Navegar para outra tela mantém o estado; o nome editado aparece no perfil
      -->
      <button
        text="Ver perfil"
        navigate_to="perfil"
        class="botao"
      />
      <button
        text="Voltar"
        navigate_back="true"
        class="botao_2"
      />
    </column>
  </container>
</screen>
