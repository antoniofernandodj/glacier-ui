<screen title="Glacier - ComboEdit (servidores salvos)">
  <resources>
    <link rel="stylesheet" href="examples/gva/combo_edit/app.gss" />
    <!-- O fundo da janela é do TEMA, não de um `background` na raiz: pintar
         um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
         em cada pixel da tela, e ela custa (ver AGENTS.md). -->
    <link rel="theme" href="examples/gva/combo_edit/theme.json" />
  </resources>

  <!-- `<comboedit>`: dropdown editável (combo_box do iced). Digite um servidor
     novo à vontade, ou escolha um dos já salvos na lista — escolher um
     preenche o token sozinho (veja `servidor_selecionado` em main.rs). -->
  <container class="caixa">
    <column class="coluna">
      <text class="titulo">
        Servidores salvos
      </text>

      <column class="coluna_2">
        <text class="texto">
          Servidor
        </text>
        <comboedit
          :options="servidores"
          :value="url"
          placeholder="https://servidor.exemplo.com"
          on_change="url_changed"
          on_select="servidor_selecionado"
          width="fill"
        />
      </column>

      <column class="coluna_2">
        <text class="texto">Token</text>
        <input
          :value="token"
          on_change="token_changed"
          placeholder="token de acesso"
          secure="true"
          class="campo"
        />
      </column>

      <button
        text="Salvar este par"
        on_click="salvar"
        class="botao"
      />

      <rule />

      <text class="texto">
        Pares salvos:
      </text>
      <text class="nota">
        {pares_txt}
      </text>
    </column>
  </container>
</screen>
