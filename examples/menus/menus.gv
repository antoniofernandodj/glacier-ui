<screen title="Glacier - Menus">
  <resources>
    <!-- O fundo da janela é do TEMA, não de um `background` numa classe
         `fill/fill`: pintar a tela inteira com a cor que o tema já pinta é
         uma camada a mais em cada pixel, e ela custa (ver AGENTS.md). -->
    <link rel="theme" href="examples/menus/theme.json" />

    <!-- Menu bar ancorada (File/Edit) + dois menus de contexto (botão direito):
       um com submenu estático de 3 níveis (prova profundidade arbitrária) e
       outro cujo conteúdo vem de ctx.dynamic_menu (JSON populado pelo script
       Lua abaixo, mesma convenção do atributo options de um Select). Ver
       src/menu.rs. -->
    <style>
    .bar      { background: #2E3440; padding: 4; }
    .screen   { width: fill; height: fill; }
    .content  { spacing: 20; padding: 30; }
    .card     { background: #434C5E; width: 260; height: 110; padding: 14; border-radius: 8; }
    .cards    { spacing: 20; }
    .hint     { color: #D8DEE9; size: 13; }
    .title    { color: #ECEFF4; size: 20; bold: true; }
    .divider  { width: 560; }
    .result   { color: #A3BE8C; size: 14; }
    </style>

    <script>
      -- Lua behavior, interpreted at runtime. ctx.dynamic_menu segue a mesma
      -- convenção do options de um Select: um array JSON, aqui com action/items
      -- aninhado para submenu.
      function init()
        ctx.resultado="(nenhum ainda)"
        ctx.dynamic_menu = {
          { label="Item dinâmico 1", action="dyn_item_1" },
          {
            label="Item dinâmico 2 (submenu)",
            items = {
              { label="Sub-dinâmico A", action="dyn_sub_a" },
              { label="Sub-dinâmico B", action="dyn_sub_b" },
            },
          },
          { separator = true },
          { label="Item desabilitado", action="dyn_disabled", disabled = true },
        }
      end

      function novo() ctx.resultado="Arquivo > Novo" end
      function abrir() ctx.resultado="Arquivo > Abrir" end
      function abrir_recente(id) ctx.resultado="Arquivo > Recentes > " .. id end
      function sair() ctx.resultado="Arquivo > Sair" end
      function recortar() ctx.resultado="Editar > Recortar" end
      function copiar() ctx.resultado="Editar > Copiar" end
      function colar() ctx.resultado="Editar > Colar" end

      function acao_nivel1() ctx.resultado="Nível 1 clicado" end
      function acao_nivel2() ctx.resultado="Nível 1 > Nível 2 clicado" end
      function acao_nivel3() ctx.resultado="Nível 1 > Nível 2 > Nível 3 (folha) clicado" end
      function acao_direta() ctx.resultado="Ação direta (fora dos submenus)" end

      function dyn_item_1() ctx.resultado="Dinâmico: Item 1" end
      function dyn_sub_a() ctx.resultado="Dinâmico: Item 2 > Sub A" end
      function dyn_sub_b() ctx.resultado="Dinâmico: Item 2 > Sub B" end
      function dyn_disabled() ctx.resultado="(não deveria disparar — item desabilitado)" end
    </script>
  </resources>

  <column class="screen">
    <row class="bar">
      <menubar>
        <menu label="Arquivo">
          <menuitem label="Novo" on_click="novo" />
          <menuitem label="Abrir" on_click="abrir" />
          <menu label="Recentes">
            <menuitem label="projeto-a.gv" on_click="abrir_recente:a" />
            <menuitem label="projeto-b.gv" on_click="abrir_recente:b" />
            <menuitem label="projeto-c.gv" on_click="abrir_recente:c" />
          </menu>
          <menuseparator />
          <menuitem label="Sair" on_click="sair" />
        </menu>
        <menu label="Editar">
          <menuitem label="Recortar" on_click="recortar" />
          <menuitem label="Copiar" on_click="copiar" />
          <menuitem label="Colar" on_click="colar" />
        </menu>
      </menubar>
    </row>

    <column class="content">
      <text class="title">
        Menus (MenuBar ancorada + ContextMenu, com submenus)
      </text>
      <text class="hint">
        Use os menus 'Arquivo'/'Editar' acima, ou clique com o botão direito nos cartões abaixo.
      </text>

      <row class="cards">
        <contextmenu>
          <container class="card">
            <text class="hint">
              Botão direito: submenu estático de 3 níveis
            </text>
          </container>
          <menu label="Nível 1">
            <menuitem label="Ação A1" on_click="acao_nivel1" />
            <menu label="Nível 2">
              <menuitem label="Ação A2" on_click="acao_nivel2" />
              <menu label="Nível 3">
                <menuitem label="Ação A3 (folha)" on_click="acao_nivel3" />
              </menu>
            </menu>
          </menu>
          <menuseparator />
          <menuitem label="Ação direta" on_click="acao_direta" />
        </contextmenu>

        <contextmenu items="dynamic_menu">
          <container class="card">
            <text class="hint">
              Botão direito: menu dinâmico (Lua/ctx.dynamic_menu)
            </text>
          </container>
        </contextmenu>
      </row>

      <rule class="divider" />
      <text class="result">Último resultado: {resultado}</text>
    </column>
  </column>
</screen>
