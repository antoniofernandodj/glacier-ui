<screen title="Glacier - Onda 1" size="900 700">
    <column spacing="0" width="fill" height="fill" background="#1E1E2E">

        <!-- A StatusBar e o GroupBox são da onda 2; as duas ondas compõem sem
             nada de especial: o conteúdo de um slot pode ser qualquer widget,
             embutido ou não. -->
        <toolbar divider="true">
            <text content="Onda 1 — Slider, Space, Radio e Avatar" size="14" bold="true" color="#CDD6F4" />
            <!-- 2. Space: aqui é o espaçador FLEXÍVEL. Sem width, ele é
                 Length::Fill e come toda a sobra, empurrando o avatar para a
                 borda direita. É o QSpacerItem de um QHBoxLayout. -->
            <space />
            <avatar initials="AF" size="28" bg="#89B4FA" fg="#11111B" />
        </toolbar>

        <scrollable width="fill" height="fill">
            <column padding="24" spacing="20" width="fill">

                <!-- 1. Slider =============================================== -->
                <groupbox title="Slider — o QSlider">
                    <text
                        content="Primitiva: dispara onChange com o valor novo, e quem grava a chave é o update da tela. Sem esse handler, o cursor não sairia do lugar."
                        size="13"
                        color="#A6ADC8"
                    />

                    <row spacing="16" align_y="center">
                        <text content="Volume" width="90" color="#CDD6F4" />
                        <slider value="volume" min="0" max="100" onChange="ajustar_volume" width="320" />
                        <text content="{volume}" size="13" color="#A6ADC8" />
                    </row>

                    <!-- Passo fracionário: as casas decimais da saída saem do
                         próprio step ("0.05" -> 2 casas), então a chave nunca
                         recebe 0.6000000238418579. -->
                    <row spacing="16" align_y="center">
                        <text content="Brilho" width="90" color="#CDD6F4" />
                        <slider
                            value="brilho"
                            min="0"
                            max="1"
                            step="0.05"
                            onChange="ajustar_brilho"
                            width="320"
                            color="#A6E3A1"
                        />
                        <text content="{brilho}" size="13" color="#A6ADC8" />
                    </row>

                    <!-- default: clique duplo devolve o cursor ao valor neutro.
                         on_release: a ação só dispara ao SOLTAR, para quem não
                         quer um efeito colateral por pixel arrastado. -->
                    <row spacing="16" align_y="center">
                        <text content="Graves" width="90" color="#CDD6F4" />
                        <slider
                            value="graves"
                            min="-10"
                            max="10"
                            default="0"
                            onChange="ajustar_graves"
                            width="320"
                        />
                        <text content="{graves} dB (duplo clique volta a 0)" size="13" color="#A6ADC8" />
                    </row>
                </groupbox>

                <!-- Slider + SpinBox na MESMA chave: o par do Qt. O SpinBox
                     grava sozinho (é builtin, tem update); o Slider grava pelo
                     handler da tela. Os dois leem e escrevem "zoom", então
                     andam juntos. -->
                <groupbox title="Slider + SpinBox na mesma chave" flat="true">
                    <row spacing="16" align_y="center">
                        <text content="Zoom (%)" width="90" color="#CDD6F4" />
                        <slider value="zoom" min="25" max="400" step="25" onChange="ajustar_zoom" width="260" />
                        <spinbox value="zoom" min="25" max="400" step="25" width="80" />
                        <text content="{zoom}%" size="13" color="#A6ADC8" />
                    </row>

                    <row spacing="16" align_y="center">
                        <text content="Vertical" width="90" color="#CDD6F4" />
                        <slider value="volume" min="0" max="100" vertical="true" onChange="ajustar_volume" height="120" />
                        <text content="o mesmo 'volume' do grupo acima, no vertical_slider" size="13" color="#A6ADC8" />
                    </row>
                </groupbox>

                <!-- 3. Radio / RadioGroup ==================================== -->
                <groupbox title="Radio e RadioGroup — o QRadioButton e o QButtonGroup">
                    <text
                        content="Os dois caminhos escrevendo na MESMA chave 'plano'. O grupo é a chave, não um nó pai: todo Radio que aponta para o mesmo valor é do mesmo grupo."
                        size="13"
                        color="#A6ADC8"
                    />

                    <row spacing="40" align_y="start">
                        <column spacing="8">
                            <text content="Primitiva, escrita à mão:" size="13" bold="true" color="#CDD6F4" />
                            <radio label="Grátis" value="free" group="plano" onChange="escolher_plano" />
                            <radio label="Pro" value="pro" group="plano" onChange="escolher_plano" />
                            <radio label="Time" value="team" group="plano" onChange="escolher_plano" />
                            <text content="+ 1 braço no update da tela" size="12" color="#6C7086" />
                        </column>

                        <column spacing="8">
                            <text content="Builtin, de uma coleção:" size="13" bold="true" color="#CDD6F4" />
                            <radiogroup value="plano" items="planos" />
                            <text content="nenhum handler no app" size="12" color="#6C7086" />
                        </column>

                        <column spacing="8">
                            <text content="O mesmo builtin, deitado:" size="13" bold="true" color="#CDD6F4" />
                            <radiogroup value="plano" items="planos" layout="row" />
                            <text content="plano escolhido: {plano}" size="13" color="#A6ADC8" />
                        </column>
                    </row>
                </groupbox>

                <!-- 4. Avatar ================================================ -->
                <groupbox title="Avatar">
                    <text
                        content="Sempre ocupa o mesmo espaço, com foto ou sem: numa lista de usuários a foto que falta é o caso comum, e um buraco vazio quebraria o alinhamento da linha."
                        size="13"
                        color="#A6ADC8"
                    />
                    <row spacing="16" align_y="center">
                        <avatar src="examples/perfil/avatar.png" size="56" />
                        <avatar initials="AF" size="56" />
                        <avatar initials="MS" size="56" bg="#A6E3A1" fg="#11111B" />
                        <avatar size="56" />
                        <text content="foto · iniciais · cores por instância · sem nada (o '?')" size="13" color="#A6ADC8" />
                    </row>
                </groupbox>

                <!-- 2. Space (fixo) ========================================== -->
                <groupbox title="Space — o QSpacerItem" flat="true">
                    <text
                        content="Sem width/height é Length::Fill nos dois eixos (o espaçador flexível, como no topo desta janela); com eles, vira um vão fixo."
                        size="13"
                        color="#A6ADC8"
                    />
                    <row align_y="center">
                        <text content="esquerda" color="#CDD6F4" />
                        <space />
                        <text content="centro (empurrado por dois Space fill)" color="#CDD6F4" />
                        <space />
                        <text content="direita" color="#CDD6F4" />
                    </row>
                    <row align_y="center">
                        <text content="a" color="#CDD6F4" />
                        <space width="80" />
                        <text content="b (80px fixos entre nós)" color="#CDD6F4" />
                    </row>
                </groupbox>

            </column>
        </scrollable>

        <statusbar message="volume {volume} · brilho {brilho} · zoom {zoom}% · plano {plano}">
            <badge badge_text="onda 1" badge_bg="#A6E3A1" badge_size="11" />
        </statusbar>
    </column>
</screen>
