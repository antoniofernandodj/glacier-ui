<screen title="Glacier — console (Luau)" size="720 520" min_size="620 440">
  <resources>
    <link rel="stylesheet" href="examples/console_luau/app.gss" />
    <script src="scripts/app.luau"></script>
  </resources>

  <column class="tela">
    <row class="barra">
      <text class="titulo">console.* — olhe o terminal</text>
    </row>

    <column class="corpo">
      <text class="lead">
        `console.log` / `.info` / `.warn` / `.error` / `.debug` / `.table`
        escrevem no stdout do processo, com cor, glifo, rótulo e hora. O
        nível e a cor são ajustáveis por `console.config` / `console.set_level`.
      </text>

      <row class="acoes">
        <button text="log de cada nível" on_click="log_tudo" />
        <button text="console.table" on_click="mostrar_tabela" />
      </row>

      <column class="bloco">
        <text class="secao">config ao vivo</text>
        <row class="acoes">
          <button text="ciclar nível" on_click="ciclar_nivel" />
          <button text="alternar cor" on_click="alternar_cor" />
        </row>
        <text class="estado">nível: {nivel}   ·   cor: {cor}</text>
      </column>
    </column>
  </column>
</screen>
