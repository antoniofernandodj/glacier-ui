screen {
  resources {
    script """
      function salvar()
        ctx.resultado = ctx["__dialog.nome"] or "VAZIO"
      end
    """

    dialog(
      name = editar, title = Editar
    ) {
      column {
        textinput(:value = __dialog.nome, on_change = __dialog.nome)
      }

      actions {
        button("Cancelar")
        button("Salvar", on_click = salvar)
      }
    }
  }

  button(text = abrir, on_click = dialog:editar)
}
