component {
  resources {
    script(src = onda8b_buga_comp.luau)

    dialog(
      name = dlg_do_comp, title = X
    ) {
      column {
        textinput(:value = __dialog.v, on_change = __dialog.v)
      }

      actions {
        button("Cancelar")
        button("Salvar", on_click = CompX::salvar)
      }
    }
  }

  button(text = editar, on_click = dialog:dlg_do_comp)
}
