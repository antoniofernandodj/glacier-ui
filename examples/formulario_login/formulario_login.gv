<screen title="Glacier - Formulário (Reactive Forms)">
  <!-- Formulário de login: `Form` agrupa os `TextInput`s ligados aos
     `FormControl`s do componente (por `formControl`, veja formulario_login.rs).
     Enter em qualquer campo sempre dispara `onSubmit`; se houver um próximo
     campo, o foco também avança para ele — dá para preencher e submeter o
     formulário inteiro sem tocar no mouse. -->
  <container padding="24" width="fill" height="fill" background="#2E3440">
    <column spacing="16" width="360">
      <text size="24" bold="true" color="#ECEFF4">Entrar</text>
      <form on_submit="entrar" name="login" width="fill">
        <column spacing="6" width="fill">
          <text size="13" color="#D8DEE9">Usuário</text>
          <input form_control="username" placeholder="ao menos 3 caracteres" width="fill" />
          <text size="12" color="#BF616A">{erro_username}</text>
        </column>
        <column spacing="6" width="fill">
          <text size="13" color="#D8DEE9">Senha</text>
          <input
            form_control="password"
            placeholder="ao menos 6 caracteres"
            secure="true"
            width="fill"
          />
          <text size="12" color="#BF616A">{erro_password}</text>
        </column>
        <button text="Entrar" on_click="entrar" color="#5E81AC" width="fill" />
      </form>
      <text size="13" color="#A3BE8C">{status}</text>
    </column>
  </container>
</screen>
