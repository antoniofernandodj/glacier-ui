<screen title="Glacier — Onda 12 (dock, Luau)" size="1040 740" min_size="880 600">
  <resources>
    <link rel="stylesheet" href="examples/dock_luau/app.gss" />
    <script src="scripts/app.luau"></script>
  </resources>

  <column class="tela">
    <row class="barra">
      <text class="titulo">Onda 12 em Luau — dock</text>
      <space class="empurra" />
      <text class="status">{status}</text>
    </row>

    <row class="atalhos">
      <text class="rotulo">acoplar:</text>
      <button text="esq" on_click="mover_dock:left" />
      <button text="dir" on_click="mover_dock:right" />
      <button text="topo" on_click="mover_dock:top" />
      <button text="base" on_click="mover_dock:bottom" />
      <button text="flutuar" on_click="mover_dock:float" />
      <space class="empurra" />
      <text class="dica">…ou arraste a faixa de título para uma borda.</text>
    </row>

    <dock
      mode="lado"
      edge="left"
      size="tam_painel"
      float_x="painel_x"
      float_y="painel_y"
      title="Camadas"
      class="area"
    >
      <column class="painel-corpo">
        <listview items="camadas" value="camada" selected="{camada}" height="fill" />
      </column>

      <column class="centro">
        <text class="secao">camada ativa: {camada}</text>
        <texteditor value="notas" class="editor" />
      </column>
    </dock>
  </column>
</screen>
