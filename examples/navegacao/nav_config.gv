<screen title="Glacier - Navegação · Configurações">
  <resources>
    <!-- O fundo da janela é do TEMA, não de um `background` na raiz: pintar
         um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
         em cada pixel da tela, e ela custa (ver AGENTS.md). -->
    <link rel="theme" href="examples/navegacao/theme.json" />
  </resources>

  <container
    padding="40"
    width="fill"
    height="fill"
    align_x="Center"
    align_y="Center"
  >
    <column spacing="18" align="Center">
      <text size="32" bold="true" color="#F5E0DC">Configurações</text>

      <column spacing="8" width="320">
        <text size="14" bold="true" color="#A6ADC8">Nome de exibição</text>
        <input
          placeholder="Seu nome..."
          value="user_name"
          on_change="mudar_nome"
          width="fill"
          padding="10"
        />
      </column>

      <!-- Navegar para outra tela mantém o estado; o nome editado aparece no perfil -->
      <button text="Ver perfil" navigate_to="perfil" color="#89B4FA" width="320" padding="12" />
      <button text="Voltar" navigate_back="true" color="#313244" width="320" padding="12" />
    </column>
  </container>
</screen>
