<screen title="Glacier - Navegação · Início">
  <resources>
    <!-- O fundo da janela é do TEMA, não de um `background` na raiz: pintar
         um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
         em cada pixel da tela, e ela custa (ver AGENTS.md). -->
    <link rel="theme" href="examples/navegacao/theme.json" />
  </resources>

  <container
    padding="40"
    width="fill"
    height="fill"
    align_x="Center"
    align_y="Center"
  >
    <column spacing="20" align="Center">
      <text size="32" bold="true" color="#F5E0DC">Início</text>
      <text size="16" color="#A6ADC8">Bem-vinda, {user_name}</text>

      <!-- navigate_to empilha a tela atual e troca para o destino -->
      <button text="Ver perfil" navigate_to="perfil" color="#89B4FA" width="240" padding="12" />
      <button text="Configurações" navigate_to="config" color="#CBA6F7" width="240" padding="12" />
    </column>
  </container>
</screen>
