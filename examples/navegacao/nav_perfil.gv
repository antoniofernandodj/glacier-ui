<screen title="Glacier - Navegação · Perfil">
  <resources>
    <!-- O fundo da janela é do TEMA, não de um `background` na raiz: pintar
         um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
         em cada pixel da tela, e ela custa (ver AGENTS.md). -->
    <link rel="theme" href="examples/navegacao/theme.json" />
  </resources>

  <container
    padding="40"
    width="fill"
    height="fill"
    align_x="Center"
    align_y="Center"
  >
    <column spacing="18" align="Center">
      <text size="32" bold="true" color="#F5E0DC">Perfil</text>

      <container
        padding="24"
        width="320"
        background="#181825"
        border_radius="16"
        border_width="1"
        border_color="#313244"
        align_x="Center"
      >
        <column spacing="8" align="Center">
          <!-- Lê o mesmo estado compartilhado editado na tela de Configurações -->
          <text size="22" bold="true" color="#CDD6F4">{user_name}</text>
          <text size="14" color="#A6ADC8">{user_role}</text>
        </column>
      </container>

      <!-- navigate_back volta para a tela anterior do histórico -->
      <button text="Voltar" navigate_back="true" color="#313244" width="240" padding="12" />
    </column>
  </container>
</screen>
