<Container padding="28" width="fill" height="fill" background="#0D1117">
    <Column spacing="16">
        <Text content="Controle externo" size="24" bold="true" color="#58A6FF" />
        <Text
            content="Ninguém toca nesta janela. Uma thread do próprio programa manda as ações pelo canal `external`."
            size="13"
            color="#8B949E"
        />

        <Container padding="18" background="#161B22">
            <Column spacing="10">
                <Text content="nome:  {nome}"  size="16" color="#C9D1D9" />
                <Text content="busca: {busca}" size="16" color="#C9D1D9" />
                <Text content="{estado}" size="18" bold="true" color="#3FB950" />
            </Column>
        </Container>

        <Button text="Reiniciar (clique humano)" on_click="reiniciar" color="#4C566A" padding="10 20" />
    </Column>
</Container>

<!-- Ações em Lua, num arquivo separado (resolvido relativo a este template). -->
<script src="controle_externo.luau"></script>
