<screen title="Glacier - navegação via script Lua · Dashboard">
  <resources>
    <!-- O fundo da janela é do TEMA, não de um `background` na raiz: pintar
         um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
         em cada pixel da tela, e ela custa (ver AGENTS.md). -->
    <link rel="theme" href="examples/navegacao_luau/theme.json" />
    <script>
      -- `navigate_back()` é o equivalente Lua do atributo `navigateBack`: volta
      -- para a tela anterior do histórico do motor. Aqui também limpa a senha do
      -- contexto antes de voltar — algo que o atributo declarativo não permite.
      function sair()
        ctx.senha = nil
        navigate_back()
      end
    </script>
  </resources>

  <container
    padding="40"
    width="fill"
    height="fill"
    align_x="Center"
    align_y="Center"
  >
    <column spacing="18" align_x="Center">
      <text size="32" bold="true" color="#F5E0DC">Painel</text>
      <text size="18" color="#A6ADC8">Bem-vindo, {usuario}!</text>
      <button text="Sair" on_click="sair" color="#313244" width="240" padding="12" />
    </column>
  </container>
</screen>
