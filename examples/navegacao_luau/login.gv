<screen title="Glacier - navegação via script Lua · Login">
  <resources>
    <script>
      -- Ao contrário do atributo declarativo `navigateTo` (troca de tela sempre que
      -- o botão é clicado), `navigate(tela)` deixa o SCRIPT decidir: aqui só troca
      -- de tela se a validação passar — o botão em si não sabe para onde vai.
      function entrar()
        if ctx.usuario == "admin" and ctx.senha == "123" then
          ctx.erro=""
          navigate("dashboard_luau")
        else
          ctx.erro="Usuário ou senha inválidos."
        end
      end
    </script>
  </resources>

  <container
    padding="40"
    width="fill"
    height="fill"
    background="#11111B"
    align_x="Center"
    align_y="Center"
  >
    <column spacing="18" align_x="Center">
      <text size="32" bold="true" color="#F5E0DC">Entrar</text>
      <text size="12" color="#6C7086">dica: admin / 123</text>

      <column spacing="8" width="280">
        <input
          placeholder="usuário"
          value="usuario"
          on_change="usuario"
          width="fill"
          padding="10"
        />
        <input
          placeholder="senha"
          value="senha"
          on_change="senha"
          secure="true"
          width="fill"
          padding="10"
        />
      </column>

      <button text="Entrar" on_click="entrar" color="#89B4FA" width="280" padding="12" />
      <text size="13" color="#F38BA8">{erro}</text>
    </column>
  </container>
</screen>
