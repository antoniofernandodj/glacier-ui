// `<audio>`: um arquivo de áudio local com player (botão, barra de posição, tempo). Ver docs/AUDIO.md.
//
//   WGPU_BACKEND=gl cargo run --example audio --features audio
//
// O 1º é um MP3, o 2º um WAV (um tom de 440 Hz — esse dá para ouvir). O 3º não desenha
// nada (`controls = false`): é uma fonte controlada pelos botões, e `on_ended` conta
// quantas vezes ela chegou ao fim.
screen(title = "Áudio") {
  resources {
    link(rel = stylesheet, href = "examples/audio/app.gss")
  }

  container(class = caixa) {
    column(class = coluna) {
      text("<audio>", class = titulo)

      text("MP3 (8 s, silêncio)", class = rotulo)
      audio(name = mp3, src = "examples/audio/sons/silencio.mp3")

      text("WAV (8 s, 440 Hz)", class = rotulo)
      audio(name = tom, src = "examples/audio/sons/tom.wav", volume = 0.4)

      text("Sem controles, dirigido por botões — fins: {fins}", class = rotulo)
      audio(name = curto, src = "examples/audio/sons/tom.wav", controls = false, on_ended = terminou)
      row(class = linha) {
        button(text = "Tocar", on_click = "audio:play:curto")
        button(text = "Pausar", on_click = "audio:pause:curto")
        button(text = "Parar", on_click = "audio:stop:curto")
      }
    }
  }
}
