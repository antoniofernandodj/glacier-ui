/*
examples/onda8_luau/app.gss

O visual da tela. O `app.gv` ficou com estrutura, o `scripts/app.luau` com
comportamento, e as cores e espaçamentos ficaram aqui — inclusive os que pintam
o corpo dos diálogos, que a partir da Onda 8 passam pelo `.gss` como o de
qualquer tela.
*/

:root {
  --texto: #CDD6F4;
  --suave: #A6ADC8;
  --fraco: #7F849C;
  --faixa: #181825;
}

/* ── Esqueleto ─────────────────────────────────────────────────────────── */

.tela  { width: fill; height: fill; }
.corpo { width: fill; padding: 18 22; spacing: 18; }

.barra {
  width: fill;
  padding: 14 18;
  spacing: 12;
  align_y: center;
  background: var(--faixa);
}

.empurra { width: fill; }

/* ── Blocos ────────────────────────────────────────────────────────────── */

.bloco   { width: fill; padding: 16; }
.painel  { width: fill; spacing: 12; }
.colunas { width: fill; spacing: 18; }
.acoes   { spacing: 10; align_y: center; }

.amostra { width: 44; height: 32; border_radius: 6; border_width: 1; }

/* ── Texto ─────────────────────────────────────────────────────────────── */

.titulo { size: 16; bold: true; color: var(--texto); }
.secao  { size: 14; bold: true; color: var(--texto); }
.lead   { size: 13; color: var(--suave); }
.valor  { size: 13; color: var(--texto); }
.nota   { size: 12; color: var(--fraco); }
.status { size: 12; color: var(--fraco); }
