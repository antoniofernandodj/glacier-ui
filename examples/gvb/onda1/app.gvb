screen(title = "Glacier - Onda 1", size = "900 700") {
  resources {
    link(rel = stylesheet, href = "examples/gvb/onda1/app.gss")
    // O fundo da janela é do TEMA, não de um `background` na raiz: pintar
    // um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
    // em cada pixel da tela, e ela custa (ver AGENTS.md).
    link(rel = theme, href = "examples/gvb/onda1/theme.json")
  }

  column(class = coluna) {
    // A StatusBar e o GroupBox são da onda 2; as duas ondas compõem sem
    // nada de especial: o conteúdo de um slot pode ser qualquer widget,
    // embutido ou não.
    toolbar(divider = true) {
      text(
        content = "Onda 1 — Slider, Space, Radio e Avatar", class = destaque,
      )

      // 2. Space: aqui é o espaçador FLEXÍVEL. Sem width, ele é
      // Length::Fill e come toda a sobra, empurrando o avatar para a
      // borda direita. É o QSpacerItem de um QHBoxLayout.
      space
      avatar(initials = AF, size = 28, bg = #89B4FA, fg = #11111B)
    }

    scrollable(class = rolagem) {
      column(class = coluna_2) {
        // 1. Slider ===============================================
        groupbox(title = "Slider — o QSlider") {
          text(
            content = """
              Primitiva: dispara onChange com o valor novo, e quem grava a chave é
              o update da tela. Sem esse handler, o cursor não sairia do lugar.
            """,
            class = texto,
          )

          row(class = linha) {
            text(content = "Volume", class = texto_2)

            slider(
              :value = volume, min = 0, max = 100, on_change = ajustar_volume,
              class = controle,
            )

            text(content = "@volume", class = texto)
          }

          // Passo fracionário: as casas decimais da saída saem do
          // próprio step ("0.05" -> 2 casas), então a chave nunca
          // recebe 0.6000000238418579.
          row(class = linha) {
            text(content = "Brilho", class = texto_2)

            slider(
              :value = brilho, min = 0, max = 1, step = 0.05,
              on_change = ajustar_brilho,
              color = #A6E3A1, class = controle,
            )

            text(content = "@brilho", class = texto)
          }

          // default: clique duplo devolve o cursor ao valor neutro.
          // on_release: a ação só dispara ao SOLTAR, para quem não
          // quer um efeito colateral por pixel arrastado.
          row(class = linha) {
            text(content = "Graves", class = texto_2)

            slider(
              :value = graves, min = -10, max = 10, default = 0,
              on_change = ajustar_graves, class = controle,
            )

            text(
              content = "@graves dB (duplo clique volta a 0)", class = texto,
            )
          }
        }

        // Slider + SpinBox na MESMA chave: o par do Qt. O SpinBox
        // grava sozinho (é builtin, tem update); o Slider grava pelo
        // handler da tela. Os dois leem e escrevem "zoom", então
        // andam juntos.
        groupbox(title = "Slider + SpinBox na mesma chave", flat = true) {
          row(class = linha) {
            text(content = "Zoom (%)", class = texto_2)

            slider(
              :value = zoom, min = 25, max = 400, step = 25,
              on_change = ajustar_zoom, class = controle_2,
            )

            spinbox(:value = zoom, min = 25, max = 400, step = 25, width = 80)
            text(content = "@zoom%", class = texto)
          }

          row(class = linha) {
            text(content = "Vertical", class = texto_2)

            slider(
              :value = volume, min = 0, max = 100, vertical = true,
              on_change = ajustar_volume, class = controle_3,
            )

            text(
              content = "o mesmo 'volume' do grupo acima, no vertical_slider",
              class = texto,
            )
          }
        }

        // 3. Radio / RadioGroup ====================================
        groupbox(
          title = "Radio e RadioGroup — o QRadioButton e o QButtonGroup",
        ) {
          text(
            content = """
              Os dois caminhos escrevendo na MESMA chave 'plano'. O grupo é a
              chave, não um nó pai: todo Radio que aponta para o mesmo valor é do
              mesmo grupo.
            """,
            class = texto,
          )

          row(class = linha_2) {
            column(class = coluna_3) {
              text(content = "Primitiva, escrita à mão:", class = destaque_2)

              radio(
                label = Grátis, value = free, :group = plano,
                on_change = escolher_plano,
              )

              radio(
                label = Pro, value = pro, :group = plano,
                on_change = escolher_plano,
              )

              radio(
                label = Time, value = team, :group = plano,
                on_change = escolher_plano,
              )

              text(content = "+ 1 braço no update da tela", class = nota)
            }

            column(class = coluna_3) {
              text(content = "Builtin, de uma coleção:", class = destaque_2)

              radiogroup(:value = plano, :items = planos)
              text(content = "nenhum handler no app", class = nota)
            }

            column(class = coluna_3) {
              text(content = "O mesmo builtin, deitado:", class = destaque_2)

              radiogroup(:value = plano, :items = planos, layout = row)
              text(content = "plano escolhido: @plano", class = texto)
            }
          }
        }

        // 4. Avatar ================================================
        groupbox(title = Avatar) {
          text(
            content = """
              Sempre ocupa o mesmo espaço, com foto ou sem: numa lista de usuários
              a foto que falta é o caso comum, e um buraco vazio quebraria o
              alinhamento da linha.
            """,
            class = texto,
          )

          row(class = linha) {
            avatar(src = "examples/gvb/perfil/avatar.png", size = 56)
            avatar(initials = AF, size = 56)
            avatar(initials = MS, size = 56, bg = #A6E3A1, fg = #11111B)
            avatar(size = 56)

            text(
              content = """
                foto · iniciais · cores por instância · sem nada (o '?')
              """,
              class = texto,
            )
          }
        }

        // 2. Space (fixo) ==========================================
        groupbox(title = "Space — o QSpacerItem", flat = true) {
          text(
            content = """
              Sem width/height é Length::Fill nos dois eixos (o espaçador
              flexível, como no topo desta janela); com eles, vira um vão fixo.
            """,
            class = texto,
          )

          row(class = linha_3) {
            text(content = "esquerda", class = texto_3)
            space
            text(
              content = "centro (empurrado por dois Space fill)",
              class = texto_3,
            )
            space
            text(content = "direita", class = texto_3)
          }

          row(class = linha_3) {
            text(content = "a", class = texto_3)
            space(class = espaco)
            text(content = "b (80px fixos entre nós)", class = texto_3)
          }
        }
      }
    }

    statusbar(
      message = "volume @volume · brilho @brilho · zoom @zoom% · plano @plano",
    ) {
      badge(badge_text = "onda 1", badge_bg = #A6E3A1, badge_size = 11)
    }
  }
}
