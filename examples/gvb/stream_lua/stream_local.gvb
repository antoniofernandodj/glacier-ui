screen(title = "Glacier - SSE + WebSocket em Lua (local)") {
  resources {
    link(rel = stylesheet, href = "examples/gvb/stream_lua/app.gss")
    // O fundo da janela é do TEMA, não de um `background` na raiz: pintar
    // um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
    // em cada pixel da tela, e ela custa (ver AGENTS.md).
    link(rel = theme, href = "examples/gvb/stream_lua/theme.json")
    script(src = stream_local.luau)
  }

  container(class = caixa) {
    column(align = Center, class = coluna) {
      text(
        content = "SSE + WebSocket em Lua → API Python (localhost:8000)",
        class = titulo,
      )

      text(content = "— Server-Sent Events (/sse) —", class = destaque)

      row(align = Center, class = linha) {
        button(text = "Abrir SSE", on_click = abrir_sse, class = botao)

        button(text = "Fechar SSE", on_click = fechar_sse, class = botao_2)
      }

      text(content = "SSE: @sse_status", class = texto)
      text(content = "@sse_msg", class = texto_2)
      text(content = "— WebSocket echo (/ws) —", class = destaque)

      row(align = Center, class = linha) {
        button(text = Conectar, on_click = abrir_ws, class = botao)

        button(text = "Enviar ping", on_click = enviar_ws, class = botao_3)

        button(text = Fechar, on_click = fechar_ws, class = botao_2)
      }

      text(content = "WS: @ws_status", class = texto)
      text(content = "@ws_msg", class = texto_2)
    }
  }
}
