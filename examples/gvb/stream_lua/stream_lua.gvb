screen {
  title: "Glacier - SSE + WebSocket em Lua"

  resources {
    // O fundo da janela é do TEMA, não de um `background` na raiz: pintar
    // um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
    // em cada pixel da tela, e ela custa (ver AGENTS.md).
    link { rel: theme href: "examples/gvb/stream_lua/theme.json" }
    script { src: stream_lua.luau }
  }

  container {
    padding: 24 align_x: Center align_y: Center width: fill height: fill

    column {
      spacing: 14 align: Center width: 460

      text "SSE + WebSocket em Lua" { size: 22 bold: true color: #ECEFF4 }
      text "— Server-Sent Events —" { size: 13 bold: true color: #88C0D0 }

      row {
        spacing: 10 align: Center

        button {
          text: "Abrir SSE" on_click: abrir_sse color: #5E81AC padding: "10 18"
        }

        button {
          text: "Fechar SSE" on_click: fechar_sse color: #BF616A
          padding: "10 18"
        }
      }

      text "SSE: @sse_status" { size: 13 color: #EBCB8B }
      text "@sse_msg" { size: 15 color: #A3BE8C }
      text "— WebSocket (echo) —" { size: 13 bold: true color: #88C0D0 }

      row {
        spacing: 10 align: Center

        button {
          text: Conectar on_click: abrir_ws color: #5E81AC padding: "10 18"
        }

        button {
          text: "Enviar ping" on_click: enviar_ws color: #A3BE8C
          padding: "10 18"
        }

        button {
          text: Fechar on_click: fechar_ws color: #BF616A padding: "10 18"
        }
      }

      text "WS: @ws_status" { size: 13 color: #EBCB8B }
      text "@ws_msg" { size: 15 color: #A3BE8C }
    }
  }
}
