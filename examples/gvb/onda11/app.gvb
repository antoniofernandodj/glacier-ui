screen(title = "Glacier — Onda 11", size = "1080 760", min_size = "900 640") {
  resources {
    link(rel = stylesheet, href = "examples/gvb/onda11/app.gss")
  }

  column(class = tela) {
    row(class = barra) {
      text(class = titulo, content = "Onda 11 — o que fica por cima")
      space(class = empurra)
      text(class = status, content = "@status")
    }

    tabbar(:items = abas, :value = aba, selected = @aba, class = abas)

    // ══ 1 + 2: Stack, NotificationDot, SplashScreen ══════════════════
    if @aba == "empilhamento" {
      scrollable {
        column(class = corpo-rolavel) {
          text(
            class = lead,
            content = """
              O `<stack>` empilha filhos no mesmo espaço. Um filho com `anchor=`
              gruda num dos nove cantos sem precisar de coordenada; um filho com
              `x=`/`y=` usa posição livre em pixels (`pin`).
            """,
          )

          column(class = "bloco bloco-fill") {
            text(class = secao, content = "SplashScreen")

            text(
              class = nota,
              content = """
                Cobre o conteúdo principal enquanto `show` for verdadeiro. Sem
                animação — a descoberta da onda: um `<reveal>` não interpola um
                filho `height="fill"` (a armadilha do `Length::Fill`, ver
                `PRIMITIVAS.md`).
              """,
            )

            button(text = "reabrir a splash", on_click = abrir_splash)

            SplashScreen(
              show = @carregando, height = 220, class = demo-splash,
            ) {
              container(class = conteudo-real) {
                text(
                  class = secao,
                  content = "O conteúdo principal — estava aqui o tempo todo",
                )
              }

              template(slot = splash) {
                column(class = splash-conteudo) {
                  text(class = splash-titulo, content = "Glacier UI")
                  spinner
                  button(text = "pronto — fechar", on_click = fechar_splash)
                }
              }
            }
          }

          row(class = linha) {
            column(class = bloco) {
              text(class = secao, content = "anchor — nove cantos")

              stack(class = demo-anchor) {
                container(class = demo-fundo)
                text(anchor = top-left, class = marca, content = "TL")
                text(anchor = top, class = marca, content = "T")
                text(anchor = top-right, class = marca, content = "TR")
                text(anchor = left, class = marca, content = "L")
                text(
                  anchor = center, class = "marca marca-centro",
                  content = "C",
                )
                text(anchor = right, class = marca, content = "R")
                text(anchor = bottom-left, class = marca, content = "BL")
                text(anchor = bottom, class = marca, content = "B")
                text(anchor = bottom-right, class = marca, content = "BR")
              }
            }

            column(class = bloco) {
              text(class = secao, content = "x/y — posição livre")

              stack(class = demo-anchor) {
                container(class = demo-fundo)
                text(x = 14, y = 10, class = marca, content = "14,10")
                text(x = 120, y = 70, class = marca, content = "120,70")
                text(x = 40, y = 130, class = marca, content = "40,130")
              }
            }

            column(class = bloco) {
              text(class = secao, content = "NotificationDot")

              row(class = notif-linha) {
                NotificationDot(show = @tem_notificacao) {
                  container(class = icone-sino) {
                    text(class = icone-emoji, content = "🔔")
                  }
                }

                button(text = alternar, on_click = alternar_notificacao)
              }

              text(
                class = nota,
                content = """
                  `<stack>` (a primeira camada) + `anchor="top-right"` (a segunda)
                  — sem `pin`, porque um canto não precisa saber o tamanho do
                  ícone.
                """,
              )
            }
          }
        }
      }
    }

    // ══ 3: MdiArea ════════════════════════════════════════════════════
    if @aba == "mdi" {
      column(class = corpo) {
        text(
          class = lead,
          content = """
            Duas janelas nomeiam QUATRO chaves cada
            (`x_var`/`y_var`/`w_var`/`h_var` — a forma curta `x`/`y`/`w`/`h`
            também funciona, mas colide de NOME com o `x`/`y` do `<stack>` acima).
            Arraste a barra de título para mover; arraste o canto inferior direito
            para redimensionar — o MESMO `grip::Alvo::Ponto`, com limites
            diferentes.
          """,
        )

        mdiarea(class = mdi-fundo) {
          mdisubwindow(
            title = Editor, x_var = editor_x, y_var = editor_y,
            w_var = editor_w,
            h_var = editor_h,
          ) {
            column(class = janela-corpo) {
              text(class = secao, content = "Editor")
              text(
                class = chave,
                content = "editor_x = @editor_x editor_y = @editor_y",
              )
              text(
                class = chave,
                content = "editor_w = @editor_w editor_h = @editor_h",
              )
            }
          }

          mdisubwindow(
            title = Console, x_var = console_x, y_var = console_y,
            w_var = console_w,
            h_var = console_h, default_w = 300, default_h = 180,
          ) {
            column(class = janela-corpo) {
              text(class = secao, content = "Console")

              text(
                class = nota,
                content = """
                  Esta janela não recebeu seed nem para `w`/`h` — nasce em
                  `default_w`/`default_h` (300×180), do markup.
                """,
              )
            }
          }
        }
      }
    }

    // ══ 4–8: o troco esvaziado ════════════════════════════════════════
    if @aba == "troco" {
      scrollable {
        column(class = corpo-rolavel) {
          text(
            class = lead,
            content = """
              Cinco widgets pequenos que a §6.3 do `PLANO_WIDGETS.md` guardava
              como "não abre rodada sozinho" — a Onda 11 passou no lugar deles.
            """,
          )

          row(class = linha) {
            column(class = bloco) {
              text(class = secao, content = "QrCode")
              qrcode(content = @qr_texto, width = 120, height = 120)

              textinput(
                :value = qr_texto, on_change = qr_texto,
                placeholder = "conteúdo do QR",
              )
            }

            column(class = bloco) {
              text(class = secao, content = "Chip")

              row(class = chip-linha) {
                Chip(
                  for-each = tags, var = tag, label = @tag,
                  on_remove = remover_tag:@tag,
                )
              }

              text(
                class = nota,
                content = """
                  O "×" remove da coleção — a ação carrega o nome, o `update`
                  filtra.
                """,
              )
            }

            column(class = bloco) {
              text(class = secao, content = "Skeleton")

              column(class = skeleton-lista) {
                Skeleton(width = 220, height = 14)
                Skeleton(width = 180, height = 14)
                Skeleton(width = fill, height = 60, radius = 8)
              }
            }
          }

          row(class = linha) {
            column(class = "bloco bloco-largo") {
              text(class = secao, content = "CommandLink")

              CommandLink(
                title = "Instalação típica",
                description = "Recomendado para a maioria dos usuários",
                on_click = instalar_tipica,
              )

              CommandLink(
                title = "Instalação customizada",
                description = "Escolha componentes individualmente",
                on_click = instalar_custom,
              )
            }

            column(class = bloco) {
              text(class = secao, content = "RoundButton")

              RoundButton(
                text = +, color = #89B4FA, on_click = novo_item, size = 48,
              )
            }
          }
        }
      }
    }
  }
}
