screen(
  title = "Glacier — http client (Luau)", size = "900 680",
  min_size = "760 560",
) {
  resources {
    link(rel = stylesheet, href = "examples/gvb/http_client_luau/app.gss")
    script(src = "scripts/app.luau")
  }

  column(class = tela) {
    row(class = barra) {
      text(class = titulo, content = "http(...) — o cliente sobre o fetch")
      space(class = empurra)
      text(class = status, content = "@status")
    }

    column(class = corpo) {
      text(
        class = lead,
        content = """
          Um `http("https://…", @{ headers, timeout, retries })` com interceptors
          de requisição/resposta e um error handler. Cada botão é um método do
          client; as chamadas suspendem, sem travar a janela.
        """,
      )

      row(class = acoes) {
        button(text = "GET /posts/1", on_click = buscar_um)
        button(text = "GET ?userId=1", on_click = buscar_lista)
        button(text = "POST /posts", on_click = criar)
        button(text = "forçar 404", on_click = forcar_erro, class = btn-fraco)
      }

      column(class = bloco) {
        text(class = secao, content = "resposta")
        text(class = corpo-resp, content = "@corpo")
      }

      column(class = "bloco bloco-cresce") {
        text(class = secao, content = "log dos interceptors")

        scrollable(class = rolagem) {
          text(class = log, content = "@log")
        }
      }
    }
  }
}
