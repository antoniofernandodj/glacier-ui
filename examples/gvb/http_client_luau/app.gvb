screen {
  title: "Glacier — http client (Luau)" size: "900 680" min_size: "760 560"

  resources {
    link { rel: stylesheet href: "examples/gvb/http_client_luau/app.gss" }
    script { src: "scripts/app.luau" }
  }

  column {
    class: tela

    row {
      class: barra

      text "http(...) — o cliente sobre o fetch" { class: titulo }
      space { class: empurra }
      text "@status" { class: status }
    }

    column {
      class: corpo

      text """
        Um `http("https://…", @{ headers, timeout, retries })` com interceptors
        de requisição/resposta e um error handler. Cada botão é um método do
        client; as chamadas suspendem, sem travar a janela.
      """ {
        class: lead
      }

      row {
        class: acoes

        button { text: "GET /posts/1" on_click: buscar_um }
        button { text: "GET ?userId=1" on_click: buscar_lista }
        button { text: "POST /posts" on_click: criar }
        button { text: "forçar 404" on_click: forcar_erro class: btn-fraco }
      }

      column {
        class: bloco

        text "resposta" { class: secao }
        text "@corpo" { class: corpo-resp }
      }

      column {
        class: "bloco bloco-cresce"

        text "log dos interceptors" { class: secao }

        scrollable {
          width: fill height: fill

          text "@log" { class: log }
        }
      }
    }
  }
}
