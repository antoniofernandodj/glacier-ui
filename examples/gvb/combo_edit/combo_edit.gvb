screen(title = "Glacier - ComboEdit (servidores salvos)") {
  resources {
    link(rel = stylesheet, href = "examples/gvb/combo_edit/app.gss")
    // O fundo da janela é do TEMA, não de um `background` na raiz: pintar
    // um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
    // em cada pixel da tela, e ela custa (ver AGENTS.md).
    link(rel = theme, href = "examples/gvb/combo_edit/theme.json")
  }

  // `<comboedit>`: dropdown editável (combo_box do iced). Digite um servidor
  // novo à vontade, ou escolha um dos já salvos na lista — escolher um
  // preenche o token sozinho (veja `servidor_selecionado` em main.rs).
  container(class = caixa) {
    column(class = coluna) {
      text(content = "Servidores salvos", class = titulo)

      column(class = coluna_2) {
        text(content = "Servidor", class = texto)

        comboedit(
          :options = servidores, :value = url,
          placeholder = "https://servidor.exemplo.com", on_change = url_changed,
          on_select = servidor_selecionado, width = fill,
        )
      }

      column(class = coluna_2) {
        text(content = "Token", class = texto)

        input(
          :value = token, on_change = token_changed,
          placeholder = "token de acesso",
          secure = true, class = campo,
        )
      }

      button(text = "Salvar este par", on_click = salvar, class = botao)

      rule
      text(content = "Pares salvos:", class = texto)
      text(content = "@pares_txt", class = nota)
    }
  }
}
