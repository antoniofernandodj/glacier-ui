screen(title = "Glacier — Bandeja", size = "460 300") {
  resources {
    link(rel = stylesheet, href = "examples/gvb/bandeja/app.gss")
    // O fundo da janela é do TEMA, não de um `background` na raiz: pintar
    // um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
    // em cada pixel da tela, e ela custa (ver AGENTS.md).
    link(rel = theme, href = "examples/gvb/bandeja/theme.json")
  }

  container(class = caixa) {
    column(align = Center, class = coluna) {
      text(content = "Exemplo de bandeja", class = titulo)

      text(
        content = "Feche esta janela: o app continua na bandeja.",
        class = texto,
      )

      text(
        content = "Reabra pelo item 'Open' do menu do ícone.", class = texto_2,
      )

      button(
        text = "Disparar notificação do SO", on_click = notificar,
        class = botao,
      )

      text(
        content = """
          (o toggle 'Disable/Enable notifications' na bandeja liga/desliga isto)
        """,
        class = nota,
      )
    }
  }
}
