screen(
  title = "Glacier — Onda 8b (Luau)", size = "900 640", min_size = "760 560",
) {
  resources {
    link(rel = stylesheet, href = "examples/gvb/onda8b_luau/app.gss")
    script(src = "scripts/app.luau")

    // ── A: o componente que embrulha um diálogo inteiro ─────────────────
    // Ele traz o próprio `<dialog>`, o próprio botão e o próprio handler.
    // Ver `views/editor_rotulo.gva`.
    import(name = EditorRotulo, from = "views/editor_rotulo.gvb")

    // ── B: o componente que um diálogo usa NO CORPO ─────────────────────
    // `CampoForm` é só rótulo + `<slot/>`. Declarado aqui, montado dentro
    // do corpo do `<dialog>` abaixo.
    component(name = CampoForm) {
      props {
        prop(name = label)
      }

      column(class = cf-campo) {
        text(class = cf-label, content = "@label")
        slot
      }
    }

    // Direction B: um `<dialog>` cujo corpo compõe dois `<CampoForm>`. O
    // binding de cada campo (`__dialog.*`) fica aqui, literal; o handler
    // `salvar_perfil` mora no `scripts/app.luau` da tela.
    dialog(
      name = editar_perfil, title = "Editar perfil",
      buttons = "         Cancelar::|         Salvar:salvar_perfil:accept       ",
    ) {
      column(class = dlg-form) {
        CampoForm(label = Nome) {
          textinput(
            :value = __dialog.nome, on_change = __dialog.nome, placeholder = ana,
            class = dlg-fill,
          )
        }

        CampoForm(label = Cargo) {
          select(
            :options = cargos, :value = __dialog.cargo,
            on_change = __dialog.cargo,
            class = dlg-fill,
          )
        }
      }
    }
  }

  column(class = tela) {
    row(class = barra) {
      text(
        class = titulo,
        content = "Onda 8b — component e dialog, nos dois sentidos",
      )
      space(class = empurra)
      text(class = status, content = "@status")
    }

    column(class = corpo) {
      // ── A ────────────────────────────────────────────────────────────
      frame(shape = box, class = bloco) {
        column(class = painel) {
          text(
            class = secao,
            content = "A — um component encapsula o dialog inteiro",
          )

          text(
            class = nota,
            content = """
              O <EditorRotulo/> traz o próprio <dialog>, o próprio botão e o
              próprio handler. A tela abaixo não declara nada disso — só escreve a
              tag. O botão Salvar do diálogo despacha EditorRotulo::salvar (o ::
              de dono).
            """,
          )

          EditorRotulo
        }
      }

      // ── B ────────────────────────────────────────────────────────────
      frame(shape = box, class = bloco) {
        column(class = painel) {
          text(
            class = secao,
            content = "B — um dialog cujo corpo usa um component",
          )

          row(class = acoes) {
            button(text = "Editar perfil", on_click = dialog:editar_perfil)
          }

          text(class = valor, content = "Perfil: @perfil")

          text(
            class = nota,
            content = """
              O corpo do <dialog name="editar_perfil"> monta dois <CampoForm>
              (rótulo + slot). Um component avaliado no contexto do app, como
              qualquer nó — o binding de cada campo continua uma chave __dialog.*
              literal.
            """,
          )
        }
      }
    }
  }
}
