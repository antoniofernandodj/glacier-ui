screen(
  title = "Glacier — séries múltiplas", size = "1040 780", min_size = "880 620",
) {
  resources {
    link(rel = stylesheet, href = "examples/gvb/series_multiplas/app.gss")
  }

  column(class = tela) {
    row(class = barra) {
      text(
        class = titulo,
        content = "Onda 11 · habilitador C — séries múltiplas",
      )
      space(class = empurra)
      text(class = status, content = "@status")
    }

    scrollable(class = rolagem) {
      column(class = corpo) {
        text(
          class = lead,
          content = """
            `series="chave"` guarda um array de `@{ name, points, color? }`. A
            moldura, a escala e a legenda são do motor; sem `color`, cada linha
            recebe uma cor do ciclo do tema.
          """,
        )

        column(class = bloco) {
          text(
            class = secao,
            content = "linechart — três séries, uma com cor fixa",
          )
          linechart(:series = requisicoes, min = 0, grid = true, class = grafico)

          row(class = acoes) {
            button(text = "girar os dados", on_click = girar)
            button(text = resetar, on_click = resetar, class = btn-fraco)
          }

          text(
            class = nota,
            content = """
              O botão troca a chave inteira; o gráfico relê no render seguinte,
              sem handler próprio — como todo widget de `canvas` desde a Onda 7.
            """,
          )
        }

        row(class = linha) {
          column(class = "bloco bloco-cresce") {
            text(
              class = secao,
              content = "area — o AreaChart, agora multi-série",
            )
            linechart(
              :series = requisicoes, min = 0, area = true, class = grafico,
            )
          }

          column(class = "bloco bloco-cresce") {
            text(
              class = secao,
              content = "points — o Scatter, agora multi-série",
            )
            linechart(
              :series = latencia, min = 0, points = true, class = grafico,
            )
          }
        }

        column(class = bloco) {
          text(class = secao, content = "sparkline — sem eixos, sem legenda")

          text(
            class = nota,
            content = """
              Multi-série vale aqui também, mas a legenda só sai quando há eixos:
              num sparkline não cabe.
            """,
          )

          sparkline(series = latencia, class = mini)
        }
      }
    }
  }
}
