screen {
  title: "Glacier — séries múltiplas" size: "1040 780" min_size: "880 620"

  resources {
    link { rel: stylesheet href: "examples/gvb/series_multiplas/app.gss" }
  }

  column {
    class: tela

    row {
      class: barra

      text "Onda 11 · habilitador C — séries múltiplas" { class: titulo }
      space { class: empurra }
      text "@status" { class: status }
    }

    scrollable {
      width: fill height: fill

      column {
        class: corpo

        text """
          `series="chave"` guarda um array de `@{ name, points, color? }`. A
          moldura, a escala e a legenda são do motor; sem `color`, cada linha
          recebe uma cor do ciclo do tema.
        """ {
          class: lead
        }

        column {
          class: bloco

          text "linechart — três séries, uma com cor fixa" { class: secao }
          linechart { series: requisicoes min: 0 grid: true class: grafico }

          row {
            class: acoes

            button { text: "girar os dados" on_click: girar }
            button { text: resetar on_click: resetar class: btn-fraco }
          }

          text """
            O botão troca a chave inteira; o gráfico relê no render seguinte,
            sem handler próprio — como todo widget de `canvas` desde a Onda 7.
          """ {
            class: nota
          }
        }

        row {
          class: linha

          column {
            class: "bloco bloco-cresce"

            text "area — o AreaChart, agora multi-série" { class: secao }
            linechart { series: requisicoes min: 0 area: true class: grafico }
          }

          column {
            class: "bloco bloco-cresce"

            text "points — o Scatter, agora multi-série" { class: secao }
            linechart { series: latencia min: 0 points: true class: grafico }
          }
        }

        column {
          class: bloco

          text "sparkline — sem eixos, sem legenda" { class: secao }

          text """
            Multi-série vale aqui também, mas a legenda só sai quando há eixos:
            num sparkline não cabe.
          """ {
            class: nota
          }

          sparkline { series: latencia class: mini }
        }
      }
    }
  }
}
