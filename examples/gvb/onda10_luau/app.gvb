screen(
  title = "Glacier — Onda 10 (Luau)", size = "960 700", min_size = "820 560",
) {
  resources {
    link(rel = stylesheet, href = "examples/gvb/onda10_luau/app.gss")
    script(src = "scripts/app.luau")
  }

  column(class = tela) {
    row(class = barra) {
      text(class = titulo, content = "Onda 10 em Luau — pick_font e fontselect")
      space(class = empurra)
      text(class = status, content = "@status")
    }

    row(class = corpo) {
      column(class = coluna-lista) {
        text(class = secao, content = "fontselect")

        text(
          class = nota,
          content = """
            Markup puro: lê a chave `__fonts` do motor e grava a família escolhida
            em `fonte`. Nenhuma linha de script por trás dele.
          """,
        )

        fontselect(:value = fonte, selected = @fonte, height = 220)
      }

      column(class = coluna-demo) {
        column(class = bloco) {
          text(class = secao, content = "pick_font — o QFontDialog")

          text(
            class = nota,
            content = """
              `prompt` com `kind = "font"`, a mesma porta do `pick_color`.
              Suspende a corrotina e devolve a família, ou nada se cancelar.
            """,
          )

          button(
            text = "Escolher fonte…", on_click = abrir_dialogo, class = botao,
          )

          text(class = rotulo, content = "última escolha: @ultima")
        }

        column(class = "bloco bloco-cresce") {
          text(class = secao, content = "amostra")

          text(
            class = amostra, font = @fonte,
            content = "Sphinx of black quartz, judge my vow — 0123456789",
          )

          text(
            class = amostra-mono, font = @fonte,
            content = "A mesma linha, no tamanho do editor.",
          )
        }
      }
    }
  }
}
