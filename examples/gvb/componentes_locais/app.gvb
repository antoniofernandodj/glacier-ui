screen(title = "Glacier - Componentes locais", size = "900 720") {
  resources {
    link(rel = stylesheet, href = "examples/gvb/componentes_locais/app.gss")
    // O fundo da janela é do TEMA, não de um `background` na raiz: pintar
    // um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
    // em cada pixel da tela, e ela custa (ver AGENTS.md).
    link(rel = theme, href = "examples/gvb/componentes_locais/theme.json")

    // ======================================================================
    // A TERCEIRA FORMA DE TER UM COMPONENTE.
    //
    // As duas primeiras trazem de um arquivo:
    //
    //     <import name="X" from="x.gva" />
    //     <link rel="component" href="x.gva" as="X" />
    //
    // Esta declara aqui mesmo. O que vai entre <component name="X"> e
    // </component> é BYTE A BYTE o que iria num .gva próprio: <props> e depois
    // o layout. A única diferença é o `name`.
    //
    // Ela existe porque a maior parte dos componentes de uma tela é pequena e
    // só serve àquela tela. Obrigar cada um a virar arquivo troca três linhas
    // de markup por um arquivo, um caminho relativo e um <import>.
    // ======================================================================
    // 1. Um componente de uma linha só. Este é o caso que a forma de arquivo
    // atende mal: um `.gva` inteiro para isto seria mais cerimônia do que
    // conteúdo.
    component(name = Rotulo) {
      props {
        prop(name = texto)
        prop(name = cor, default = #A6ADC8)
        prop(name = tamanho, default = 12)
      }

      text(color = @cor, size = @tamanho, content = "@texto")
    }

    // 2. Um componente que usa OUTRO componente local. Eles se compõem como
    // quaisquer outros — o nome entra no mesmo espaço de nomes, e a ordem de
    // declaração não importa.
    component(name = LinhaLog) {
      props {
        prop(name = hora)
        prop(name = nivel)
        prop(name = texto)
      }

      row(class = linha) {
        Rotulo(texto = @hora, cor = #6C7086, tamanho = 11)

        // O nível vira uma cor. Um `if`/`else-if` dentro de um componente
        // local funciona igual ao de qualquer template — não há nada de
        // especial na declaração inline além de onde ela mora.
        if @nivel == "erro" {
          badge(badge_text = erro, badge_bg = #F38BA8, badge_size = 10)
        } else if @nivel == "aviso" {
          badge(badge_text = aviso, badge_bg = #F9E2AF, badge_size = 10)
        } else {
          badge(badge_text = info, badge_bg = #89B4FA, badge_size = 10)
        }

        Rotulo(texto = @texto, cor = #CDD6F4, tamanho = 13)
      }
    }

    // 3. Um componente com mais de um nó de layout na raiz. Vira um
    // Fragment, exatamente como num arquivo: os irmãos são costurados no lugar
    // de quem usou a tag, sem uma <column> fantasma por volta.
    component(name = Metrica) {
      props {
        prop(name = rotulo)
        prop(name = valor)
        prop(name = delta, default = "")
      }

      frame(shape = filled, class = moldura) {
        Rotulo(texto = @rotulo, cor = #80868D, tamanho = 11)
        text(content = "@valor", class = titulo)

        if @delta != "" {
          Rotulo(texto = @delta, cor = #A6E3A1, tamanho = 11)
        }
      }
    }

    // E a forma de ARQUIVO, ao lado, para comparar. Abra
    // `cartao_servico.gva`: ele tem a mesma casca dos três blocos acima.
    import(name = CartaoServico, from = cartao_servico.gvb)
  }

  column(class = coluna) {
    column(class = coluna_2) {
      text(
        content = "Componentes declarados na própria tela", class = titulo_2,
      )

      Rotulo(
        texto = "Os três componentes desta tela (Rotulo, LinhaLog, Metrica) estão declarados no <resources> acima. O CartaoServico veio de um arquivo. Os quatro se usam do mesmo jeito.",
        tamanho = 13,
      )
    }

    scrollable(class = rolagem) {
      column(class = coluna_3) {
        groupbox(title = "Métricas — um componente com vários nós de raiz") {
          row(class = linha_2) {
            Metrica(
              :for-each = metricas, var = m, rotulo = @m.rotulo,
              valor = @m.valor,
              delta = @m.delta,
            )
          }
        }

        groupbox(title = "Serviços — o mesmo componente, mas de um arquivo") {
          Rotulo(
            texto = "Este veio de cartao_servico.gva por <import>. Compare os dois arquivos: mesma casca, mesma forma de usar.",
            tamanho = 12,
          )

          row(class = linha_3) {
            CartaoServico(
              :for-each = servicos, var = s, id = @s.id, nome = @s.nome,
              estado = @s.estado, cor = @s.cor, uptime = @s.uptime,
            )
          }
        }

        groupbox(
          title = "Log — um componente local que usa outro componente local",
        ) {
          Rotulo(
            texto = "LinhaLog usa Rotulo três vezes. Componentes locais se compõem como quaisquer outros.",
            tamanho = 12,
          )

          frame(shape = box, class = moldura_2) {
            LinhaLog(
              :for-each = log, var = l, hora = @l.hora, nivel = @l.nivel,
              texto = @l.texto,
            )
          }
        }
      }
    }

    statusbar(message = @status) {
      badge(
        badge_text = "selecionado: @selecionado", badge_bg = #89B4FA,
        badge_size = 11,
      )
    }
  }
}
