// Texto rico em `.gvb`, com o estado em Luau (scripts/app.luau). A mesma tela do
// `examples/gvb/texto_rico`, sem `Component` em Rust: as duas telas são filhas do
// `app(...)`, e `contar` é uma função do script do app (`app::contar`).
//
//   WGPU_BACKEND=gl cargo run --example gvb_texto_rico_luau
app(id = texto_rico_luau, size = "1024 768") {
  resources {
    link(rel = stylesheet, href = "examples/gvb/texto_rico_luau/app.gss")
    script(src = "scripts/app.luau")
  }

  screen(name = home, initial = true, title = "Texto rico") {
    container(class = caixa) {
      scrollable {
        column(class = coluna) {
          text("Sobre o Glacier", class = titulo)

          prose(class = corpo) {
            p {
              span("Olá, ") b("{usuario}") span("! O motor lê ") i("markup")
              span(", ") code(".gss") span(" e Luau, e tudo isso cabe em ")
              b { i("um binário") } span(". Veja o ")
              a("repositório", href = "https://github.com/antoniofernandodj/glacier-ui")
              span(" ou ") a("a tela de detalhes", navigate_to = detalhes) span(".")
            }
            p {
              span("Tachado: ") s("antigo") span(", sublinhado: ") u("novo")
              span(", cor: ") span("alerta", color = "#F38BA8")
              span(". Um link que dispara uma ação: ")
              a("cliques: {cliques}", on_click = "app::contar") span(".")
            }
          }

          text(
            "Este parágrafo é selecionável: arraste o mouse e copie com Ctrl+C.",
            class = corpo, selectable = true,
          )

          // `l"""…"""` preserva as quebras de linha (o `"""` simples as colapsaria, e
          // o Markdown precisa delas) e tira a indentação comum.
          markdown(
            l"""
              ## Markdown também

              Um parágrafo com **negrito**, *itálico*, `código` e um
              [link](https://example.com).

              - primeiro item
              - segundo item
                - aninhado

              1. um
              2. dois

              > uma citação

              ```
              let x = 1;
              ```

              | serviço | estado |
              |--------|--------|
              | api    | ok     |
              | fila   | lento  |

              ![ícone](examples/gvb/bandeja/icon.png)

              ![remota](https://exemplo.com/x.png)

              ---
            """,
            class = md,
          )
        }
      }
    }
  }

  screen(name = detalhes, title = "Detalhes") {
    container(class = caixa) {
      column(class = coluna) {
        text("Detalhes", class = titulo)
        button(text = Voltar, navigate_back = true)
      }
    }
  }
}
