screen(title = "Glacier - ciclo de vida (painel)") {
  resources {
    link(rel = stylesheet, href = "examples/gvb/ciclo_vida_rust/estilo.gss")
  }

  container(class = tela) {
    column(class = "coluna coluna_2") {
      text(class = titulo, content = "Painel")
      text(class = info, content = "Entradas: @entradas · saídas: @saidas")
      text(class = info, content = "Último gancho: @ultimo")
      button(class = botao, on_click = voltar, text = "Voltar")
    }
  }
}
