screen(title = "Glacier - ciclo de vida (Rust)") {
  resources {
    link(rel = stylesheet, href = "examples/gvb/ciclo_vida_rust/estilo.gss")
  }

  container(class = tela) {
    column(class = "coluna coluna_2") {
      text(class = titulo, content = "Início")
      text(
        class = info,
        content = "Entradas no painel: @entradas · saídas: @saidas",
      )
      text(class = info, content = "Último gancho: @ultimo")
      button(class = botao, on_click = ir, text = "Ir para o painel")
    }
  }
}
