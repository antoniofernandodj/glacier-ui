// Painel de gatilhos para o exemplo `toasts`. Os toasts em si não fazem
// parte deste template — são construídos em Rust (ver examples/gva/toasts.rs)
// e sobrepostos pelo motor via GlacierUI::render_current.
component {
  resources {
    // O fundo da janela é do TEMA, não de um `background` na raiz: pintar
    // um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
    // em cada pixel da tela, e ela custa (ver AGENTS.md).
    link { rel: theme href: "examples/gvb/toasts/theme.json" }
  }

  container {
    padding: 30 align_x: center align_y: center width: fill height: fill

    column {
      spacing: 16 align_x: center

      text "Toasts (info / sucesso / aviso / erro)" {
        size: 22 bold: true color: #ECEFF4
      }

      text """
        Clique num botão para empilhar o toast correspondente; cada um some
        sozinho depois de alguns segundos.
      """ {
        size: 13 color: #D8DEE9
      }

      row {
        spacing: 10

        button {
          text: Info on_click: mostrar_info color: #5E81AC padding: "8 16"
        }

        button {
          text: Sucesso on_click: mostrar_sucesso color: #A3BE8C padding: "8 16"
        }

        button {
          text: Aviso on_click: mostrar_aviso color: #D08770 padding: "8 16"
        }

        button {
          text: Erro on_click: mostrar_erro color: #BF616A padding: "8 16"
        }
      }

      row {
        spacing: 10 align_x: center

        button {
          text: "Com título + duração longa" on_click: mostrar_com_titulo
          color: #B48EAD padding: "8 16"
        }

        button {
          text: "Empilhar vários" on_click: mostrar_varios color: #88C0D0
          padding: "8 16"
        }
      }

      rule { width: 440 }
      text "Toasts disparados: @total_disparados" { size: 14 color: #A3BE8C }
    }
  }
}
