// Painel de gatilhos para o exemplo `toasts`. Os toasts em si não fazem
// parte deste template — são construídos em Rust (ver examples/gva/toasts.rs)
// e sobrepostos pelo motor via GlacierUI::render_current.
screen(title = "Glacier - Toasts") {
  resources {
    link(rel = stylesheet, href = "examples/gvb/toasts/app.gss")
    // O fundo da janela é do TEMA, não de um `background` na raiz: pintar
    // um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
    // em cada pixel da tela, e ela custa (ver AGENTS.md).
    link(rel = theme, href = "examples/gvb/toasts/theme.json")
  }

  container(class = caixa) {
    column(class = coluna) {
      text(content = "Toasts (info / sucesso / aviso / erro)", class = titulo)

      text(
        content = """
          Clique num botão para empilhar o toast correspondente; cada um some
          sozinho depois de alguns segundos.
        """,
        class = texto,
      )

      row(class = linha) {
        button(text = Info, on_click = mostrar_info, class = botao)

        button(text = Sucesso, on_click = mostrar_sucesso, class = botao_2)

        button(text = Aviso, on_click = mostrar_aviso, class = botao_3)

        button(text = Erro, on_click = mostrar_erro, class = botao_4)
      }

      row(class = linha_2) {
        button(
          text = "Com título + duração longa", on_click = mostrar_com_titulo,
          class = botao_5,
        )

        button(
          text = "Empilhar vários", on_click = mostrar_varios, class = botao_6,
        )
      }

      rule(width = 440)
      text(content = "Toasts disparados: @total_disparados", class = texto_2)
    }
  }
}
