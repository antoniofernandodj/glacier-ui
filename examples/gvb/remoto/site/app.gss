:root {
  --fraco: #6C7086;
  --destaque: #F5E0DC;
}

.caixa {
  padding: 40;
  width: fill;
  height: fill;
  align_x: Center;
  align_y: Center;
}
.coluna { spacing: 14; align_x: Center; }
.titulo { size: 28; bold: true; color: var(--destaque); }
.rotulo { size: 14; color: var(--fraco); }
.botao { width: 200; padding: 10; }
