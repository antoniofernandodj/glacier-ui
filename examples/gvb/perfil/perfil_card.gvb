component {
  resources {
    link(rel = stylesheet, href = "examples/gvb/perfil/app.gss")
  }

  container(class = caixa_3) {
    column(align = Center, class = coluna_2) {
      image(
        source = "examples/gvb/perfil/avatar.png", width = 100, height = 100,
        clip = Circle,
      )

      column(align = Center, class = coluna_3) {
        text(content = "@user_name", class = titulo_2)
        text(content = "@user_role", class = texto)
      }

      button(
        text = @texto_botao, on_click = seguir_usuario,
        color = @btn_color, class = botao_3,
      )
    }
  }
}
