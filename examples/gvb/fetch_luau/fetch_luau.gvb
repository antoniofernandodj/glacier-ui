screen(title = "Glacier - fetch em Lua") {
  resources {
    link(rel = stylesheet, href = "examples/gvb/fetch_luau/app.gss")
    // O fundo da janela é do TEMA, não de um `background` na raiz: pintar
    // um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
    // em cada pixel da tela, e ela custa (ver AGENTS.md).
    link(rel = theme, href = "examples/gvb/fetch_luau/theme.json")

    script """

      -- `fetch(url)` SUSPENDE a corrotina (não bloqueia a UI) e retoma quando a
      -- resposta chega. Entre o clique e a resposta, o `ctx.status="carregando..."`
      -- abaixo já aparece na tela — prova de que a chamada é assíncrona.

      function init()
        ctx.status="pronto"
        ctx.resultado="(clique no botão)"
      end

      function buscar()
        ctx.status="carregando..."
        local res = fetch("https://api.ipify.org?format=json")
        if res.ok then
          ctx.resultado = res.body
          ctx.status="ok (" .. res.status .. ")"
        else
          ctx.resultado = res.error
          ctx.status="falhou"
        end
      end

    """
  }

  container(class = caixa) {
    column(class = "coluna coluna_2") {
      text(
        content = "fetch em Lua (async/await via corrotina)", class = titulo,
      )

      button(text = "Buscar meu IP", on_click = buscar, class = botao)

      text(content = "Status: @status", class = texto)
      text(content = "@resultado", class = texto_2)
    }
  }
}
