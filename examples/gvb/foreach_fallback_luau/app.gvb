screen(
  title = "Glacier - Pedidos (foreach + fallback, Luau)", size = "980 640",
  min_size = "760 480",
) {
  resources {
    link(rel = theme, href = "examples/gvb/foreach_fallback_luau/theme.json")
    link(rel = stylesheet, href = "examples/gvb/foreach_fallback_luau/app.gss")
    script(src = script.luau)

    // Um pedido. As props `acao`/`rotulo` dizem o que o botão faz nesta
    // etapa: a mesma peça serve às três colunas.
    component(name = CartaoPedido) {
      props {
        prop(name = id)
        prop(name = mesa)
        prop(name = prato)
        prop(name = acao)
        prop(name = rotulo)
      }

      column(class = pedido) {
        row(class = pedido-topo) {
          text(class = pedido-mesa, content = "Mesa @mesa")
          space
          text(class = pedido-id, content = "#@id")
        }

        text(class = pedido-prato, content = "@prato")
        button(class = pedido-botao, text = @rotulo, on_click = @acao:@id)
      }
    }

    // Uma etapa da cozinha. `itens` é o NOME da chave com a lista, e `vazio`
    // é o componente que aparece quando ela não tem pedido nenhum — ele
    // chega por atributo e vai direto para o `fallback` do <foreach>.
    component(name = Etapa) {
      props {
        prop(name = titulo)
        prop(name = total)
        prop(name = itens)
        prop(component = "", name = vazio)
        prop(name = acao)
        prop(name = rotulo)
      }

      column(class = etapa) {
        row(class = etapa-topo) {
          text(class = etapa-titulo, content = "@titulo")
          space
          badge(badge_text = @total)
        }

        rule

        foreach(items = @itens, var = p, fallback = @vazio) {
          CartaoPedido(
            id = @p.id, mesa = @p.mesa, prato = @p.prato, acao = @acao,
            rotulo = @rotulo,
          )
        }
      }
    }

    // Os fallbacks: um por etapa, cada um dizendo o que a lista vazia
    // significa ali.
    component(name = FilaVazia) {
      column(class = vazio) {
        text(class = vazio-titulo, content = "Nenhum pedido na fila")
        text(class = vazio-nota, content = "Clique em “Novo pedido”.")
      }
    }

    component(name = NadaNoFogo) {
      column(class = vazio) {
        text(class = vazio-titulo, content = "Fogão livre")
        text(class = vazio-nota, content = "Mande um pedido da fila.")
      }
    }

    component(name = NadaPronto) {
      column(class = vazio) {
        text(class = vazio-titulo, content = "Nada esperando o garçom")
      }
    }

    component(name = SemEntregas) {
      column(class = vazio) {
        text(class = vazio-titulo, content = "Nenhuma entrega ainda")
      }
    }
  }

  column(class = tela) {
    row(class = topo) {
      text(class = titulo, content = "Pedidos")
      space
      text(class = status, content = "@status")
    }

    row(class = acoes) {
      button(class = btn-prim, text = "Novo pedido", on_click = novo)
      button(class = btn, text = "Limpar tudo", on_click = limpar)
    }

    rule

    scrollable(class = rolagem) {
      column(class = corpo) {
        // A mesma Etapa três vezes, cada uma com a sua lista e o seu
        // componente de "vazio".
        row(class = etapas) {
          Etapa(
            titulo = "Na fila", total = @total_fila, itens = fila,
            vazio = FilaVazia,
            acao = preparar, rotulo = Preparar,
          )

          Etapa(
            titulo = "No fogo", total = @total_preparo, itens = preparo,
            vazio = NadaNoFogo, acao = finalizar, rotulo = Pronto,
          )

          Etapa(
            titulo = Prontos, total = @total_prontos, itens = prontos,
            vazio = NadaPronto, acao = entregar, rotulo = Entregar,
          )
        }

        // E o <foreach> direto na tela, com o fallback literal.
        column(class = historico) {
          text(class = secao, content = "Entregues")

          each @entregues as e (fallback = SemEntregas) {
            text(class = entregue, content = "#@e.id · mesa @e.mesa · @e.prato")
          }
        }
      }
    }
  }
}
