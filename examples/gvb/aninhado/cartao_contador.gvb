// Um componente (filho de `painel.gva`), não uma tela: a raiz é `<component>`.
// Ele agrupa declarações como o `<screen>` de uma janela, mas não aceita
// `title`/`size` — não há janela nenhuma a que eles se aplicariam. Aqui não há o
// que declarar, então a casca entra sozinha, sem `<resources>`.
component {
  resources {
    link(rel = stylesheet, href = "examples/gvb/aninhado/app.gss")
  }

  container(class = caixa) {
    column(align = Center, class = coluna) {
      text(content = "Contador: @valor", class = titulo)

      row(align = Center, class = coluna) {
        button(text = -, on_click = decrementar, class = botao)
        button(text = +, on_click = incrementar, class = botao_2)
      }
    }
  }
}
