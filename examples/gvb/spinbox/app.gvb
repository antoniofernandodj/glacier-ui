screen(title = "Glacier - SpinBox", size = "620 560") {
  resources {
    // O fundo da janela é do TEMA, não de um `background` na raiz: pintar
    // um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
    // em cada pixel da tela, e ela custa (ver AGENTS.md).
    link(rel = theme, href = "examples/gvb/spinbox/theme.json")

    style """
      .moldura   { border-width: 1; border-color: #89B4FA; border-radius: 6; padding: 4; }
      .campo_num { background: #11111B; }

      .coluna { padding: 28; spacing: 20; width: fill; height: fill; }
      .coluna_2 { spacing: 6; }
      .titulo { size: 22; bold: true; color: #CDD6F4; }
      .texto { size: 13; color: #A6ADC8; }
      .linha { spacing: 16; align_y: center; }
      .texto_2 { width: 110; color: #CDD6F4; }
      .destaque { size: 13; bold: true; color: #CDD6F4; }
      .linha_2 { spacing: 24; align_y: center; }
      .linha_3 { spacing: 10; align_y: center; }
      .texto_3 { color: #CDD6F4; }
      .formulario { spacing: 10; }
      .campo { width: 220; }

    """
  }

  column(class = coluna) {
    column(class = coluna_2) {
      text(content = "SpinBox — o QSpinBox do Qt", class = titulo)

      text(
        content = """
          O app só registra o template e semeia os valores iniciais. Somar,
          subtrair e saturar é do widget, que vem embutido na lib e escreve na
          chave de contexto que cada instância nomeia.
        """,
        class = texto,
      )
    }

    rule

    // Inteiro simples: a faixa satura em 1..10.
    row(class = linha) {
      text(content = "Quantidade", class = texto_2)
      spinbox(:value = quantidade, min = 1, max = 10)
      text(content = "chave 'quantidade' = @quantidade", class = texto)
    }

    // Decimal: as duas casas saem do próprio step, sem prop nova.
    row(class = linha) {
      text(content = "Preço", class = texto_2)
      spinbox(:value = preco, min = 0, max = 20, step = 0.25, width = 90)
      text(content = "chave 'preco' = @preco", class = texto)
    }

    // Passo grande e a outra forma: `− campo +`, o SpinBox do Qt Quick.
    row(class = linha) {
      text(content = "Zoom (%)", class = texto_2)
      spinbox(
        :value = zoom, min = 25, max = 400, step = 25, layout = inline,
        width = 72,
      )
      text(content = "chave 'zoom' = @zoom", class = texto)
    }

    rule

    // Duas instâncias da MESMA tag, lado a lado: chaves diferentes, nenhum
    // estado compartilhado. É o ponto do padrão "a chave vem por prop".
    text(content = "Duas instâncias independentes:", class = destaque)

    row(class = linha_2) {
      row(class = linha_3) {
        text(content = "Adultos", class = texto_3)
        spinbox(:value = adultos, min = 1, max = 9, width = 56)
      }

      row(class = linha_3) {
        text(content = "Crianças", class = texto_3)
        spinbox(:value = criancas, min = 0, max = 9, width = 56)
      }

      text(
        content = "@adultos adulto(s), @criancas criança(s)", class = texto,
      )
    }

    rule

    // 0.69: os dois alvos de estilo do widget, lado a lado com o de cima
    // (que não usa nenhum dos dois) para a diferença ficar visível.
    //
    //   class       -> a RAIZ do widget: a Row inteira, campo + degraus. É o
    //           que estilizar um QSpinBox significa no Qt, e antes da
    //           0.69 era um no-op silencioso aqui.
    //   field_class -> só o <input> de dentro.
    //
    // form_control põe o campo na cadeia de tabulação da <form> que o envolve
    // — sem ele o Tab pula o widget inteiro.
    text(content = "class × field_class (0.69):", class = destaque)

    form(name = reserva, on_submit = salvar, class = formulario) {
      row(class = linha) {
        text(content = "Mesas", class = texto_2)

        spinbox(
          :value = mesas, min = 1, max = 20, width = 56, class = moldura,
          field_class = campo_num, form_control = mesas,
        )

        text(
          content = "a moldura é a Row; o fundo escuro é só o campo",
          class = texto,
        )
      }

      row(class = linha) {
        text(content = "Observação", class = texto_2)

        input(
          :value = obs, form_control = obs,
          placeholder = "Tab vem parar aqui", class = campo,
        )
      }
    }
  }
}
