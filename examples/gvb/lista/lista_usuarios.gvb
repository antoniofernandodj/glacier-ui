screen(title = "Glacier - Lista de Membros") {
  resources {
    link(rel = stylesheet, href = "examples/gvb/lista/app.gss")
    // O fundo da janela é do TEMA, não de um `background` na raiz: pintar
    // um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
    // em cada pixel da tela, e ela custa (ver AGENTS.md).
    link(rel = theme, href = "examples/gvb/lista/theme.json")
    import(name = CartaoUsuario, from = "examples/gvb/lista/cartao_usuario.gvb")
  }

  container(class = caixa_3) {
    column(align = Center, class = coluna_2) {
      text(content = "Equipe (@total)", class = titulo_3)

      // O componente CartaoUsuario é instanciado uma vez por item do loop,
      // recebendo os campos de cada item como props.
      column(class = coluna_3) {
        each @usuarios as u {
          CartaoUsuario(
            nome = @u.nome, cargo = @u.cargo, inicial = @u.inicial,
            cor = @u.cor,
          )
        }
      }

      button(text = "Adicionar membro", on_click = adicionar, class = botao)
    }
  }
}
