/* Estilo que estava inline no markup. Os nomes são provisórios: renomeie
   cada classe pelo papel que ela tem na tela. */

.caixa {
  padding: 15;
  width: fill;
  background: #181825;
  border_radius: 12;
  border_width: 1;
  border_color: #313244;
}
.linha { spacing: 15; }
.caixa_2 {
  width: 50;
  height: 50;
  border_radius: 25;
  align_x: Center;
  align_y: Center;
}
.titulo { size: 22; bold: true; color: #11111B; }
.coluna { spacing: 3; }
.titulo_2 { size: 18; bold: true; color: #CDD6F4; }
.texto { size: 13; color: #A6ADC8; }
.caixa_3 { padding: 30; width: fill; height: fill; align_x: Center; }
.coluna_2 { spacing: 20; width: 420; }
.titulo_3 { size: 26; bold: true; color: #F5E0DC; }
.coluna_3 { spacing: 12; width: fill; }
.botao { color: #89B4FA; width: fill; padding: 12; }
