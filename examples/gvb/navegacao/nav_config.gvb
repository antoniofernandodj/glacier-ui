screen(title = "Glacier - Navegação · Configurações") {
  resources {
    link(rel = stylesheet, href = "examples/gvb/navegacao/app.gss")
    // O fundo da janela é do TEMA, não de um `background` na raiz: pintar
    // um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
    // em cada pixel da tela, e ela custa (ver AGENTS.md).
    link(rel = theme, href = "examples/gvb/navegacao/theme.json")
  }

  container(class = caixa) {
    column(class = "coluna coluna_5") {
      text(content = "Configurações", class = titulo)

      column(class = coluna_2) {
        text(content = "Nome de exibição", class = destaque)

        input(
          placeholder = "Seu nome...", :value = user_name,
          on_change = mudar_nome, class = campo,
        )
      }

      // Navegar para outra tela mantém o estado; o nome editado aparece no perfil
      button(text = "Ver perfil", navigate_to = perfil, class = botao)

      button(text = Voltar, navigate_back = true, class = botao_2)
    }
  }
}
