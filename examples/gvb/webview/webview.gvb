screen {
  title: Webview size: "360 160" min_size: "320 140"

  resources {
    link { rel: theme href: "examples/gvb/webview/theme.json" }
  }

  container {
    padding: 20 align_x: Center align_y: Center width: fill height: fill

    column {
      spacing: 16 align_x: Center

      text "Webview nativa" { size: 16 bold: true color: #ECEFF4 }

      button {
        text: "Abrir webview numa janela" on_click: abrir color: #88C0D0
        padding: "10 20"
      }
    }
  }
}
