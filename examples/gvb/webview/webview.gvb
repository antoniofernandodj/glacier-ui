screen(title = Webview, size = "360 160", min_size = "320 140") {
  resources {
    link(rel = stylesheet, href = "examples/gvb/webview/app.gss")
    link(rel = theme, href = "examples/gvb/webview/theme.json")
  }

  container(class = caixa) {
    column(class = coluna) {
      text(content = "Webview nativa", class = destaque)

      button(
        text = "Abrir webview numa janela", on_click = abrir, class = botao,
      )
    }
  }
}
