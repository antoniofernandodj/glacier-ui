screen(title = "Glacier - Data e Hora", size = "640 480") {
  resources {
    link(rel = stylesheet, href = "examples/gvb/timepicker/app.gss")
    // O fundo da janela é do TEMA, não de um `background` na raiz: pintar
    // um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
    // em cada pixel da tela, e ela custa (ver AGENTS.md).
    link(rel = theme, href = "examples/gvb/timepicker/theme.json")
  }

  column(class = coluna) {
    column(class = coluna_2) {
      text(content = "QDateEdit · QTimeEdit · QDateTimeEdit", class = titulo)

      text(
        content = """
          Um campo por valor, editado por seções: clique numa seção para
          selecioná-la (ela ganha o realce) e use ▴▾ para alterá-la. Cada seção
          vira dentro de si — mexer no minuto não empurra a hora.
        """,
        class = texto,
      )
    }

    rule

    row(class = linha) {
      text(content = "QDateEdit", class = texto_2)
      dateedit(value = data)
      text(content = "chave = @data", class = texto)
    }

    row(class = linha) {
      text(content = "QTimeEdit", class = texto_2)
      timeedit(:value = hora, seconds = true)
      text(content = "chave = @hora", class = texto)
    }

    row(class = linha) {
      text(content = "QDateTimeEdit", class = texto_2)
      datetimeedit(value = quando)
      text(content = "chave = @quando", class = texto)
    }

    rule

    // `format="br"` só troca a ORDEM das seções na tela; a chave continua
    // ISO, que é o que um backend espera.
    row(class = linha) {
      text(content = "Exibição BR", class = texto_2)
      dateedit(value = data_br, format = br)
      text(content = "mostra DD/MM/YYYY, grava @data_br", class = texto)
    }

    // Duas instâncias da MESMA tag: só uma seção da tela fica selecionada
    // por vez, e cada campo guarda o seu próprio valor.
    row(class = linha) {
      text(content = "Período", class = texto_2)
      timeedit(:value = de)
      text(content = "até", class = texto)
      timeedit(:value = ate)
      text(content = "@de — @ate", class = texto)
    }

    text(
      content = """
        Fevereiro: ponha a data em 2024-01-31 e suba o mês — o dia satura em 29
        (bissexto), como no QDateEdit.
      """,
      class = nota,
    )
  }
}
