screen(title = "Glacier - Pseudo-estados (:hover/:focus/:active/:disabled)") {
  resources {
    link(rel = stylesheet, href = "examples/gvb/pseudo_estados/app.gss")
    // Tema da janela (paleta do iced) — também elimina o fundo branco padrão.
    link(rel = theme, href = "examples/gvb/pseudo_estados/theme.json")
  }

  container(class = card) {
    column(class = stack) {
      text(
        class = title,
        content = "Pseudo-estados: :hover / :focus / :active / :disabled",
      )

      text(
        class = subtitle,
        content = """
          Passe o mouse, clique e compare com a versão desabilitada de cada
          widget.
        """,
      )

      // Button: :hover (passe o mouse) / :active (segure o clique) / :disabled
      column(class = "stack coluna") {
        text(class = label, content = "Button — hover / active / disabled")

        row(class = row) {
          button(class = btn, text = Enviar, on_click = enviar)
          button(class = btn, text = Desabilitado, disabled = true)
        }
      }

      // TextInput: :hover / :focus (clique para focar) / :disabled
      column(class = "stack coluna") {
        text(class = label, content = "TextInput — hover / focus / disabled")

        row(class = row) {
          input(
            class = "input campo", placeholder = "Clique aqui",
            :value = texto,
            on_change = texto,
          )

          input(
            class = "input campo", placeholder = Desabilitado,
            disabled = true,
          )
        }
      }

      // Select: só :hover (o iced não expõe Status::Disabled p/ pick_list)
      column(class = "stack coluna") {
        text(class = label, content = "Select — hover")

        select(
          class = select, width = 200, :options = cores, :value = cor_selecionada,
          on_change = cor_selecionada, placeholder = "Escolha uma cor",
        )
      }

      // Checkbox/Toggle: só o atributo `disabled` (visual padrão do tema)
      column(class = "stack coluna") {
        text(class = label, content = "Checkbox / Toggle — disabled")

        row(class = row) {
          checkbox(label = Ativo, :checked = marcado, on_toggle = marcado)

          checkbox(
            label = Desabilitado, :checked = marcado_travado,
            on_toggle = marcado_travado, disabled = true,
          )

          toggle(label = Ligado, :checked = ligado, on_toggle = ligado)

          toggle(
            label = Desabilitado, :checked = ligado_travado,
            on_toggle = ligado_travado, disabled = true,
          )
        }
      }
    }
  }
}
