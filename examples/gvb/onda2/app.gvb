screen(title = "Glacier - Onda 2", size = "880 660") {
  resources {
    link(rel = stylesheet, href = "examples/gvb/onda2/app.gss")
    // O fundo da janela é do TEMA, não de um `background` na raiz: pintar
    // um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
    // em cada pixel da tela, e ela custa (ver AGENTS.md).
    link(rel = theme, href = "examples/gvb/onda2/theme.json")
  }

  // A janela inteira: barra de ferramentas, abas, conteúdo rolável e
  // rodapé. É o esqueleto de uma QMainWindow — o <menubar> (que já era
  // nativo antes desta onda) entraria acima da <toolbar>.
  column(class = coluna) {
    // 8. ToolButton dentro de 9. ToolBar ===
    // Os botões são do app: `on_click="novo"` chega no update desta tela,
    // porque o ToolButton é um widget que DELEGA (prefixo `app:` no
    // template dele). A ToolBar não trata nada: só embrulha.
    toolbar {
      toolbutton(
        icon = "📄", text = Novo, layout = beside, tooltip = "Novo documento",
        on_click = novo,
      )

      toolbutton(
        icon = "💾", text = Salvar, layout = beside, tooltip = Salvar,
        on_click = salvar,
      )

      rule(direction = vertical)

      toolbutton(icon = "🗑", tooltip = "Excluir (só ícone)", on_click = excluir)
    }

    // 10. TabBar ===
    // `value` é o NOME da chave que recebe a aba clicada; `active` é o
    // VALOR atual dela, para o destaque. Os dois andam em par porque o
    // template não consegue ler a chave cujo nome está numa prop.
    container(class = caixa) {
      tabbar(:value = aba, active = @aba, :items = abas)
    }

    scrollable(class = rolagem) {
      column(class = coluna_2) {
        // ABA 1 — GroupBox
        if @aba == "grupos" {
          column(class = coluna_3) {
            text(
              content = """
                GroupBox — a moldura com título do Qt. O que ele desenha não vem
                de prop: vem do que está escrito entre as tags dele.
              """,
              class = texto,
            )

            // A forma caixa, com controles de verdade dentro —
            // inclusive outro builtin (SpinBox) aninhado.
            groupbox(title = Rede) {
              // slot NOMEADO: o conteúdo etiquetado `actions`
              // vai para a direita da linha do título, não
              // para dentro da moldura.
              template(slot = actions) {
                toolbutton(icon = "↻", tooltip = Recarregar, on_click = novo)
              }

              checkbox(
                label = "Usar proxy", :checked = usar_proxy, on_toggle = nada,
              )

              row(class = linha) {
                text(content = "Host", class = texto_2)
                input(:value = host, class = campo)
              }

              row(class = linha) {
                text(content = "Porta", class = texto_2)
                spinbox(:value = porta, min = 1, max = 65535, width = 90)
              }

              // ESTE é o ponto do slot: a ação sai de dentro do
              // GroupBox e chega no update da TELA, sem virar
              // `GroupBox::salvar_rede`.
              button(
                text = "Salvar rede", on_click = salvar_rede, class = botao,
              )
            }

            // A forma flat: título, linha e conteúdo solto. É o
            // QGroupBox::flat, para separar seções de uma tela
            // longa sem uma moldura por grupo.
            groupbox(title = Avançado, flat = true) {
              row(class = linha) {
                text(content = "Timeout (s)", class = texto_3)
                spinbox(
                  :value = timeout, min = 5, max = 300, step = 5, width = 90,
                )
              }
            }

            // Sem título sobra a moldura pura — que é o Frame.
            groupbox {
              text(content = "GroupBox sem title: só a caixa.", class = texto)
            }
          }
        }

        // ABA 2 — Frame
        else if @aba == "molduras" {
          column(class = coluna_3) {
            text(
              content = """
                Frame — a moldura sozinha, sem título e sem semântica de grupo. As
                três formas cobrem o QFrame::Shape: contorno, contraste ou nada.
              """,
              class = texto,
            )

            frame(shape = box) {
              text(
                content = """
                  shape="box" (default) — borda de 1px, o QFrame::Box.
                """,
                class = texto_4,
              )
            }

            frame(shape = filled) {
              text(
                content = """
                  shape="filled" — sem borda, com fundo próprio: o QFrame::Panel.
                  A caixa se destaca por contraste.
                """,
                class = texto_4,
              )
            }

            frame(shape = none) {
              text(
                content = """
                  shape="none" — nem borda nem fundo: o QFrame::NoFrame. Sobra o
                  padding e o spacing padronizados.
                """,
                class = texto_4,
              )
            }

            // Recipiente dentro de recipiente: o slot de um
            // builtin aceita outro builtin sem cerimônia.
            frame(shape = box, class = moldura) {
              text(content = "Frame com um Card dentro:", class = texto)

              card(title = Aninhado, subtitle = "slot dentro de slot") {
                text(
                  content = """
                    O conteúdo continua pertencendo a quem o escreveu.
                  """,
                  class = texto_5,
                )
              }
            }
          }
        }

        // ABA 3 — Card
        else if @aba == "cartoes" {
          column(class = coluna_3) {
            text(
              content = """
                Card — a superfície de um item: fundo próprio, cantos redondos e
                um cabeçalho com hierarquia. É a peça de uma lista ou grade, não
                de um formulário. O primeiro cartão tem rodapé (slot nomeado); os
                outros não pagam nem a linha.
              """,
              class = texto,
            )

            // Largura explícita por cartão é o que forma a grade:
            // o default é `fill`, para o cartão de coluna única.
            row(class = linha_2) {
              card(title = Servidor, subtitle = produção, class = cartao) {
                text(content = "uptime 31 dias", class = texto_5)
                badge(badge_text = online, badge_bg = #A6E3A1)

                // O rodapé só existe quando alguém o
                // preenche: os dois cartões ao lado não
                // pagam nem a linha divisória.
                template(slot = footer) {
                  button(text = Reiniciar, on_click = salvar, class = botao_2)
                }
              }

              card(title = Banco, subtitle = réplica, class = cartao) {
                text(content = "lag 240 ms", class = texto_5)
                badge(badge_text = atenção, badge_bg = #F9E2AF)
              }

              card(title = Fila, class = cartao) {
                text(content = "Cartão só com título.", class = texto_5)
                badge(badge_text = "3 pendentes", badge_bg = #89B4FA)
              }
            }

            card(subtitle = "cartão sem título, largura fill") {
              text(
                content = """
                  O cabeçalho aparece se houver título OU subtítulo — os dois são
                  independentes.
                """,
                class = texto_5,
              )
            }
          }
        }
      }
    }

    // 9. StatusBar ===
    // `message` é a esquerda (o showMessage do Qt); o conteúdo do slot
    // são os permanentes da direita (o addPermanentWidget). Clique nos
    // botões da barra de ferramentas para ver a mensagem mudar.
    statusbar(message = @status) {
      badge(badge_text = "onda 2", badge_bg = #89B4FA, badge_size = 11)
      text(content = "UTF-8", class = nota)
    }
  }
}
