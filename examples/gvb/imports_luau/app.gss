/* Estilo que estava inline no markup. Os nomes são provisórios: renomeie
   cada classe pelo papel que ela tem na tela. */

.caixa {
  padding: 24;
  align_x: Center;
  align_y: Center;
  width: fill;
  height: fill;
}
.coluna { spacing: 16; }
.titulo { size: 22; bold: true; color: #ECEFF4; }
.texto { size: 13; color: #81A1C1; }
.botao { color: #5E81AC; padding: 12 24; }
.texto_2 { size: 14; color: #EBCB8B; }
.texto_3 { size: 16; color: #A3BE8C; }
