screen(title = "Glacier - imports em Luau") {
  resources {
    link(rel = stylesheet, href = "examples/gvb/imports_luau/app.gss")
    // O fundo da janela é do TEMA, não de um `background` na raiz: pintar
    // um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
    // em cada pixel da tela, e ela custa (ver AGENTS.md).
    link(rel = theme, href = "examples/gvb/imports_luau/theme.json")
    script(src = script.luau)
  }

  container(class = caixa) {
    column(class = "coluna coluna_2") {
      text(
        content = "imports em Lua (require de bibliotecas)", class = titulo,
      )

      text(
        content = "a lógica de rede mora em net/http_client.luau",
        class = texto,
      )

      button(text = "Buscar meu IP", on_click = buscar, class = botao)

      button(text = "ola mundo!", on_click = ola_mundo, class = botao)

      text(content = "Status: @status", class = texto_2)
      text(content = "@resultado", class = texto_3)
    }
  }
}
