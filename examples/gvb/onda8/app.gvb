screen(title = "Glacier — Onda 8", size = "1000 720", min_size = "820 620") {
  resources {
    link(rel = stylesheet, href = "examples/gvb/onda8/app.gss")

    // ── Item 1: o `<dialog>` próprio, o QDialog ────────────────────────
    // Declaração, não widget: nada desenha aqui. O corpo é markup comum,
    // avaliado pelo mesmo `render_node` de qualquer tela, e o que o faz
    // aparecer é `on_click="dialog:editar_servico"`.
    //
    // Os campos escrevem em chaves `__dialog.*`, que o motor apaga no
    // fechamento — sem isso, a segunda abertura viria preenchida com o que
    // ficou da primeira.
    dialog(
      name = editar_servico, title = "Editar serviço",
      buttons = "Cancelar::|Salvar:salvar_servico:accept",
    ) {
      column(class = form) {
        column(class = campo) {
          text(class = rotulo, content = "Nome")

          textinput(
            :value = __dialog.nome, on_change = __dialog.nome,
            placeholder = api-gateway, class = preenche,
          )
        }

        row(class = campos) {
          column(class = campo) {
            text(class = rotulo, content = "Réplicas")

            // `width` do spinbox é a do CAMPO, e a row interna dele é
            // shrink: um `fill` aqui colapsa o número. Por isso ele fica
            // inline, e não no `.gss` como largura de caixa.
            spinbox(
              :value = __dialog.replicas, min = 1, max = 32, step = 1,
              width = 110,
            )
          }

          column(class = campo) {
            text(class = rotulo, content = "Ambiente")

            select(
              :options = ambientes, :value = __dialog.ambiente,
              on_change = __dialog.ambiente, class = preenche,
            )
          }
        }

        checkbox(
          label = "Reiniciar automaticamente", :checked = __dialog.restart,
          on_toggle = __dialog.restart,
        )
      }
    }

    // Um segundo diálogo, para mostrar que o encadeamento funciona: o botão
    // neutro daqui reabre o de cima. Sem corpo — é uma caixa de mensagem.
    dialog(
      name = remover_servico, title = "Remover serviço?",
      message = "A ação não pode ser desfeita.", icon = warning,
      dismissible = false,
      buttons = "Voltar:dialog:editar_servico:neutral|Remover:remover_confirmado:destructive",
    )
  }

  column(class = tela) {
    row(class = barra) {
      text(class = titulo, content = "Onda 8 — o diálogo que carrega markup")
      space(class = empurra)
      text(class = status, content = "@status")
    }

    tabs(:value = aba, active = @aba, :items = abas, class = corpo) {
      // ══ O modal com corpo ═══════════════════════════════════════════
      template(slot = modal) {
        column(class = painel) {
          text(
            class = lead,
            content = """
              Um QDialog de verdade: moldura do motor, corpo em markup.
            """,
          )

          row(class = acoes) {
            button(text = "Editar serviço", on_click = dialog:editar_servico)
            button(text = "Remover serviço", on_click = dialog:remover_servico)
            button(text = "Abrir do Rust (com corpo)", on_click = abrir_do_rust)
          }

          frame(shape = box, class = bloco) {
            column(class = campo) {
              text(class = rotulo, content = "Último salvamento")
              text(class = valor, content = "@ultimo")
            }
          }

          text(
            class = nota,
            content = """
              O corpo é avaliado no contexto do app — por isso um diálogo com
              campo não precisa de estado por instância. O que o usuário digita
              mora numa chave, como em qualquer campo de texto.
            """,
          )
        }
      }

      // ══ O wizard ════════════════════════════════════════════════════
      template(slot = wizard) {
        column(class = painel) {
          text(
            class = lead,
            content = """
              No Qt o QWizard É um QDialog — aqui ele é a soma da onda: páginas +
              botões + o passo numa chave.
            """,
          )

          frame(shape = box, class = bloco) {
            wizard(
              :value = passo, active = @passo, steps = "plano,dominio,revisao",
              titles = "Escolha o plano,Domínio,Revisão", valid = @passo_valido,
              on_finish = finalizar, on_cancel = cancelar_wizard,
            ) {
              template(slot = plano) {
                column(class = form) {
                  radiogroup(:value = plano, :items = planos)
                  text(class = rotulo, content = "Plano: @plano")
                }
              }

              template(slot = dominio) {
                column(class = form) {
                  text(class = rotulo, content = "Domínio do projeto")

                  textinput(
                    :value = dominio, on_change = dominio,
                    placeholder = exemplo.com.br, class = preenche,
                  )

                  // `equals=""`, não `empty`: no motor o `empty` pergunta se
                  // o valor é um array JSON vazio, não se a string está em
                  // branco.
                  if @dominio == "" {
                    text(
                      class = aviso,
                      content = """
                        Avançar fica travado enquanto isto estiver vazio — é o
                        QWizardPage::isComplete().
                      """,
                    )
                  }
                }
              }

              template(slot = revisao) {
                column(class = revisao) {
                  text(class = valor, content = "Plano: @plano")
                  text(class = valor, content = "Domínio: @dominio")
                }
              }
            }
          }

          text(
            class = nota,
            content = """
              Voltar fica INERTE no primeiro passo, não some: um botão que aparece
              e desaparece faz a fileira dançar. E avançar no último satura — dar
              a volta pareceria ter perdido o preenchido.
            """,
          )
        }
      }

      // ══ A roda de cor e o stackview ═════════════════════════════════
      template(slot = cor) {
        row(class = colunas) {
          column(class = painel) {
            text(class = lead, content = "colorwheel avulso")
            colorwheel(:value = cor, size = 230)

            row(class = acoes) {
              container(class = amostra, background = @cor)

              textinput(
                :value = cor__hex, on_change = cor_digitada,
                placeholder = #rrggbb,
                class = campo-hex,
              )
            }
          }

          column(class = painel) {
            text(class = lead, content = "stackview — o QStackedWidget")

            row(class = acoes) {
              button(text = Resumo, on_click = painel:resumo)
              button(text = Detalhe, on_click = painel:detalhe)
            }

            frame(shape = box, class = bloco) {
              stackview(active = @painel) {
                template(slot = resumo) {
                  text(
                    class = valor,
                    content = """
                      A página escolhida por NOME, não por posição numa escada de
                      condicionais.
                    """,
                  )
                }

                template(slot = detalhe) {
                  column(class = revisao) {
                    text(
                      class = valor,
                      content = """
                        Trocar a ordem de dois template slot não muda nada.
                      """,
                    )

                    text(class = rotulo, content = "Cor atual: @cor")
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
