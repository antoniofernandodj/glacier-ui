screen(title = "Glacier - Diálogos") {
  resources {
    link(rel = stylesheet, href = "examples/gvb/dialogs/app.gss")
    // O fundo da janela é do TEMA, não de um `background` na raiz: pintar
    // um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
    // em cada pixel da tela, e ela custa (ver AGENTS.md).
    link(rel = theme, href = "examples/gvb/dialogs/theme.json")
  }

  // Painel de gatilhos para o exemplo `dialogs`. Os diálogos em si não fazem
  // parte deste template — são construídos em Rust (ver examples/gva/dialogs/main.rs)
  // e sobrepostos pelo motor via GlacierUI::render_current.
  container(class = caixa) {
    column(class = coluna) {
      text(content = "Diálogos (estilo QMessageBox)", class = titulo)

      text(
        content = "Clique num botão para abrir o diálogo correspondente.",
        class = texto,
      )

      row(class = linha) {
        button(text = Information, on_click = mostrar_info, class = botao)

        button(text = Warning, on_click = mostrar_warning, class = botao_2)

        button(text = Error, on_click = mostrar_error, class = botao_3)
      }

      row(class = linha) {
        button(text = Question, on_click = mostrar_question, class = botao_4)

        button(
          text = "Confirm (com detalhe)", on_click = mostrar_confirm,
          class = botao_4,
        )
      }

      rule(width = 400)
      text(content = "Último resultado: @resultado", class = texto_2)
    }
  }
}
