screen(title = "Glacier - Janela principal", size = "520 400") {
  resources {
    link(rel = stylesheet, href = "examples/gvb/janelas_glacier/app.gss")
    // O fundo da janela é do TEMA, não de um `background` na raiz: pintar
    // um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
    // em cada pixel da tela, e ela custa (ver AGENTS.md).
    link(rel = theme, href = "examples/gvb/janelas_glacier/theme_painel.json")
  }

  container(class = caixa) {
    column(align = Center, class = coluna_2) {
      text(content = "Painel (Rust)", class = titulo_2)
      text(content = "Contador desta janela: @valor", class = texto_3)
      text(content = "Broadcasts recebidos: @recebidos", class = texto_4)

      button(text = Incrementar, on_click = incrementar, class = botao_4)

      text(content = "Abrir nova janela:", class = texto_5)

      row(align = Center, class = linha) {
        button(text = "Component Rust", on_click = nova_rust, class = botao_5)

        button(text = "XML (Lua)", on_click = nova_xml, class = botao_6)
      }
    }
  }
}
