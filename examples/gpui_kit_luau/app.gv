screen(title = "Glacier — fase gpui-kit (Luau)", size = "920 680", min_size = "760 520") {
  resources {
    link(rel = stylesheet, href = "examples/gpui_kit_luau/app.gss")
    script(src = "scripts/app.luau")
  }

  // Atalhos globais: moram no layout e não desenham nada.
  shortcut(key = ctrl+k, on_press = alternar_paleta)
  shortcut(key = escape, on_press = fechar_paleta)

  column(class = tela) {
    row(class = topo) {
      text("Serviços", class = titulo)
      // split button: a ação principal + as alternativas (JSON e markup somados)
      dropdownbutton(label = Deploy, on_click = deploy, :items = deploy_extras) {
        menuseparator
        menuitem(label = "Simular uma falha", on_click = "executar:erro")
      }
      // sem on_click: o botão inteiro abre o menu
      dropdownbutton(label = Ver, variant = flat) {
        menuitem(label = "Abrir a paleta", on_click = alternar_paleta)
        menuitem(label = "Fechar o aviso", on_click = fechar_aviso)
      }
      space
      text("paleta de comandos:", class = dica)
      kbd("Ctrl+K")
    }

    // O aviso só existe enquanto `aviso` tiver texto; o × apaga a chave.
    alert("{aviso}", variant = @aviso_tipo, description = @aviso_detalhe, on_close = fechar_aviso, if = @aviso, not_equals = "")

    // A paleta: aparece por cima do conteúdo, no fluxo da coluna.
    column(class = paleta, if = @paleta) {
      command(:items = comandos, :value = busca, filter = @busca, on_select = executar, placeholder = "Buscar um comando…")
      row(class = rodape_paleta) {
        kbd("Esc")
        text("fecha", class = dica)
      }
    }

    row(class = corpo) {
      column(class = coluna) {
        text("Serviço selecionado", class = secao)
        descriptionlist(:items = ficha)

        // campo com acessórios: uma moldura só; o erro fica com o `field`
        field(label = "Domínio", description = "sem https:// e sem caminho", error = @erro_dominio) {
          inputgroup(prefix = "https://") {
            input(:value = dominio, on_change = editar_dominio, placeholder = "app.exemplo.com")
            template(slot = suffix) {
              button("Copiar", class = copiar, on_click = "clipboard:dominio")
            }
          }
        }
        field(label = "Réplicas por região", label_position = left) {
          inputgroup(suffix = "por região") {
            input(:value = por_regiao, on_change = por_regiao)
          }
        }
      }
      column(class = coluna) {
        text("Atalhos", class = secao)
        descriptionlist(:items = atalhos, layout = vertical)
        text("último comando: {ultimo}", class = nota)
      }
    }
  }
}
