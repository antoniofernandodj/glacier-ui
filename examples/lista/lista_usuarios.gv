<screen title="Glacier - Lista de Membros">
  <resources>
    <import name="CartaoUsuario" from="examples/lista/cartao_usuario.gv" />
  </resources>

  <container padding="30" width="fill" height="fill" background="#11111B" align_x="Center">
    <column spacing="20" width="420" align="Center">
      <text size="26" bold="true" color="#F5E0DC">Equipe ({total})</text>

      <!-- O componente CartaoUsuario é instanciado uma vez por item do loop,
         recebendo os campos de cada item como props. -->
      <column spacing="12" width="fill">
        <foreach items="usuarios" var="u">
          <CartaoUsuario nome="{u.nome}" cargo="{u.cargo}" inicial="{u.inicial}" cor="{u.cor}" />
        </foreach>
      </column>

      <button
        text="Adicionar membro"
        on_click="adicionar"
        color="#89B4FA"
        width="fill"
        padding="12"
      />
    </column>
  </container>
</screen>
