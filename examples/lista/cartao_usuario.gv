<component>
  <!-- O contrato do componente. Até a 0.60 isto era um comentário ("recebe as
    props nome, cargo, inicial e cor") que nada verificava — e um typo no uso
    (`nomee="{u.nome}"`) não dava erro nenhum: a prop errada não casava com
    `{nome}`, e o `{nome}` do template caía para o contexto de baixo. Declarado
    aqui, o mesmo typo vira erro citando as props que existem.

    `cor` tem `default`, então é opcional; as outras três não têm, então são
    obrigatórias. -->
  <props>
    <prop name="nome" />
    <prop name="cargo" />
    <prop name="inicial" />
    <prop name="cor" default="#89B4FA" />
  </props>

  <container
    padding="15"
    width="fill"
    background="#181825"
    border_radius="12"
    border_width="1"
    border_color="#313244"
  >
    <row spacing="15" align="Center">
      <!-- Avatar circular com a inicial do nome -->
      <container
        width="50"
        height="50"
        background="{cor}"
        border_radius="25"
        align_x="Center"
        align_y="Center"
      >
        <text size="22" bold="true" color="#11111B">{inicial}</text>
      </container>

      <column spacing="3">
        <text size="18" bold="true" color="#CDD6F4">{nome}</text>
        <text size="13" color="#A6ADC8">{cargo}</text>
      </column>
    </row>
  </container>
</component>
