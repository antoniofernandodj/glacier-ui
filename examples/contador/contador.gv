<screen title="Glacier - Contador">
  <resources>
    <!-- O fundo da janela é do TEMA, não de um `background` na raiz: pintar
         um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
         em cada pixel da tela, e ela custa (ver AGENTS.md). -->
    <link rel="theme" href="examples/contador/theme.json" />
  </resources>

  <container
    padding="20"
    align_x="Center"
    align_y="Center"
    width="fill"
    height="fill"
  >
    <column spacing="20" align="Center">
      <text size="28" bold="true" color="#ECEFF4">Valor do Contador: {contador}</text>
      <row spacing="15" align="Center">
        <button text="Diminuir" on_click="decrementar" color="#BF616A" padding="10 20" />
        <button text="Aumentar" on_click="incrementar" color="#A3BE8C" padding="10 20" />
      </row>
    </column>
  </container>
</screen>
