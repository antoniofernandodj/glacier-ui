<screen title="Glacier - ciclo de vida (painel)">
  <resources>
    <link rel="stylesheet" href="examples/ciclo_vida_rust/estilo.gss" />
  </resources>

  <container class="tela">
    <column class="coluna" align="Center">
      <text class="titulo">Painel</text>
      <text class="info">Entradas: {entradas} · saídas: {saidas}</text>
      <text class="info">Último gancho: {ultimo}</text>
      <button class="botao" on_click="voltar">Voltar</button>
    </column>
  </container>
</screen>
