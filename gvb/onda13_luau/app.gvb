screen {
  title: "Glacier — Onda 13 (formas, Luau)" size: "920 700"
  min_size: "800 560"

  resources {
    link { rel: stylesheet href: "examples/onda13_luau/app.gss" }
    script { src: "scripts/app.luau" }
  }

  column {
    class: tela

    row {
      class: barra

      text "Onda 13 em Luau — formas com dado do script" { class: titulo }
      space { class: empurra }
      text "@status" { class: status }
    }

    row {
      class: corpo

      column {
        class: coluna

        text "agulha girada pelo script" { class: secao }

        text """
          Clique "girar / parar": o `every(60, …)` do prelúdio incrementa o
          ângulo e o script recalcula a ponta da agulha e o setor varrido.
          Nenhuma linha aqui desenha — só escreve chaves.
        """ {
          class: nota
        }

        canvas {
          class: mostrador

          circle { cx: 110 cy: 110 r: 92 class: aro }
          arc { cx: 110 cy: 110 r: 92 start: -90 sweep: @varrido class: setor }
          line { x1: 110 y1: 110 x2: @ponta_x y2: @ponta_y class: agulha }
          circle { cx: 110 cy: 110 r: 6 class: miolo }
          text "ângulo: @angulo°" { x: 70 y: 222 class: rotulo }
        }

        row {
          class: acoes

          button { text: "girar / parar" on_click: alternar }
          button { text: zerar on_click: zerar class: btn-fraco }
        }
      }

      column {
        class: coluna

        text "QWhatsThis" { class: secao }

        text """
          Ligue o modo e paire sobre os botões: a ajuda `whats_this` fica no
          lugar do `tooltip`.
        """ {
          class: nota
        }

        row {
          class: acoes

          button {
            text: "modo ajuda" on_click: whatsthis:toggle
            whats_this: "Alterna o modo pegajoso. Ligado, o hover mostra esta ajuda."
          }

          button {
            text: "girar / parar" on_click: alternar tooltip: "tooltip normal"
            whats_this: "Liga ou desliga o giro da agulha (um every() do prelúdio)."
          }
        }
      }
    }
  }
}
