// Teste de realce: um `script` e um `style` com o código escrito AQUI, no
// próprio arquivo, em vez de `script { src: "…" }` apontando para um .luau.
// Rode com:
//   WGPU_BACKEND=gl cargo run --example gvb_run -- gvb/inline_script/app.gvb
screen {
  title: "Glacier — script inline (.gvb)" size: "560 420"

  resources {
    style """
      /* GSS inline: o realce tem de pintar propriedades e cores. */
      :root { --fundo: #1E1E2E; --texto: #CDD6F4; --acento: #89B4FA; }

      .tela   { padding: 20; spacing: 14; width: fill; height: fill; }
      .titulo { size: 22; bold: true; color: var(--texto); }
      .valor  { size: 40; bold: true; color: var(--acento); }
      .nota   { size: 12; color: #7F849C; }
      .botoes { spacing: 10; }
    """

    script """
      --!strict
      -- Comentário de linha. Um arroba solto (a@b.com) NÃO é interpolação aqui:
      -- o corpo de `script` é cru.

      --[[ Comentário
           de bloco ]]

      local PASSO: number = 1
      local LIMITE = 10
      local NOMES = { "zero", "um", "dois", "três", "quatro" }
      local AJUDA = [[texto em
        colchetes longos, com "aspas" e 'apóstrofos']]

      -- Funções locais, tabelas, operadores e strings com escape.
      local function rotulo(n: number): string
        if n < 0 then
          return "negativo"
        elseif n == 0 then
          return "zero"
        elseif n <= #NOMES then
          return NOMES[n + 1] or tostring(n)
        end
        return string.format("%d (%s)", n, n % 2 == 0 and "par" or "ímpar")
      end

      local function soma(lista: { number }): number
        local total = 0
        for _, v in ipairs(lista) do
          total += v
        end
        return total
      end

      -- Ciclo de vida: o motor chama `init` ao abrir a tela.
      function init()
        ctx.contador = 0
        ctx.rotulo = rotulo(0)
        ctx.email = "contato@exemplo.com"
        ctx.soma = soma({ 1, 2, 3, 4.5, 0x10, 1e2 })
      end

      -- Ações: nomes citados em `on_click` no markup.
      function incrementar()
        local novo = math.min(ctx.contador + PASSO, LIMITE)
        ctx.contador = novo
        ctx.rotulo = rotulo(novo)
      end

      function decrementar()
        ctx.contador = math.max(ctx.contador - PASSO, -LIMITE)
        ctx.rotulo = rotulo(ctx.contador)
      end

      function zerar()
        ctx.contador = 0
        ctx.rotulo = rotulo(0) .. " (zerado)\t✓"
      end

      function mostrar_ajuda()
        ctx.rotulo = AJUDA:gsub("%s+", " ")
      end
    """
  }

  column {
    class: tela

    text "Script inline em .gvb" { class: titulo }
    text "@contador" { class: valor }
    text "por extenso: @rotulo" { class: nota }
    text "soma da tabela: @soma — @email" { class: nota }

    row {
      class: botoes

      button { text: "−" on_click: decrementar }
      button { text: "+" on_click: incrementar }
      button { text: "Zerar" on_click: zerar }
      button { text: "Ajuda" on_click: mostrar_ajuda }
    }
  }
}
