screen {
  title: "Glacier - ciclo de vida (Rust)"

  resources {
    link { rel: stylesheet href: "examples/ciclo_vida_rust/estilo.gss" }
  }

  container {
    class: tela

    column {
      class: coluna align: Center

      text "Início" { class: titulo }
      text "Entradas no painel: @entradas · saídas: @saidas" { class: info }
      text "Último gancho: @ultimo" { class: info }
      button "Ir para o painel" { class: botao on_click: ir }
    }
  }
}
