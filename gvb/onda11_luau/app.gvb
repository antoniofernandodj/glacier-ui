screen {
  title: "Glacier — Onda 11 (Luau)" size: "1080 760" min_size: "900 640"

  resources {
    link { rel: stylesheet href: "examples/onda11_luau/app.gss" }
    script { src: "scripts/app.luau" }
  }

  column {
    class: tela

    row {
      class: barra

      text "Onda 11 em Luau — o que fica por cima" { class: titulo }
      space { class: empurra }
      text "@status" { class: status }
    }

    tabbar { items: abas value: aba selected: @aba class: abas }

    // ══ 1 + 2: Stack, NotificationDot, SplashScreen ══════════════════
    if @aba == "empilhamento" {
      scrollable {
        column {
          class: corpo-rolavel

          text """
            O `<stack>` empilha filhos no mesmo espaço. Um filho com `anchor=`
            gruda num dos nove cantos sem precisar de coordenada; um filho com
            `x=`/`y=` usa posição livre em pixels (`pin`). Os dois são atributos
            de MARKUP — nenhum dos dois pede uma linha de script.
          """ {
            class: lead
          }

          column {
            class: "bloco bloco-fill"

            text "SplashScreen" { class: secao }

            text """
              Cobre o conteúdo principal enquanto `show` for verdadeiro. Sem
              animação — um `<reveal>` não interpola um filho `height="fill"` (a
              armadilha do `Length::Fill`, ver `PRIMITIVAS.md`).
            """ {
              class: nota
            }

            button { text: "reabrir a splash" on_click: abrir_splash }

            SplashScreen {
              show: @carregando height: 220 class: demo-splash

              container {
                class: conteudo-real

                text "O conteúdo principal — estava aqui o tempo todo" {
                  class: secao
                }
              }

              template {
                slot: splash

                column {
                  class: splash-conteudo

                  text "Glacier UI" { class: splash-titulo }
                  spinner
                  button { text: "pronto — fechar" on_click: fechar_splash }
                }
              }
            }
          }

          row {
            class: linha

            column {
              class: bloco

              text "anchor — nove cantos" { class: secao }

              stack {
                class: demo-anchor

                container { class: demo-fundo }
                text "TL" { anchor: top-left class: marca }
                text "T" { anchor: top class: marca }
                text "TR" { anchor: top-right class: marca }
                text "L" { anchor: left class: marca }
                text "C" { anchor: center class: "marca marca-centro" }
                text "R" { anchor: right class: marca }
                text "BL" { anchor: bottom-left class: marca }
                text "B" { anchor: bottom class: marca }
                text "BR" { anchor: bottom-right class: marca }
              }
            }

            column {
              class: bloco

              text "x/y — posição livre" { class: secao }

              stack {
                class: demo-anchor

                container { class: demo-fundo }
                text "14,10" { x: 14 y: 10 class: marca }
                text "120,70" { x: 120 y: 70 class: marca }
                text "40,130" { x: 40 y: 130 class: marca }
              }
            }

            column {
              class: bloco

              text "NotificationDot" { class: secao }

              row {
                class: notif-linha

                NotificationDot {
                  show: @tem_notificacao

                  container {
                    class: icone-sino

                    text "🔔" { class: icone-emoji }
                  }
                }

                button { text: alternar on_click: alternar_notificacao }
              }

              text """
                `<stack>` (a primeira camada) + `anchor="top-right"` (a segunda)
                — sem `pin`, porque um canto não precisa saber o tamanho do
                ícone. tem_notificacao: @tem_notificacao
              """ {
                class: nota
              }
            }
          }
        }
      }
    }

    // ══ 3: MdiArea ════════════════════════════════════════════════════
    if @aba == "mdi" {
      column {
        class: corpo

        text """
          Duas janelas nomeiam QUATRO chaves cada (`x_var`/`y_var`/`w_var`/
          `h_var` — a forma curta `x`/`y`/`w`/`h` também funciona, mas colide de
          NOME com o `x`/`y` do `<stack>` acima). Arraste a barra de título para
          mover; arraste o canto inferior direito para redimensionar — o MESMO
          `grip::Alvo::Ponto`, com limites diferentes. O arrasto inteiro é do
          MOTOR: nenhuma das quatro chaves tem função Luau nenhuma por trás.
        """ {
          class: lead
        }

        mdiarea {
          class: mdi-fundo

          mdisubwindow {
            title: Editor x_var: editor_x y_var: editor_y w_var: editor_w
            h_var: editor_h

            column {
              class: janela-corpo

              text "Editor" { class: secao }
              text "editor_x = @editor_x editor_y = @editor_y" { class: chave }
              text "editor_w = @editor_w editor_h = @editor_h" { class: chave }
            }
          }

          mdisubwindow {
            title: Console x_var: console_x y_var: console_y w_var: console_w
            h_var: console_h default_w: 300 default_h: 180

            column {
              class: janela-corpo

              text "Console" { class: secao }

              text """
                Esta janela não recebeu seed nem para `w`/`h` — nasce em
                `default_w`/`default_h` (300×180), do markup.
              """ {
                class: nota
              }
            }
          }
        }
      }
    }

    // ══ 4–8: o troco esvaziado ════════════════════════════════════════
    if @aba == "troco" {
      scrollable {
        column {
          class: corpo-rolavel

          text """
            Cinco widgets pequenos que a §6.3 do `PLANO_WIDGETS.md` guardava
            como "não abre rodada sozinho" — a Onda 11 passou no lugar deles.
          """ {
            class: lead
          }

          row {
            class: linha

            column {
              class: bloco

              text "QrCode" { class: secao }
              qrcode { content: @qr_texto width: 120 height: 120 }

              textinput {
                value: qr_texto on_change: qr_texto
                placeholder: "conteúdo do QR"
              }

              text """
                `on_change="qr_texto"` sem função Luau nenhuma com esse nome: o
                `dispatch` cai no binding legado `ctx.qr_texto = value` sozinho.
              """ {
                class: nota
              }
            }

            column {
              class: bloco

              text "Chip" { class: secao }

              row {
                class: chip-linha

                Chip {
                  for-each: tags var: tag label: @tag
                  on_remove: remover_tag:@tag
                }
              }

              text """
                `remover_tag:@tag` chama `remover_tag(tag)` — a convenção
                `nome:sufixo` do dispatcher Luau, a mesma que um componente Rust
                faria fatiando a string à mão.
              """ {
                class: nota
              }
            }

            column {
              class: bloco

              text "Skeleton" { class: secao }

              column {
                class: skeleton-lista

                Skeleton { width: 220 height: 14 }
                Skeleton { width: 180 height: 14 }
                Skeleton { width: fill height: 60 radius: 8 }
              }
            }
          }

          row {
            class: linha

            column {
              class: "bloco bloco-largo"

              text "CommandLink" { class: secao }

              CommandLink {
                title: "Instalação típica"
                description: "Recomendado para a maioria dos usuários"
                on_click: instalar_tipica
              }

              CommandLink {
                title: "Instalação customizada"
                description: "Escolha componentes individualmente"
                on_click: instalar_custom
              }
            }

            column {
              class: bloco

              text "RoundButton" { class: secao }

              RoundButton {
                text: + color: #89B4FA on_click: novo_item size: 48
              }
            }
          }
        }
      }
    }
  }
}
