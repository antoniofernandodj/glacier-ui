screen {
  title: "Glacier - Formulário (Reactive Forms)"

  resources {
    // O fundo da janela é do TEMA, não de um `background` na raiz: pintar
    // um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
    // em cada pixel da tela, e ela custa (ver AGENTS.md).
    link { rel: theme href: "examples/formulario_login/theme.json" }
  }

  // Formulário de login: `Form` agrupa os `TextInput`s ligados aos
  // `FormControl`s do componente (por `formControl`, veja formulario_login.rs).
  // Enter em qualquer campo sempre dispara `onSubmit`; se houver um próximo
  // campo, o foco também avança para ele — dá para preencher e submeter o
  // formulário inteiro sem tocar no mouse.
  container {
    padding: 24 width: fill height: fill

    column {
      spacing: 16 width: 360

      text "Entrar" { size: 24 bold: true color: #ECEFF4 }

      form {
        on_submit: entrar name: login width: fill

        column {
          spacing: 6 width: fill

          text "Usuário" { size: 13 color: #D8DEE9 }

          input {
            form_control: username placeholder: "ao menos 3 caracteres"
            width: fill
          }

          text "@erro_username" { size: 12 color: #BF616A }
        }

        column {
          spacing: 6 width: fill

          text "Senha" { size: 13 color: #D8DEE9 }

          input {
            form_control: password placeholder: "ao menos 6 caracteres"
            secure: true width: fill
          }

          text "@erro_password" { size: 12 color: #BF616A }
        }

        button { text: Entrar on_click: entrar color: #5E81AC width: fill }
      }

      text "@status" { size: 13 color: #A3BE8C }
    }
  }
}
