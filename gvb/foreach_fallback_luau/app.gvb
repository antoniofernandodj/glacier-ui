screen {
  title: "Glacier - Pedidos (foreach + fallback, Luau)" size: "980 640"
  min_size: "760 480"

  resources {
    link { rel: theme href: "examples/foreach_fallback_luau/theme.json" }
    link { rel: stylesheet href: "examples/foreach_fallback_luau/app.gss" }
    script { src: script.luau }

    // Um pedido. As props `acao`/`rotulo` dizem o que o botão faz nesta
    // etapa: a mesma peça serve às três colunas.
    component {
      name: CartaoPedido

      props {
        prop { name: id }
        prop { name: mesa }
        prop { name: prato }
        prop { name: acao }
        prop { name: rotulo }
      }

      column {
        class: pedido

        row {
          class: pedido-topo

          text "Mesa @mesa" { class: pedido-mesa }
          space
          text "#@id" { class: pedido-id }
        }

        text "@prato" { class: pedido-prato }
        button { class: pedido-botao text: @rotulo on_click: @acao:@id }
      }
    }

    // Uma etapa da cozinha. `itens` é o NOME da chave com a lista, e `vazio`
    // é o componente que aparece quando ela não tem pedido nenhum — ele
    // chega por atributo e vai direto para o `fallback` do <foreach>.
    component {
      name: Etapa

      props {
        prop { name: titulo }
        prop { name: total }
        prop { name: itens }
        prop { component: "" name: vazio }
        prop { name: acao }
        prop { name: rotulo }
      }

      column {
        class: etapa

        row {
          class: etapa-topo

          text "@titulo" { class: etapa-titulo }
          space
          badge { badge_text: @total }
        }

        rule

        foreach {
          items: @itens var: p fallback: @vazio

          CartaoPedido {
            id: @p.id mesa: @p.mesa prato: @p.prato acao: @acao rotulo: @rotulo
          }
        }
      }
    }

    // Os fallbacks: um por etapa, cada um dizendo o que a lista vazia
    // significa ali.
    component {
      name: FilaVazia

      column {
        class: vazio

        text "Nenhum pedido na fila" { class: vazio-titulo }
        text "Clique em “Novo pedido”." { class: vazio-nota }
      }
    }

    component {
      name: NadaNoFogo

      column {
        class: vazio

        text "Fogão livre" { class: vazio-titulo }
        text "Mande um pedido da fila." { class: vazio-nota }
      }
    }

    component {
      name: NadaPronto

      column {
        class: vazio

        text "Nada esperando o garçom" { class: vazio-titulo }
      }
    }

    component {
      name: SemEntregas

      column {
        class: vazio

        text "Nenhuma entrega ainda" { class: vazio-titulo }
      }
    }
  }

  column {
    class: tela

    row {
      class: topo

      text "Pedidos" { class: titulo }
      space
      text "@status" { class: status }
    }

    row {
      class: acoes

      button { class: btn-prim text: "Novo pedido" on_click: novo }
      button { class: btn text: "Limpar tudo" on_click: limpar }
    }

    rule

    scrollable {
      class: rolagem

      column {
        class: corpo

        // A mesma Etapa três vezes, cada uma com a sua lista e o seu
        // componente de "vazio".
        row {
          class: etapas

          Etapa {
            titulo: "Na fila" total: @total_fila itens: fila vazio: FilaVazia
            acao: preparar rotulo: Preparar
          }

          Etapa {
            titulo: "No fogo" total: @total_preparo itens: preparo
            vazio: NadaNoFogo acao: finalizar rotulo: Pronto
          }

          Etapa {
            titulo: Prontos total: @total_prontos itens: prontos
            vazio: NadaPronto acao: entregar rotulo: Entregar
          }
        }

        // E o <foreach> direto na tela, com o fallback literal.
        column {
          class: historico

          text "Entregues" { class: secao }

          each @entregues as e {
            fallback: SemEntregas

            text "#@e.id · mesa @e.mesa · @e.prato" { class: entregue }
          }
        }
      }
    }
  }
}
