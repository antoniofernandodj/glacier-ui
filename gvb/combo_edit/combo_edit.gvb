screen {
  title: "Glacier - ComboEdit (servidores salvos)"

  resources {
    // O fundo da janela é do TEMA, não de um `background` na raiz: pintar
    // um nó `fill/fill` com a cor que o tema já pinta é uma camada a mais
    // em cada pixel da tela, e ela custa (ver AGENTS.md).
    link { rel: theme href: "examples/combo_edit/theme.json" }
  }

  // `<comboedit>`: dropdown editável (combo_box do iced). Digite um servidor
  // novo à vontade, ou escolha um dos já salvos na lista — escolher um
  // preenche o token sozinho (veja `servidor_selecionado` em main.rs).
  container {
    padding: 24 width: fill height: fill

    column {
      spacing: 16 width: 420

      text "Servidores salvos" { size: 24 bold: true color: #ECEFF4 }

      column {
        spacing: 6 width: fill

        text "Servidor" { size: 13 color: #D8DEE9 }

        comboedit {
          options: servidores value: url
          placeholder: "https://servidor.exemplo.com" on_change: url_changed
          on_select: servidor_selecionado width: fill
        }
      }

      column {
        spacing: 6 width: fill

        text "Token" { size: 13 color: #D8DEE9 }

        input {
          value: token on_change: token_changed placeholder: "token de acesso"
          secure: true width: fill
        }
      }

      button {
        text: "Salvar este par" on_click: salvar color: #5E81AC width: fill
      }

      rule
      text "Pares salvos:" { size: 13 color: #D8DEE9 }
      text "@pares_txt" { size: 12 color: #A3BE8C }
    }
  }
}
