screen {
  title: "Glacier — séries múltiplas (Luau)" size: "980 720"
  min_size: "840 580"

  resources {
    link { rel: stylesheet href: "examples/series_multiplas_luau/app.gss" }
    script { src: "scripts/app.luau" }
  }

  column {
    class: tela

    row {
      class: barra

      text "Onda 11 · habilitador C — séries múltiplas (Luau)" {
        class: titulo
      }

      space { class: empurra }
      text "@status" { class: status }
    }

    scrollable {
      width: fill height: fill

      column {
        class: corpo

        text """
          O script escreve uma tabela `name, points, color?` na chave; o gráfico
          a lê no render. Nenhuma linha de Luau desenha nada.
        """ {
          class: lead
        }

        column {
          class: bloco

          text "linechart — carga por serviço" { class: secao }
          linechart { series: carga min: 0 grid: true class: grafico }

          row {
            class: acoes

            button { text: "+1 amostra" on_click: amostrar }
            button { text: zerar on_click: zerar class: btn-fraco }
          }
        }

        column {
          class: bloco

          text "area — a mesma série, preenchida" { class: secao }
          linechart { series: carga min: 0 area: true class: grafico }
        }
      }
    }
  }
}
