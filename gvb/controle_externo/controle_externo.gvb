// A forma com cabeçalho: a raiz é a `<screen>`, que declara o que a JANELA é
// (título, tamanho) e agrupa em `<resources>` o que a tela precisa para existir
// (estilo, script). Depois do `</resources>` vem só layout — nada que não
// desenhe fica no meio dos widgets.
//
// O `main.rs` deste exemplo também chama `.title(...)`/`.main_size(...)`; o que
// está escrito aqui vence, porque é o arquivo que recarrega a quente.
screen {
  title: "Controle externo" size: "1000 700" min_size: "480 360"

  resources {
    link { rel: theme href: "examples/controle_externo/theme.json" }

    style """
      /* Sem `background`: a cor da janela é do TEMA (theme.json). Pintar um nó
         `fill/fill` com a cor que o tema já pinta é uma camada a mais em cada
         pixel da tela, e ela custa (ver AGENTS.md). */
      .tela {
          padding: 28;
          width: fill;
          height: fill;
      }
      .conteudo {
          spacing: 16;
      }
      .titulo {
          size: 24; bold: true; color: #58A6FF;
      }
      .subtitulo {
          size: 13; color: #8B949E;
      }
      .painel {
          padding: 18;
          background: #161B22;
      }
      .painel-col {
          spacing: 10;
      }
      .campo {
          size: 16; color: #C9D1D9;
      }
      .estado {
          size: 18; bold: true; color: #3FB950;
      }
      /* Num botão, `color` é o fundo (o rótulo sai em `text-color`). */
      .btn {
          color: #4C566A;
          padding: 10 20;
      }
    """ {
      scoped: true
    }

    // Ações em Lua, num arquivo separado (resolvido relativo a este template).
    script { src: controle_externo.luau }
  }

  container {
    class: tela

    column {
      class: conteudo

      text "Controle externo" { class: titulo }

      text """
        Ninguém toca nesta janela. Uma thread do próprio programa manda as ações
        pelo canal `external`.
      """ {
        class: subtitulo
      }

      container {
        class: painel

        column {
          class: painel-col

          text "nome: @nome" { class: campo }
          text "busca: @busca" { class: campo }
          text "@estado" { class: estado }
        }
      }

      button {
        class: btn text: "Reiniciar (clique humano)" on_click: reiniciar
      }
    }
  }
}
