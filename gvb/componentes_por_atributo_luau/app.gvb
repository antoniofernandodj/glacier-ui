screen {
  title: "Glacier - Componentes por atributo (Luau)" size: "900 720"

  resources {
    link {
      rel: theme href: "examples/componentes_por_atributo_luau/theme.json"
    }

    link {
      rel: stylesheet href: "examples/componentes_por_atributo_luau/app.gss"
    }

    script { src: script.luau }

    // Cabeçalhos. Qual deles a Vitrine desenha é decidido pelo script, em
    // `ctx.cabecalho` — o nome de um componente também é dado.
    component {
      name: TituloGrande

      props {
        prop { name: titulo }
        prop { name: total }
      }

      row {
        class: cabecalho

        text "@titulo" { class: cabecalho-titulo }
        space
        badge { badge_text: @total }
      }
    }

    component {
      name: TituloCompacto

      props {
        prop { name: titulo }
        prop { name: total }
      }

      row {
        class: cabecalho

        text "@titulo · @total" { class: cabecalho-discreto }
      }
    }

    component {
      name: LinhaContato

      props {
        prop { name: id }
        prop { name: nome }
        prop { name: email }
        prop { name: rotulo default: Favoritar }
        prop { name: acao default: favoritar }
      }

      row {
        class: linha

        column {
          class: linha-dados

          text "@nome" { class: linha-texto }
          text "@email" { class: linha-email }
        }

        button { class: linha-botao text: @rotulo on_click: @acao:@id }
      }
    }

    // Dois fallbacks para a MESMA lista: o script escolhe em `ctx.vazio`
    // conforme o motivo de ela estar vazia.
    component {
      name: NenhumContato

      column {
        class: vazio

        text "Nenhum contato ainda" { class: vazio-titulo }
        text "Clique em “Adicionar contato”." { class: vazio-nota }
      }
    }

    component {
      name: BuscaSemResultado

      column {
        class: vazio

        text "Ninguém casa com “@busca”" { class: vazio-titulo }
        text "Apague a busca para ver todos." { class: vazio-nota }
      }
    }

    component {
      name: SemFavoritos

      column {
        class: vazio

        text "Sem favoritos" { class: vazio-titulo }
        text "Use “Favoritar” numa linha acima." { class: vazio-nota }
      }
    }

    import { name: Vitrine from: vitrine.gvb }
  }

  column {
    class: tela

    row {
      class: barra

      text "Componentes por atributo — Luau" { class: titulo }
      space
      text "@status" { class: status }
    }

    rule

    scrollable {
      class: rolagem

      column {
        class: corpo

        row {
          class: acoes

          button { text: "Adicionar contato" on_click: adicionar }

          button {
            class: btn-fraco text: "Remover todos" on_click: remover_todos
          }

          button {
            class: btn-fraco text: "Trocar cabeçalho"
            on_click: trocar_cabecalho
          }
        }

        textinput {
          class: filtro value: busca on_change: filtrar
          placeholder: "Buscar por nome…"
        }

        Vitrine {
          titulo: Contatos total: @total itens: visiveis cabecalho: @cabecalho
          linha: LinhaContato vazio: @vazio
        }

        column {
          class: coluna

          text "Favoritos" { class: secao }
          text "A tag <foreach> com um fallback literal." { class: nota }

          each @favoritos as f {
            fallback: SemFavoritos

            LinhaContato {
              id: @f.id nome: @f.nome email: @f.email rotulo: Desfavoritar
              acao: desfavoritar
            }
          }
        }
      }
    }
  }
}
